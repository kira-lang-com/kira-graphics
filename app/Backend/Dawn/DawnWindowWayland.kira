// The Linux window, opened on Wayland.
//
// The shape of a Wayland window is not the shape of a Win32 one, and this is
// where that shows. On Windows a window exists the moment `CreateWindowExA`
// returns. Here a client connects, asks the compositor what it offers, waits for
// the answer, binds the two globals a window needs out of it, makes a surface,
// gives that surface a role, and only then has something that can be shown --
// and the compositor decides when that is, by sending a configure the client
// acknowledges.
//
// None of the per-interface entry points a C client would call exist to link
// against: `wayland-scanner` emits them as `static inline` wrappers. So every
// request below is marshalled by hand through the one real entry point, with the
// interface descriptors `@FFI.Address` reaches.
//
// The handlers write into a block the caller owns, passed as the `data` pointer
// `wl_proxy_add_listener` carries. That is not a workaround: Kira has no
// globals, and an event handler that must remember something has to be given
// somewhere to put it.

// The compositor pings; a client that never pongs is one it may call
// unresponsive and stop drawing.
function waylandOnPing(data: RawPtr, shell: RawPtr, serial: U32) {
    var args = WaylandUintArg { value: U64(serial) }
    let ignored = waylandProxyMarshalUint(
        shell,
        waylandXdgPongOpcode(),
        nullPointer(),
        waylandProxyGetVersion(shell),
        U32(0),
        move args,
    )
    return
}

// A surface is not shown until the serial its configure carried is acknowledged.
function waylandOnConfigure(data: RawPtr, xdgSurface: RawPtr, serial: U32) {
    var args = WaylandUintArg { value: U64(serial) }
    let ignored = waylandProxyMarshalUint(
        xdgSurface,
        waylandXdgSurfaceAckConfigureOpcode(),
        nullPointer(),
        waylandProxyGetVersion(xdgSurface),
        U32(0),
        move args,
    )
    return
}

// One global the compositor offers, reported by hanging what was bound on the
// registry that asked for it.
//
// There are two globals a window needs and one user-data word per proxy, so the
// window opens two registries and gives each its own handler. A client may open
// as many as it likes and every one replays the whole list, so this costs one
// extra replay at startup and buys a handler that stores without writing.
function waylandOnCompositorGlobal(data: RawPtr, registry: RawPtr, name: U32, interface: RawPtr, version: U32) {
    if waylandNameEquals(interface, "wl_compositor") == I32(0) {
        waylandProxySetUserData(registry, waylandBind(registry, name, waylandCompositorInterface(), U32(4)))
    }
    return
}

function waylandOnShellGlobal(data: RawPtr, registry: RawPtr, name: U32, interface: RawPtr, version: U32) {
    if waylandNameEquals(interface, "xdg_wm_base") == I32(0) {
        waylandProxySetUserData(registry, waylandBind(registry, name, waylandXdgWmBaseInterface(), U32(1)))
    }
    return
}

// A global going away matters to a client holding one. This window binds only
// the compositor and the shell, and neither leaves while a window is open.
function waylandOnGlobalRemove(data: RawPtr, registry: RawPtr, name: U32) {
    return
}

DawnWindow DawnWindowWayland {
    function open(title: borrow String, width: Int, height: Int, mode: borrow WindowMode, transparent: Bool, opacity: Float) -> RawPtr {
        let display = waylandDisplayConnect(nullPointer())
        if pointerIsNull(display) {
            graphicsDiagnostic(
                "Kira Graphics: no Wayland display to open the Dawn backend's window on"
            )
            return nullPointer()
        }

        // The registry is the one object a client gets without naming it.
        // One argument: the new-id slot the registry will fill. A request that
        // creates an object still sends a place for it, so the array is one word
        // long and not absent -- libwayland reads args[0] either way.
        var registryArgs = WaylandOneArg { value: nullPointer() }
        let registry = waylandProxyMarshalOne(
            display,
            waylandDisplayGetRegistryOpcode(),
            waylandRegistryInterface(),
            waylandProxyGetVersion(display),
            U32(0),
            move registryArgs,
        )
        if pointerIsNull(registry) {
            graphicsDiagnostic("Kira Graphics: the Wayland display refused a registry")
            waylandDisplayDisconnect(display)
            return nullPointer()
        }

        var compositorListener = WaylandRegistryListener {
            global: waylandOnCompositorGlobal
            globalRemove: waylandOnGlobalRemove
        }
        let ignoredCompositorListener =
            waylandAddRegistryListener(registry, move compositorListener, nullPointer())

        // The second registry, for the second global. See the handlers above.
        var shellRegistryArgs = WaylandOneArg { value: nullPointer() }
        let shellRegistry = waylandProxyMarshalOne(
            display,
            waylandDisplayGetRegistryOpcode(),
            waylandRegistryInterface(),
            waylandProxyGetVersion(display),
            U32(0),
            move shellRegistryArgs,
        )
        if pointerIsNull(shellRegistry) {
            graphicsDiagnostic("Kira Graphics: the Wayland display refused a second registry")
            waylandDisplayDisconnect(display)
            return nullPointer()
        }
        var shellRegistryListener = WaylandRegistryListener {
            global: waylandOnShellGlobal
            globalRemove: waylandOnGlobalRemove
        }
        let ignoredShellListener =
            waylandAddRegistryListener(shellRegistry, move shellRegistryListener, nullPointer())

        // Everything the compositor offers arrives as events, so nothing is
        // bound until they have all been delivered.
        let ignoredRoundtrip = waylandDisplayRoundtrip(display)

        let compositor = waylandProxyGetUserData(registry)
        let shell = waylandProxyGetUserData(shellRegistry)
        if pointerIsNull(compositor) || pointerIsNull(shell) {
            graphicsDiagnostic(
                "Kira Graphics: this Wayland compositor offers no wl_compositor or no \
                 xdg_wm_base, and a window needs both"
            )
            waylandProxyDestroy(registry)
            waylandDisplayDisconnect(display)
            return nullPointer()
        }

        var shellListener = WaylandShellListener { ping: waylandOnPing }
        let ignoredShell = waylandAddShellListener(shell, move shellListener, nullPointer())

        // A surface with no role is not a window. The role is what xdg-shell
        // gives it, in two steps: a surface becomes an xdg_surface, and an
        // xdg_surface becomes a toplevel.
        var surfaceArgs = WaylandOneArg { value: nullPointer() }
        let surface = waylandProxyMarshalOne(
            compositor,
            waylandCompositorCreateSurface(),
            waylandSurfaceInterface(),
            waylandProxyGetVersion(compositor),
            U32(0),
            move surfaceArgs,
        )
        if pointerIsNull(surface) {
            graphicsDiagnostic("Kira Graphics: the Wayland compositor refused a surface")
            waylandDisplayDisconnect(display)
            return nullPointer()
        }

        var roleArgs = WaylandTwoArgs { first: nullPointer() second: surface }
        let xdgSurface = waylandProxyMarshalTwo(
            shell,
            waylandXdgGetSurfaceOpcode(),
            waylandXdgSurfaceInterface(),
            waylandProxyGetVersion(shell),
            U32(0),
            move roleArgs,
        )
        if pointerIsNull(xdgSurface) {
            graphicsDiagnostic("Kira Graphics: xdg_wm_base refused a surface role")
            waylandDisplayDisconnect(display)
            return nullPointer()
        }

        var configureListener = WaylandXdgSurfaceListener { configure: waylandOnConfigure }
        let ignoredConfigure = waylandAddXdgSurfaceListener(xdgSurface, move configureListener, nullPointer())

        var toplevelArgs = WaylandOneArg { value: nullPointer() }
        let toplevel = waylandProxyMarshalOne(
            xdgSurface,
            waylandXdgSurfaceGetToplevelOpcode(),
            waylandXdgToplevelInterface(),
            waylandProxyGetVersion(xdgSurface),
            U32(0),
            move toplevelArgs,
        )
        if pointerIsNull(toplevel) {
            graphicsDiagnostic("Kira Graphics: xdg_surface refused a toplevel")
            waylandDisplayDisconnect(display)
            return nullPointer()
        }

        var titleArgs = WaylandStringArg { value: title }
        let ignoredTitle = waylandProxyMarshalString(
            toplevel,
            waylandXdgToplevelSetTitleOpcode(),
            nullPointer(),
            waylandProxyGetVersion(toplevel),
            U32(0),
            move titleArgs,
        )

        // A surface's state is only real once committed, and the compositor
        // answers the first commit with the configure that makes it showable.
        let ignoredCommit = waylandProxyMarshalArray(
            surface,
            waylandSurfaceCommitOpcode(),
            nullPointer(),
            waylandProxyGetVersion(surface),
            U32(0),
            nullPointer(),
        )
        let ignoredSettle = waylandDisplayRoundtrip(display)

        return surface
    }

    // A Wayland surface is told its size by the compositor rather than asked,
    // and the size it was told arrives in a configure. Until the pump is ported
    // and those events are read, the size the caller asked for is the size it
    // gets -- which is what the compositor was asked for too.
    function clientWidth(window: RawPtr) -> Int { return 0 }
    function clientHeight(window: RawPtr) -> Int { return 0 }

    // A surface learns its scale from the output it is shown on, through an
    // event. 1.0 is what an unscaled surface reads.
    function scale(window: RawPtr) -> Float { return 1.0 }

    // A client does not resize its own surface: it acknowledges a configure and
    // draws at the size that carried. This becomes that acknowledgement.
    function resize(window: RawPtr, width: Int, height: Int) {
        return
    }

    function createSurface(instance: RawPtr, window: RawPtr) -> RawPtr {
        return wgpuInstanceCreateSurface(instance, WGPUSurfaceDescriptor {
            nextInChain: WGPUSurfaceSourceWaylandSurface {
                chain: WGPUChainedStruct { sType: dawnStructureWaylandSurface() }
                display: waylandProxyGetDisplay(window)
                surface: window
            }
            label: dawnText("kira-graphics-surface")
        })
    }

    function close(window: RawPtr) {
        waylandProxyDestroy(window)
        return
    }
}

// One frame's worth of Wayland events.
//
// A Wayland client has no message queue to peek: what it has is a socket, and
// the events on it are delivered to the listeners already installed on each
// object. So this flushes what the frame queued and dispatches whatever has
// arrived, without blocking -- a frame that waited for an event would be a
// frame that stopped when nothing happened.
function dawnPumpWayland(window: RawPtr) {
    if pointerIsNull(window) {
        return
    }
    let display = waylandProxyGetDisplay(window)
    if pointerIsNull(display) {
        return
    }
    let ignoredFlush = waylandDisplayFlush(display)
    let ignoredDispatch = waylandDisplayDispatchPending(display)
    return
}
