@FFI.Extern { library: kira_dynamic_ffi; symbol: kira_dynamic_host_platform_code; abi: c; }
function kiraDynamicHostPlatformCode(): U32;

@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_null_ptr; abi: c; }
function kiraDynamicNullPtr(): RawPtr;

@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_ptr_is_null; abi: c; }
function kiraDynamicPtrIsNull(ptr: RawPtr): Bool;

// Loading a driver: named against `kira_runtime` rather than the optional
// `kira_dynamic_ffi`, because that is where these live. `kira_dynamic_ffi` is
// declared with no target rows at all, so every call routed through it is
// excluded on every platform and traps by name — a loader that could never
// open anything, anywhere. The runtime archive is on every native link line.
@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_library_open; abi: c; }
function kiraDynamicLibraryOpen(name: CString): RawPtr;

@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_library_symbol; abi: c; }
function kiraDynamicLibrarySymbol(library: RawPtr, name: CString): RawPtr;

@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_library_close; abi: c; }
function kiraDynamicLibraryClose(library: RawPtr): Void;

@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_alloc; abi: c; }
function kiraDynamicAlloc(size: U64): RawPtr;

@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_free; abi: c; }
function kiraDynamicFree(ptr: RawPtr): Void;

@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_read_u32; abi: c; }
function kiraDynamicReadU32(ptr: RawPtr): U32;

@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_read_ptr; abi: c; }
function kiraDynamicReadPtr(ptr: RawPtr): RawPtr;

// Reading a pointer at a byte offset is how a COM vtable is indexed: the slot
// for a method is `slot * 8` bytes into the table.
@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_read_ptr_at; abi: c; }
function kiraDynamicReadPtrAt(ptr: RawPtr, offset: U64): RawPtr;

@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_write_u8_at; abi: c; }
function kiraDynamicWriteU8At(ptr: RawPtr, offset: U64, value: U8): Void;

@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_write_u16_at; abi: c; }
function kiraDynamicWriteU16At(ptr: RawPtr, offset: U64, value: U16): Void;

@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_write_u32_at; abi: c; }
function kiraDynamicWriteU32At(ptr: RawPtr, offset: U64, value: U32): Void;

@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_write_ptr; abi: c; }
function kiraDynamicWritePtr(ptr: RawPtr, value: RawPtr): Void;

@FFI.Extern { library: kira_dynamic_ffi; symbol: kira_dynamic_ffi_last_error_code; abi: c; }
function kiraDynamicFfiLastErrorCode(): I32;

@FFI.Extern { library: kira_dynamic_ffi; symbol: kira_dynamic_ffi_call_i32_ptr; abi: c; }
function kiraDynamicFfiCallI32Ptr(functionPtr: RawPtr, arg0: RawPtr): I32;

@FFI.Extern { library: kira_dynamic_ffi; symbol: kira_dynamic_ffi_call_i32_ptr_u32_ptr_ptr; abi: c; }
function kiraDynamicFfiCallI32PtrU32PtrPtr(functionPtr: RawPtr, arg0: RawPtr, arg1: U32, arg2: RawPtr, arg3: RawPtr): I32;

// The run-time call builder.
//
// A fixed call shape above covers a signature the binding could name in
// advance. COM cannot be named in advance: the method is a slot in a table, so
// the signature is assembled here — arguments pushed in order, then the address
// invoked for the return type the method actually has.
//
// Every argument travels in an integer register or stack slot, which is what a
// pointer, a handle, and an enum all want. Float-by-value arguments are refused
// by the builder rather than passed in the wrong register class; nothing in
// Direct3D's COM surface passes one, because its floats live inside structures.
@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_call_new; abi: c; }
function kiraDynamicCallNew(maxArgs: U32): RawPtr;

@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_call_reset; abi: c; }
function kiraDynamicCallReset(call: RawPtr): Void;

@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_call_free; abi: c; }
function kiraDynamicCallFree(call: RawPtr): Void;

// Zero is a well-formed call. Any other value says the call was refused and
// nothing ran, which is how a genuine zero result is told from a fault.
@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_call_status; abi: c; }
function kiraDynamicCallStatus(call: RawPtr): I32;

@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_call_arg_ptr; abi: c; }
function kiraDynamicCallArgPtr(call: RawPtr, value: RawPtr): Void;

@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_call_arg_u32; abi: c; }
function kiraDynamicCallArgU32(call: RawPtr, value: U32): Void;

@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_call_arg_i32; abi: c; }
function kiraDynamicCallArgI32(call: RawPtr, value: I32): Void;

@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_call_arg_u64; abi: c; }
function kiraDynamicCallArgU64(call: RawPtr, value: U64): Void;

@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_call_invoke_i32; abi: c; }
function kiraDynamicCallInvokeI32(call: RawPtr, functionPtr: RawPtr): I32;

@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_call_invoke_u32; abi: c; }
function kiraDynamicCallInvokeU32(call: RawPtr, functionPtr: RawPtr): U32;

@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_call_invoke_u64; abi: c; }
function kiraDynamicCallInvokeU64(call: RawPtr, functionPtr: RawPtr): U64;

@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_call_invoke_ptr; abi: c; }
function kiraDynamicCallInvokePtr(call: RawPtr, functionPtr: RawPtr): RawPtr;

@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_call_invoke_void; abi: c; }
function kiraDynamicCallInvokeVoid(call: RawPtr, functionPtr: RawPtr): Void;

@Native
// Which platform this program was built for.
//
// Answered by the compiler at expansion time rather than by asking a C library
// at run time: the target is something the build already knows, and a program
// that had to open a library to find out could not run on a machine where that
// library is missing — which is every machine this backend cares about.
comptime macro hostPlatformName {
    kind { function }
    expand(input: Syntax) -> Syntax {
        let name = Build.platform()
        return quote { #{name} }
    }
}

function dynamicFfiHostPlatform() -> GraphicsPlatform {
    let name = hostPlatformName!()
    if name == "windows" {
        return GraphicsPlatform.Windows
    }
    if name == "linux" {
        return GraphicsPlatform.Linux
    }
    if name == "macos" {
        return GraphicsPlatform.MacOS
    }
    if name == "ios" {
        return GraphicsPlatform.IOS
    }
    return GraphicsPlatform.Unknown
}
