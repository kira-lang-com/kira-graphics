// A set of resources bound together at one or more encoder slots.
//
// The entries live behind `storage`, recovered through `nativeState` exactly
// as `RenderEncoder`'s and `UiBatch`'s own state is: a caller almost always
// holds a `BindGroup` through a `let` (`bindGroupOrReport` answers one), and
// `nativeRecover` mutates what `storage` points to regardless of whether the
// binding that read it was a `let` or a `var` — the same property that makes
// `RenderEncoder.setPipeline` work without demanding `var encoder`.
//
// `kg_bind_group_record` used to cap each entry kind at four and store them in
// fixed slots, because the C table had to reserve its shape up front. The
// state here reserves nothing — it grows exactly as far as the entries a
// caller adds — and a uniform entry holds a reference to the very
// `Uniform` its caller passed in (see `Uniform.kira`), not a copy of
// whatever it held when the entry was added.
public struct StoredUniformBindEntry {
    var uniformSlot: Int = 0
    var uniformId: U32 = 0
    var storage: NativeState<UniformState>
}

public struct BindGroupState {
    var label: String = ""
    var uniformEntries: [StoredUniformBindEntry] = []
    var textureEntries: [TextureBindEntry] = []
    var samplerEntries: [SamplerBindEntry] = []
    var storageEntries: [StorageBindEntry] = []
    // How many times the entries above have changed.
    //
    // A backend that has to mint a device-side object from them — WebGPU's
    // `WGPUBindGroup` is immutable once created — caches that object and rebuilds
    // it when this moves. Sokol needs none: it applies the entries at the draw
    // and has nothing to invalidate.
    var revision: Int = 0
    // The Dawn backend's cached `WGPUBindGroup`, and what it was built for.
    //
    // A WebGPU bind group is created against a *pipeline's* layout for a
    // *particular* group index, and neither is known when a caller builds the
    // group — the group usually exists before any pipeline does. So the real
    // object is minted at the first draw that binds it and kept until the
    // pipeline, the slot, or the entries change. Ids rather than pointers,
    // because the id space is the backend's own table and a `RawPtr` field has
    // no zero a struct declaration can name.
    var deviceGroupId: U32 = 0
    var devicePipeline: U32 = 0
    var deviceSlot: Int = 0 - 1
    var deviceRevision: Int = 0 - 1
    // What tells this group apart from every other one, for a cache keyed on
    // several groups at once.
    //
    // `BindGroup.id` cannot: every live group answers the same non-zero
    // sentinel, because nothing else keys on it. Assigned on first use by the
    // backend that needs it (Dawn merges an encoder's four slots into one
    // WebGPU group and caches the result against the combination), so a run on
    // a backend that does not need identities never spends one.
    var identity: Int = 0
}

public class BindGroup {
    // Typed affine owner of the CPU-side group state. Nested uniform owners are
    // released recursively with this state, so no raw token carries a hidden
    // destruction obligation.
    var storage: NativeState<BindGroupState>
    var id: U32 = 0
}

public @Native
function emptyBindGroup() -> BindGroup {
    return BindGroup {
        storage: nativeState(BindGroupState {}),
        id: 0
    }
}

// A slot that has never been bound. No state box at all, which is what an
// unset encoder slot is: every read of one is gated on its `has` flag, so
// there is nothing behind the token to read — and nothing to free, which is
// the point. `emptyBindGroup` stays for callers that may still add entries;
// this is for slots whose emptiness is final.
public @Native
function unboundBindGroup() -> BindGroup {
    return BindGroup {
        storage: nativeState(BindGroupState {}),
        id: 0
    }
}

// sokol_gfx.h's `SG_MAX_VIEW_BINDSLOTS` / `SG_MAX_SAMPLER_BINDSLOTS`. An
// entry's *slot* is checked against these before it is kept — Sokol itself
// would only catch an out-of-range slot at the draw that finally applies it,
// past the point a caller could tell why.
public function sokolMaxViewBindSlots() -> Int { return 32 }
// `SG_MAX_UNIFORMBLOCK_BINDSLOTS`: how many uniform blocks one pipeline may
// have. Not a limit on where a SHADER numbers its uniform — that is a binding
// index in the same space as its textures — but on the slot sokol resolves that
// binding to, which is what `sg_apply_uniforms` takes.
public function sokolMaxUniformBlockSlots() -> Int { return 8 }
public function sokolMaxSamplerBindSlots() -> Int { return 12 }

// Sokol's half of `Graphics.beginBindGroup` / `createBindGroup` /
// `createUniformBindGroup` / `createTextureSamplerBindGroup`: an empty group
// ready for entries. Never a resource sokol tracks — there is no
// `sg_bind_group` — so there is nothing to allocate beyond this value.
// 1 rather than a counter: sokol keys nothing on this id, so every live
// group answers the same "not empty" sentinel `bindGroupResult` reads.
public @Native
function sokolCreateBindGroupId(label: borrow String) -> BindGroup {
    return BindGroup {
        storage: nativeState(BindGroupState {
            label: label
        }),
        id: 1
    }
}

// The slot is the shader's own `@group(0)` binding index, not a sokol block
// slot: sokol numbers its blocks itself, in the order the reflection reports
// them, and `sokolUniformTargetMask` is what turns one into the other. So the
// range this is checked against is the binding space a KSL group numbers into —
// the same one a texture entry is checked against — and a shader that declares
// its uniform after eight textures is not asking sokol for a ninth block.
public @Native
function sokolBindGroupAddUniform(group: borrow BindGroup, uniformSlot: Int, uniform: borrow Uniform) {
    var state = nativeRecover<BindGroupState>(group.storage)
    if uniformSlot < 0 || uniformSlot >= sokolMaxViewBindSlots() {
        graphicsDiagnostic("Kira Graphics: bind group '" + state.label + "' uniform slot is outside the binding range a shader group numbers into")
        return
    }
    state.uniformEntries.append(StoredUniformBindEntry {
        uniformSlot: uniformSlot,
        uniformId: uniform.id,
        storage: nativeUserData(uniform.storage)
    })
    return
}

public @Native
function sokolBindGroupAddTexture(group: borrow BindGroup, textureSlot: Int, texture: borrow GraphicsTexture) {
    var state = nativeRecover<BindGroupState>(group.storage)
    if texture.viewId == 0 {
        graphicsDiagnostic("Kira Graphics: bind group '" + state.label + "' cannot bind a texture with no sampled view")
        return
    }
    if textureSlot < 0 || textureSlot >= sokolMaxViewBindSlots() {
        graphicsDiagnostic("Kira Graphics: bind group '" + state.label + "' texture slot is outside Sokol's supported view range")
        return
    }
    state.textureEntries.append(TextureBindEntry {
        textureSlot: textureSlot,
        texture: texture
    })
    return
}

public @Native
function sokolBindGroupAddSampler(group: borrow BindGroup, samplerSlot: Int, sampler: borrow GraphicsSampler) {
    var state = nativeRecover<BindGroupState>(group.storage)
    if sampler.id == 0 {
        graphicsDiagnostic("Kira Graphics: bind group '" + state.label + "' cannot bind sampler 0")
        return
    }
    if samplerSlot < 0 || samplerSlot >= sokolMaxSamplerBindSlots() {
        graphicsDiagnostic("Kira Graphics: bind group '" + state.label + "' sampler slot is outside Sokol's supported sampler range")
        return
    }
    state.samplerEntries.append(SamplerBindEntry {
        samplerSlot: samplerSlot,
        sampler: sampler
    })
    return
}

public @Native
function sokolBindGroupAddStorageBuffer(group: borrow BindGroup, storageSlot: Int, viewId: U32) {
    var state = nativeRecover<BindGroupState>(group.storage)
    if viewId == 0 {
        graphicsDiagnostic("Kira Graphics: bind group '" + state.label + "' cannot bind a storage buffer with no view")
        return
    }
    if storageSlot < 0 || storageSlot >= sokolMaxViewBindSlots() {
        graphicsDiagnostic("Kira Graphics: bind group '" + state.label + "' storage slot is outside Sokol's supported view range")
        return
    }
    state.storageEntries.append(StorageBindEntry {
        storageSlot: storageSlot,
        viewId: viewId
    })
    return
}

// A no-op on Sokol: a `BindGroup` is an ordinary Kira value with no device
// resource behind it — it never was one, even in the C-side table this
// replaced, which only ever held CPU-side bookkeeping.
public @Native
function sokolDestroyBindGroupId(bindGroupId: U32) {
    return
}


// Explicitly shares one bind-group state owner. BindGroup is affine by default:
// an ordinary assignment or field extraction cannot silently duplicate the
// NativeState it contains. Callers that intentionally need another handle spell
// that ownership operation here, and the returned value carries the matching
// structural release.
public function shareBindGroup(group: borrow BindGroup) -> BindGroup {
    return BindGroup {
        storage: nativeUserData(group.storage),
        id: group.id
    }
}
