@FFI.Extern { library: sokol; symbol: kira_live_emit_log_line; abi: c; }
function kiraLiveEmitLogLine(line: CString): Void;

// The runner's first-frame hook (kira_live_install_first_frame_hook) fires the
// `live.frame.presented` health marker the live supervisor blocks on. sokol
// calls this from its frame callback after sg_commit; the Metal backend calls
// it after its first real on-screen drawable present so a macOS live session
// reaches `live.session.ready` instead of timing out (KCL038). Standalone
// `kira run` installs no hook, so this is a no-op there.
@FFI.Extern { library: sokol; symbol: kira_live_emit_first_frame; abi: c; }
function kiraLiveEmitFirstFrame(): Void;

@FFI.Extern { library: sokol; symbol: kira_live_take_reload; abi: c; }
function kiraLiveTakeReload(): Bool;

// The live VM swaps bytecode while the native window stays alive. Retained UI
// hosts consume this marker at the next frame so their cached tree is rebuilt
// once and source edits become visible without throwing away the window.
function kiraGraphicsLiveReloadPending(): Bool {
    return kiraLiveTakeReload()
}

// Emit the once-per-session "a real Kira frame was submitted and presented"
// live markers. Backend-agnostic: called by both the sokol and Metal on-screen
// present paths after a genuine frame submission, never before real draw work.
@Native
function kiraGraphicsLiveFramePresented(): Void {
    kiraLiveEmitLogLine("live.kira_graphics.frame.submitted")
    kiraLiveEmitFirstFrame()
    return
}

@FFI.Extern { library: sokol; symbol: kg_sapp_log; abi: c; }
function kgSappLog(tag: CString, level: U32, itemId: U32, message: CString, lineNr: U32, filename: CString, userData: RawPtr): Void;

@Native
function kiraGraphicsLiveUiFoundationAppStarted(): Void {
    kiraLiveEmitLogLine("live.ui_foundation.app.started")
    return
}

@Native
function kiraGraphicsLiveUiFoundationTreeBuilt(): Void {
    kiraLiveEmitLogLine("live.ui_foundation.tree.built")
    return
}

@Native
function kiraGraphicsLiveUiFoundationRetainedTreeReady(): Void {
    kiraLiveEmitLogLine("live.ui_foundation.retained_tree.ready")
    return
}

@Native
function kiraGraphicsLiveUiFoundationLayoutNonEmpty(): Void {
    kiraLiveEmitLogLine("live.ui_foundation.layout.non_empty")
    return
}

@Native
function kiraGraphicsLiveUiFoundationRenderCommandsGenerated(): Void {
    kiraLiveEmitLogLine("live.ui_foundation.render_commands.generated")
    return
}

// A frame that drew real application content, announced once per session.
//
// The retained compositor accumulates quads all frame and issues its draws
// through the public encoder, so there is no single moment inside this library
// where content becomes visible. The compositor says so itself, from the one
// place that knows a stream held anything.
@Native
function kiraGraphicsLiveVisibleContentSubmitted(): Void {
    kiraLiveEmitLogLine("live.kira_graphics.visible_content.submitted")
    kiraLiveEmitLogLine("KIRA_UI_DRAW_COMMANDS_SUBMITTED")
    kiraLiveEmitLogLine("KIRA_APP_RENDERED_VISIBLE_CONTENT")
    return
}

@Native
function kiraGraphicsLiveBackendInitialized(): Void {
    kiraLiveEmitLogLine("live.kira_graphics.backend.initialized")
    return
}

@FFI.Extern { library: sokol; symbol: kg_setup; abi: c; }
function kgSetup(): Void;

@FFI.Extern { library: sokol; symbol: kg_destroy_buffer_id; abi: c; }
function kgDestroyBufferId(bufferId: U32): Void;

// Seconds on a monotonic clock, and the GPU's own measurement of the frame
// before last. Neither has an expression in Kira: reading a clock is a platform
// call, and a GL timestamp query needs entry points sokol does not load.
@FFI.Extern { library: sokol; symbol: kg_monotonic_seconds; abi: c; }
function kgMonotonicSeconds(): Float;

@FFI.Extern { library: sokol; symbol: kg_gpu_timer_supported; abi: c; }
function kgGpuTimerSupported(): Bool;

@FFI.Extern { library: sokol; symbol: kg_gpu_timer_begin; abi: c; }
function kgGpuTimerBegin(): Void;

@FFI.Extern { library: sokol; symbol: kg_gpu_timer_end; abi: c; }
function kgGpuTimerEnd(): Void;

@FFI.Extern { library: sokol; symbol: kg_gpu_frame_seconds; abi: c; }
function kgGpuFrameSeconds(): Float;

@FFI.Extern { library: sokol; symbol: kg_create_sampler_id; abi: c; }
function kgCreateSamplerId(label: CString, minFilter: Int, magFilter: Int, addressModeU: Int, addressModeV: Int): U32;

@FFI.Extern { library: sokol; symbol: kg_destroy_sampler_id; abi: c; }
function kgDestroySamplerId(samplerId: U32): Void;

// Prints the lifetime report, gated behind the same env vars the old
// table-reading version was. Kira is the one sampling now (see
// `SokolApplication.kira`'s `kiraGraphicsSokolFrame`) — it owns the running
// peaks and reads `sg_query_stats` itself through the generated bindings — so
// this is pure output formatting over the two values it hands over.
@FFI.Extern { library: sokol; symbol: kg_report_lifetime; abi: c; }
function kgReportLifetime(stats: sg_stats, peaks: KgLifetimePeaks): Void;

@FFI.Extern { library: sokol; symbol: kg_run_lifetime_stress; abi: c; }
function kgRunLifetimeStress(iterations: Int, shaderDirectory: CString, shaderAsset: CString): U32;

@FFI.Extern { library: sokol; symbol: kg_destroy_shader_id; abi: c; }
function kgDestroyShaderId(shaderId: U32): Void;

// Read the presented framebuffer back into a binary PPM. sokol_gfx has no
// readback of any kind, so this is the only thing that can say what a frame on
// this backend actually contains — see `kg_capture_swapchain_ppm`.
@FFI.Extern { library: sokol; symbol: kg_capture_swapchain_ppm; abi: c; }
function kgCaptureSwapchainPpm(path: CString): Bool;
