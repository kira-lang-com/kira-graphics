@Native
function sokolDefaultViewport() -> Viewport {
    return Viewport {
        x: 0
        y: 0
        width: sapp_width()
        height: sapp_height()
    }
}

// Current sokol-app drawable size (framebuffer pixels). @Native wrappers so
// non-@Native callers (e.g. Graphics.contextWidth/Height) can obtain the size
// without directly touching the FFI-bound sapp_* symbols.
@Native
function sokolDrawableWidth() -> Int {
    return sapp_width()
}

@Native
function sokolDrawableHeight() -> Int {
    return sapp_height()
}

// Retina backing scale (physical pixels per logical point) of the sokol-app
// drawable. 1.0 when high_dpi is off or on a non-Retina display; on a Retina
// display with high_dpi requested this is the device pixel ratio (e.g. 2.0).
// Clamped to at least 1.0 so callers can always divide by it safely.
@Native
function sokolDpiScale() -> Float {
    let s = Float(sapp_dpi_scale())
    if s < 1.0 {
        return 1.0
    }
    return s
}

// Logical (point) drawable size = framebuffer pixels / dpi_scale. UI layout and
// pointer hit-testing work in this space so a Retina framebuffer does not shrink
// the interface; the framebuffer itself stays at native pixel resolution.
//
// Float, and only Float: a point is not a whole number of pixels at a
// fractional backing scale, and truncating here would lose the fraction every
// layout pass below needs.
@Native
function sokolLogicalWidthF() -> Float {
    return Float(sapp_widthf()) / sokolDpiScale()
}

@Native
function sokolLogicalHeightF() -> Float {
    return Float(sapp_heightf()) / sokolDpiScale()
}
