function vulkanPipelineRenderingInfo(colorFormat: I32, depthFormat: I32, stencilFormat: I32) -> RawPtr

enum VulkanWindowPlatform {
    Windows
    Linux
}

function vulkanWindowProcedure(window: RawPtr, message: U32, wparam: U64, lparam: Int) -> Int {
    if message == dawnMessageClose() {
        destroyWindowHandle(window)
        return 0
    }
    if message == dawnMessageDestroy() {
        postQuitMessage(0)
        return 0
    }
    return defaultWindowProcedure(window, message, wparam, lparam)
}

@Native
function vulkanRegisterWindowClass(instance: RawPtr, className: borrow String) -> Bool {
    return registerWindowClass(WindowClass {
        byteSize: U32(80),
        style: U32(3),
        procedure: vulkanWindowProcedure,
        instance: instance,
        cursor: loadCursor(nullPointer(), U64(32512)),
        className: className
    }) != U16(0)
}

construct VulkanWindow {
    requires {
        function open(title: borrow String, width: Int, height: Int, mode: borrow WindowMode, transparent: Bool, opacity: Float) -> RawPtr
        function clientWidth(window: RawPtr) -> Int
        function clientHeight(window: RawPtr) -> Int
        function scale(window: RawPtr) -> Float
        function resize(window: RawPtr, width: Int, height: Int)
        function close(window: RawPtr) -> Void
        function createSurface(instance: RawPtr, window: RawPtr) -> RawPtr
    }
}

construct VulkanWindowWin32() extends VulkanWindow {
    function open(title: borrow String, width: Int, height: Int, mode: borrow WindowMode, transparent: Bool, opacity: Float) -> RawPtr {
        let instance = moduleHandle("")
        if !vulkanRegisterWindowClass(instance, "KiraGraphicsVulkanWindow") {
            return nullPointer()
        }
        return dawnOpenWindow(instance, "KiraGraphicsVulkanWindow", title, width, height, mode, transparent, opacity)
    }
    function clientWidth(window: RawPtr) -> Int { return dawnClientWidth(window) }
    function clientHeight(window: RawPtr) -> Int { return dawnClientHeight(window) }
    function scale(window: RawPtr) -> Float { return dawnWindowScale(window) }
    function resize(window: RawPtr, width: Int, height: Int) {
        dawnResizeWindow(window, width, height)
        return
    }
    function close(window: RawPtr) {
        destroyWindowHandle(window)
        return
    }
    function createSurface(instance: RawPtr, window: RawPtr) -> RawPtr {
        return vulkanCreateWin32Surface(instance, moduleHandle(""), window)
    }
}

construct VulkanWindowWayland() extends VulkanWindow {
    function open(title: borrow String, width: Int, height: Int, mode: borrow WindowMode, transparent: Bool, opacity: Float) -> RawPtr {
        return DawnWindowWayland().open(title, width, height, mode, transparent, opacity)
    }
    function clientWidth(window: RawPtr) -> Int { return Int(kira_wayland_surface_width(window)) }
    function clientHeight(window: RawPtr) -> Int { return Int(kira_wayland_surface_height(window)) }
    function scale(window: RawPtr) -> Float { return 1.0 }
    function resize(window: RawPtr, width: Int, height: Int) {
        return
    }
    function close(window: RawPtr) {
        kira_wayland_proxy_destroy(window)
        return
    }
    function createSurface(instance: RawPtr, window: RawPtr) -> RawPtr {
        return vulkanCreateWaylandSurface(instance, kira_wayland_proxy_get_display(window), window)
    }
}

function vulkanWindowFor(platform: borrow VulkanWindowPlatform) -> Any VulkanWindow {
    match platform {
        Windows -> return VulkanWindowWin32()
        Linux -> return VulkanWindowWayland()
    }
}

function vulkanWindowPlatformForHost() -> VulkanWindowPlatform {
    if hostPlatform() == .Linux {
        return .Linux
    }
    return .Windows
}
