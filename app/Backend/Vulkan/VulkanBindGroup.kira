import Foundation

// Bind groups are the CPU-side resource lists shared by every backend. Vulkan
// materializes a descriptor set only when a pipeline layout is known, during a
// draw; the list itself therefore needs no device handle here.

@Native
function vulkanNewBindGroup(label: borrow String) -> BindGroup {
    return BindGroup {
        storage: nativeUserData(nativeState(BindGroupState {
            label: label
        })),
        id: 1
    }
}

@Native
function vulkanCreateBindGroup(context: RawPtr, descriptor: borrow BindGroupDescriptor) -> BindGroupResult {
    if !vulkanHasDevice(context) {
        return .Error(.DeviceRefused)
    }
    let group = vulkanNewBindGroup(descriptor.label)
    for entry in descriptor.uniformEntries {
        vulkanBindGroupAddUniform(group, entry.uniformSlot, entry.uniform)
    }
    for entry in descriptor.textureEntries {
        vulkanBindGroupAddTexture(group, entry.textureSlot, entry.texture)
    }
    for entry in descriptor.samplerEntries {
        vulkanBindGroupAddSampler(group, entry.samplerSlot, entry.sampler)
    }
    return .Ok(group)
}

@Native
function vulkanCreateUniformBindGroup(label: borrow String, uniformSlot: Int, uniform: borrow Uniform) -> BindGroupResult {
    let group = vulkanNewBindGroup(label)
    vulkanBindGroupAddUniform(group, uniformSlot, uniform)
    return .Ok(group)
}

@Native
function vulkanCreateStorageBufferBindGroup(label: borrow String, slot: Int, bufferId: U32) -> BindGroupResult {
    if slot < 0 || bufferId == 0 {
        return .Error(.DeviceRefused)
    }
    let group = vulkanNewBindGroup(label)
    var state = nativeRecover<BindGroupState>(group.storage)
    state.storageEntries.append(StorageBindEntry {
        storageSlot: slot,
        viewId: bufferId
    })
    state.revision = state.revision + 1
    return .Ok(group)
}

@Native
function vulkanBeginBindGroup(label: borrow String) -> BindGroupResult {
    return .Ok(vulkanNewBindGroup(label))
}

@Native
function vulkanBindGroupAddUniform(group: borrow BindGroup, slot: Int, uniform: borrow Uniform) {
    if pointerIsNull(group.storage) || slot < 0 || uniform.id == 0 {
        return
    }
    var state = nativeRecover<BindGroupState>(group.storage)
    state.uniformEntries.append(UniformBindEntry {
        uniformSlot: slot,
        uniform: uniform
    })
    state.revision = state.revision + 1
    return
}

@Native
function vulkanBindGroupAddTexture(group: borrow BindGroup, slot: Int, texture: borrow GraphicsTexture) {
    if pointerIsNull(group.storage) || slot < 0 || texture.viewId == 0 {
        return
    }
    var state = nativeRecover<BindGroupState>(group.storage)
    state.textureEntries.append(TextureBindEntry {
        textureSlot: slot,
        texture: texture
    })
    state.revision = state.revision + 1
    return
}

@Native
function vulkanBindGroupAddSampler(group: borrow BindGroup, slot: Int, sampler: borrow GraphicsSampler) {
    if pointerIsNull(group.storage) || slot < 0 || sampler.id == 0 {
        return
    }
    var state = nativeRecover<BindGroupState>(group.storage)
    state.samplerEntries.append(SamplerBindEntry {
        samplerSlot: slot,
        sampler: sampler
    })
    state.revision = state.revision + 1
    return
}

@Native
function vulkanCreateTextureSamplerBindGroup(label: borrow String, textureSlot: Int, texture: borrow GraphicsTexture, samplerSlot: Int, sampler: borrow GraphicsSampler) -> BindGroupResult {
    let group = vulkanNewBindGroup(label)
    vulkanBindGroupAddTexture(group, textureSlot, texture)
    vulkanBindGroupAddSampler(group, samplerSlot, sampler)
    return .Ok(group)
}

// Descriptor sets belong to the pipeline's descriptor pool, not to the public
// group value. Graphics releases the CPU state box after this member returns.
@Native
function vulkanDestroyBindGroup(group: borrow BindGroup) {
    return
}
