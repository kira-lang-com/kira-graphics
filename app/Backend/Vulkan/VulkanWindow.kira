// Only surface creation is Vulkan-specific. Window creation stays on the same
// native Win32 and Wayland implementations Dawn already uses, so both backends
// get identical sizing, input and close behavior.

@FFI.Extern { library: kira_vulkan_surface, symbol: kira_vulkan_create_win32_surface, abi: c }
function vulkanCreateWin32Surface(instance: RawPtr, hinstance: RawPtr, window: RawPtr) -> RawPtr

@FFI.Extern { library: kira_vulkan_surface, symbol: kira_vulkan_create_wayland_surface, abi: c }
function vulkanCreateWaylandSurface(instance: RawPtr, display: RawPtr, surface: RawPtr) -> RawPtr

@FFI.Extern { library: kira_vulkan_surface, symbol: kira_vulkan_destroy_surface, abi: c }
function vulkanDestroySurface(instance: RawPtr, surface: RawPtr) -> Void

@FFI.Extern { library: kira_vulkan_surface, symbol: kira_vulkan_clip_cursor, abi: c }
function vulkanClipCursor(window: RawPtr, lock: I32) -> I32

@FFI.Extern { library: kira_vulkan_surface, symbol: kira_vulkan_instance_extensions, abi: c }
function vulkanInstanceExtensions(linuxPlatform: I32) -> RawPtr

@FFI.Extern { library: kira_vulkan_surface, symbol: kira_vulkan_device_extensions, abi: c }
