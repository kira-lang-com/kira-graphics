import Foundation
// Which renderer a program asks for, and the host it will run on.
//
// `RenderBackendKind` is the *selection* vocabulary — what a `GraphicsApplication`
// names and what `validateRenderBackend` checks against a platform, both of which
// happen before any device context exists. `Any RenderBackend` (see
// `app/Public/RenderBackend.kira`) is the *dispatch* vocabulary, and everything
// past `renderBackendFor` asks the backend rather than asking which one it is.
enum RenderBackendKind {
    Sokol
    Metal
    Dawn
}


enum Platform {
    Windows
    Linux
    MacOS
    IOS
    Web
    Unknown
}


struct RenderBackendSelection {
    var backend: RenderBackendKind = .Sokol
    var platform: Platform = .Unknown
    var supported: Bool = true
    var loaderName: String = ""
    var requiredSymbolCount: Int = 0
    var reason: String = ""
}


// Platform-aware default backend for hosts that do not pick one explicitly:
// Metal owns Apple hosts, Dawn owns Windows, and everything else defaults to
// Sokol — the portable backend. Web/WASM lands there honestly: the browser
// sandbox has no host-OS probe, so `hostPlatform()` returns `Unknown` there,
// and Unknown -> Sokol is the correct choice because Sokol (WebGPU) is the
// only backend that exists on wasm32-emscripten.
@Native
function graphicsDefaultBackend() -> RenderBackendKind {
    let platform = hostPlatform()
    if platform == .MacOS {
        return graphicsBackendFromEnvironment(.Metal)
    }
    if platform == .IOS {
        return graphicsBackendFromEnvironment(.Metal)
    }
    if platform == .Windows {
        return graphicsBackendFromEnvironment(.Dawn)
    }
    return graphicsBackendFromEnvironment(.Sokol)
}


// The renderer a run was asked for, or `fallback` when it was not asked.
//
// `KIRA_GRAPHICS_BACKEND` names one of the three. It exists so that one program
// can be run on two backends without being edited between the runs — which is
// what makes a pixel comparison between them mean anything, since a difference
// in the source would be a difference in the answer.
//
// A name that is none of the three is reported rather than ignored: a typo in an
// environment variable that silently selects the default is a run that proves
// nothing about the backend it was supposed to exercise.
@Native
function graphicsBackendFromEnvironment(fallback: RenderBackendKind) -> RenderBackendKind {
    let requested = environmentValue("KIRA_GRAPHICS_BACKEND")
    if requested.count == 0 {
        return fallback
    }
    if requested == "sokol" {
        return .Sokol
    }
    if requested == "metal" {
        return .Metal
    }
    if requested == "dawn" {
        return .Dawn
    }
    graphicsDiagnostic("Kira Graphics: KIRA_GRAPHICS_BACKEND names '" + requested + "', which is not `sokol`, `metal` or `dawn`")
    return fallback
}


function effectivePlatform(requested: Platform) -> Platform {
    if requested == .Unknown {
        return hostPlatform()
    }
    return requested
}


@Native
function validateRenderBackend(backend: RenderBackendKind, platform: Platform) -> RenderBackendSelection {
    let resolvedPlatform = effectivePlatform(move platform)
    match backend {
        Sokol -> return RenderBackendSelection {
            backend: move backend
            platform: resolvedPlatform
            supported: true
            loaderName: "sokol"
            requiredSymbolCount: 0
            reason: ""
        };
        Metal -> return validateMetalBackend(move resolvedPlatform);
        Dawn -> return validateDawnBackend(move resolvedPlatform);
    }
}


// Dawn reaches a GPU through whatever the platform has — D3D12 or Vulkan on
// Windows, Vulkan on Linux, Metal on Apple — so nothing about WebGPU limits it
// to one host. What limits this backend is its WINDOW: it opens one against
// `user32`, because Dawn draws and does not own a window, and that is the whole
// of what is Windows-only here. A second platform is a second window
// implementation beside `DawnWindow.kira` and nothing else.
@Native
function validateDawnBackend(platform: Platform) -> RenderBackendSelection {
    if platform == .Windows {
        return RenderBackendSelection {
            backend: .Dawn
            platform: platform
            supported: true
            loaderName: "dawn"
            requiredSymbolCount: 0
            reason: ""
        }
    }
    return unsupportedBackend(.Dawn, move platform, "Kira Graphics Dawn backend opens its window through Win32 and is only supported on Windows")
}


@Native
function validateMetalBackend(platform: Platform) -> RenderBackendSelection {
    if platform == .MacOS {
        return RenderBackendSelection {
            backend: .Metal
            platform: platform
            supported: true
            loaderName: "metal"
            requiredSymbolCount: 0
            reason: ""
        }
    }
    if platform == .IOS {
        return RenderBackendSelection {
            backend: .Metal
            platform: platform
            supported: true
            loaderName: "metal"
            requiredSymbolCount: 0
            reason: ""
        }
    }
    return unsupportedBackend(.Metal, move platform, "Kira Graphics Metal backend is only supported on macOS and iOS")
}

function unsupportedBackend(backend: RenderBackendKind, platform: Platform, reason: String) -> RenderBackendSelection {
    return RenderBackendSelection {
        backend: backend
        platform: platform
        supported: false
        reason: reason
    }
}
