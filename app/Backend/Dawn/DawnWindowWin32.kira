// The Windows window, as the platform contract sees it.
//
// Every member delegates: the Win32 is `DawnWindow.kira`, unchanged, and this is
// the declaration that makes it one of `DawnPlatform`'s answers. The window class
// is registered inside `open` rather than by the caller, because registering one
// is part of opening a window on this platform and no other platform has the step
// at all -- a caller that had to know about it would be a caller that knows which
// window it is holding.
public construct DawnWindowWin32() extends DawnWindow {
    function open(title: borrow String, width: Int, height: Int, mode: borrow WindowMode, transparent: Bool, opacity: Float) -> RawPtr {
        let instance = moduleHandle("")
        if !dawnRegisterWindowClass(instance, "KiraGraphicsDawnWindow") {
            return nullPointer()
        }
        return dawnOpenWindow(instance, "KiraGraphicsDawnWindow", title, width, height, mode, transparent, opacity)
    }

    function clientWidth(window: RawPtr) -> Int { return dawnClientWidth(window) }
    function clientHeight(window: RawPtr) -> Int { return dawnClientHeight(window) }
    function scale(window: RawPtr) -> Float { return dawnWindowScale(window) }

    function resize(window: RawPtr, width: Int, height: Int) {
        dawnResizeWindow(window, width, height)
        return
    }

    function createSurface(instance: RawPtr, window: RawPtr) -> RawPtr {
        return wgpuInstanceCreateSurface(instance, WGPUSurfaceDescriptor {
            nextInChain: WGPUSurfaceSourceWindowsHWND {
                chain: WGPUChainedStruct { sType: dawnStructureWindowsHwnd() },
                hinstance: moduleHandle(""),
                hwnd: window
            },
            label: dawnText("kira-graphics-surface")
        })
    }

    function close(window: RawPtr) -> Void {
        destroyWindowHandle(window)
        return
    }
}
