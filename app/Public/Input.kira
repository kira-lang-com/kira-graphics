public enum AppEventKind {
    None
    KeyDown
    KeyUp
    TextInput
    PointerDown
    PointerUp
    PointerMoved
    PointerEntered
    PointerExited
    Scroll
    TouchesBegan
    TouchesMoved
    TouchesEnded
    TouchesCancelled
    Resized
    Iconified
    Restored
    Focused
    Unfocused
    Suspended
    Resumed
    QuitRequested
    ClipboardPasted
    FilesDropped
}

public enum PointerButton {
    None
    Left
    Right
    Middle
    Other
}

// Where a scroll is in the gesture that made it. A trackpad's two fingers
// report `Began`, then `Changed` while they move, then `Ended` when they lift
// (or `Cancelled`); the glide the system adds after they lift arrives as a
// second run of phases in `scrollMomentum`. A wheel reports `None` for both.
public enum ScrollPhase {
    None
    MayBegin
    Began
    Changed
    Ended
    Cancelled
}

public struct ModifierState {
    let shift: Bool = false
    let control: Bool = false
    let alt: Bool = false
    let superKey: Bool = false
    let leftPointerButton: Bool = false
    let rightPointerButton: Bool = false
    let middlePointerButton: Bool = false
}

public struct AppEvent {
    let kind: AppEventKind = .None
    let frameCount: Int = 0
    let keyCode: Int = 0
    let textCodepoint: Int = 0
    let keyRepeat: Bool = false
    let modifiers: ModifierState = ModifierState {}
    let pointerButton: PointerButton = .None
    let pointerX: Float = 0.0
    let pointerY: Float = 0.0
    let pointerDeltaX: Float = 0.0
    let pointerDeltaY: Float = 0.0
    let scrollX: Float = 0.0
    let scrollY: Float = 0.0
    let scrollPhase: ScrollPhase = .None
    let scrollMomentum: ScrollPhase = .None
    // Whether the deltas are points from a trackpad or tablet rather than a
    // wheel's lines, and whether they follow the fingers ("natural" scrolling)
    // rather than run against them.
    let scrollPrecise: Bool = false
    let scrollInverted: Bool = false
    let touchCount: Int = 0
    let windowWidth: Int = 0
    let windowHeight: Int = 0
    let framebufferWidth: Int = 0
    let framebufferHeight: Int = 0
}

public function graphicsEventKindFromRaw(kind: Int) -> AppEventKind {
    if kind == 1 {
        return .KeyDown
    }
    if kind == 2 {
        return .KeyUp
    }
    if kind == 3 {
        return .TextInput
    }
    if kind == 4 {
        return .PointerDown
    }
    if kind == 5 {
        return .PointerUp
    }
    if kind == 6 {
        return .Scroll
    }
    if kind == 7 {
        return .PointerMoved
    }
    if kind == 8 {
        return .PointerEntered
    }
    if kind == 9 {
        return .PointerExited
    }
    if kind == 10 {
        return .TouchesBegan
    }
    if kind == 11 {
        return .TouchesMoved
    }
    if kind == 12 {
        return .TouchesEnded
    }
    if kind == 13 {
        return .TouchesCancelled
    }
    if kind == 14 {
        return .Resized
    }
    if kind == 15 {
        return .Iconified
    }
    if kind == 16 {
        return .Restored
    }
    if kind == 17 {
        return .Focused
    }
    if kind == 18 {
        return .Unfocused
    }
    if kind == 19 {
        return .Suspended
    }
    if kind == 20 {
        return .Resumed
    }
    if kind == 21 {
        return .QuitRequested
    }
    if kind == 22 {
        return .ClipboardPasted
    }
    if kind == 23 {
        return .FilesDropped
    }
    return .None
}

public function graphicsPointerButtonFromRaw(button: Int) -> PointerButton {
    if button == 0 {
        return .Left
    }
    if button == 1 {
        return .Right
    }
    if button == 2 {
        return .Middle
    }
    if button < 0 || button == 256 {
        return .None
    }
    return .Other
}

public function graphicsModifierStateFromRaw(raw: Int) -> ModifierState {
    let shift = (raw / 1) % 2 == 1
    let control = (raw / 2) % 2 == 1
    let alt = (raw / 4) % 2 == 1
    let superKey = (raw / 8) % 2 == 1
    let leftPointerButton = (raw / 256) % 2 == 1
    let rightPointerButton = (raw / 512) % 2 == 1
    let middlePointerButton = (raw / 1024) % 2 == 1
    return ModifierState {
        shift: shift,
        control: control,
        alt: alt,
        superKey: superKey,
        leftPointerButton: leftPointerButton,
        rightPointerButton: rightPointerButton,
        middlePointerButton: middlePointerButton
    }
}

public function graphicsEventUsesPointerPosition(kind: borrow AppEventKind) -> Bool {
    if kind == .PointerDown {
        return true
    }
    if kind == .PointerUp {
        return true
    }
    if kind == .PointerMoved {
        return true
    }
    if kind == .PointerEntered {
        return true
    }
    if kind == .PointerExited {
        return true
    }
    if kind == .Scroll {
        return true
    }
    if kind == .TouchesBegan {
        return true
    }
    if kind == .TouchesMoved {
        return true
    }
    if kind == .TouchesEnded {
        return true
    }
    if kind == .TouchesCancelled {
        return true
    }
    return false
}


public @Native
function graphicsStringFromCodepoint(codepoint: Int) -> String {
    return scalarText(codepoint)
}

public @Native
function graphicsAppendCodepoint(base: borrow String, codepoint: Int) -> String {
    return base + scalarText(codepoint)
}

public @Native
function graphicsDropLastScalar(base: borrow String) -> String {
    return base.dropLastScalar()
}

public @Native
function graphicsStringConcat(a: borrow String, b: borrow String) -> String {
    return a + b
}

// The cursor and the soft keyboard, routed to the backend that owns the
// window. These were sokol's `sapp_*` when sokol owned input, with a Metal
// supplement bolted beside them; the backend answers for its own window now,
// so there is one path rather than two half-paths gated on the platform.
//
// The backend is built with a null context because what these reach — the
// cursor, the pointer lock — is the window server's and not a per-run object.
// `graphicsDefaultBackend` is what a run without an explicit choice selects,
// which is the same backend its window was opened by.
public @Native
function graphicsInputBackend() -> Any RenderBackend {
    return renderBackendFor(graphicsDefaultBackend(), nullPointer())
}

public @Native
function graphicsShowKeyboard(show: Bool) {
    graphicsInputBackend().showKeyboard(show)
    return
}

public @Native
function graphicsKeyboardShown() -> Bool {
    return graphicsInputBackend().keyboardShown()
}

public @Native
function graphicsShowMouse(show: Bool) {
    graphicsInputBackend().showMouse(show)
    return
}

// Lock the pointer for a look/pan drag: it stops moving on screen and stops
// leaving the window, while movement still arrives as deltas.
//
// Separate from `graphicsShowMouse` because they are separate things — a hidden
// cursor that still roams is what makes a camera drag run off the window and
// jam at the screen edge — and paired the same way: one lock per one unlock.
public @Native
function graphicsLockMouse(lock: Bool) {
    graphicsInputBackend().lockMouse(lock)
    return
}

public @Native
function graphicsMouseLocked() -> Bool {
    return graphicsInputBackend().mouseLocked()
}

public @Native
function graphicsMouseShown() -> Bool {
    return graphicsInputBackend().mouseShown()
}
