import Foundation
// The test-harness controls a run reads, and the two backend-neutral C symbols
// underneath them.
//
// These controls belong to the shared application harness, not to a renderer:
// reading knobs off the
// environment, replaying a typing script through the ordinary event handler,
// and timing a frame are the same on Metal and on Dawn, which both reach them
// through here.

// The monotonic clock, from `NativeLibs/Support`. See `DawnFrameStats.kira` for
// why Windows keeps its own counter instead.
public @FFI.Extern { library: graphics_support, symbol: kg_monotonic_seconds, abi: c }
function kgMonotonicSeconds() -> Float

public @FFI.Extern { library: graphics_support, symbol: kg_sleep_seconds, abi: c }
function kgSleepSeconds(seconds: Float): Void

// The live-reload hooks. Weak no-ops unless a live-reload runner defines them,
// which is the only place they do anything.
public @FFI.Extern { library: graphics_support, symbol: kira_live_emit_log_line, abi: c }
function kiraLiveEmitLogLine(line: CString): Void

public @FFI.Extern { library: graphics_support, symbol: kira_live_emit_first_frame, abi: c }
function kiraLiveEmitFirstFrame(): Void

public @FFI.Extern { library: graphics_support, symbol: kira_live_take_reload, abi: c }
function kiraLiveTakeReload(): Bool

// Whether a live-reload runner asked for a reload this frame.
public @Native
function kiraGraphicsLiveReloadPending(): Bool {
    return kiraLiveTakeReload()
}

// The stages a run reports for the live-reload runner to watch. Each is a log
// line the runner greps for; with no runner the weak C no-op drops them.
public @Native
function kiraGraphicsLiveUiFoundationAppStarted(): Void {
    kiraLiveEmitLogLine("live.ui_foundation.app.started")
    return
}

public @Native
function kiraGraphicsLiveUiFoundationTreeBuilt(): Void {
    kiraLiveEmitLogLine("live.ui_foundation.tree.built")
    return
}

public @Native
function kiraGraphicsLiveUiFoundationRetainedTreeReady(): Void {
    kiraLiveEmitLogLine("live.ui_foundation.retained_tree.ready")
    return
}

public @Native
function kiraGraphicsLiveUiFoundationLayoutNonEmpty(): Void {
    kiraLiveEmitLogLine("live.ui_foundation.layout.non_empty")
    return
}

public @Native
function kiraGraphicsLiveUiFoundationRenderCommandsGenerated(): Void {
    kiraLiveEmitLogLine("live.ui_foundation.render_commands.generated")
    return
}

public @Native
function kiraGraphicsLiveVisibleContentSubmitted(): Void {
    kiraLiveEmitLogLine("live.kira_graphics.visible_content.submitted")
    kiraLiveEmitLogLine("KIRA_UI_DRAW_COMMANDS_SUBMITTED")
    kiraLiveEmitLogLine("KIRA_APP_RENDERED_VISIBLE_CONTENT")
    return
}

// A backend reports where a frame reached, for the live-reload runner to watch.
public @Native
function kiraGraphicsLiveFramePresented(): Void {
    kiraLiveEmitLogLine("live.kira_graphics.frame.submitted")
    kiraLiveEmitFirstFrame()
    return
}

public @Native
function kiraGraphicsLiveBackendInitialized(): Void {
    kiraLiveEmitLogLine("live.kira_graphics.backend.initialized")
    return
}

// A small, backend-neutral environment parser for the harness scripts.
//
// KIRA_UI_CLICK_SCRIPT and its siblings use `frame@x,y;frame@x,y`. Every
// integer is parsed in order, so separators are deliberately insignificant and
// negative coordinates stay useful for input tests that verify misses.
public @Native
function harnessEnvInts(value: borrow String) -> [Int] {
    var out: [Int] = []
    var i = 0
    var going = true
    while going {
        if i >= value.count {
            going = false
        } else {
            let b = value.charAt(i)
            var isDigit = false
            if b >= 48 {
                if b <= 57 {
                    isDigit = true
                }
            }
            var sign = 1
            if b == 45 && i + 1 < value.count {
                let nextByte = value.charAt(i + 1)
                if nextByte >= 48 {
                    if nextByte <= 57 {
                        isDigit = true
                        sign = 0 - 1
                        i = i + 1
                    }
                }
            }
            if isDigit {
                var v = 0
                var digits = true
                while digits && i < value.count {
                    let c = value.charAt(i)
                    var cDigit = false
                    if c >= 48 {
                        if c <= 57 {
                            cDigit = true
                        }
                    }
                    if cDigit {
                        v = v * 10 + (Int(c) - 48)
                        i = i + 1
                    } else {
                        digits = false
                    }
                }
                out.append(v * sign)
            } else {
                i = i + 1
            }
        }
        if i > 65536 {
            going = false
        }
    }
    return move out
}

// A run handed a harness value takes its knobs from there; otherwise it reads
// the environment. Both backends resolve their knobs through here.
public @Native
function readHarnessKnobs(state: borrow mut GraphicsAppRuntimeState) {
    if state.app.harness.configured {
        applyHarnessConfig(state)
        return
    }
    state.quitAfterFrames = environmentInt("KIRA_GRAPHICS_QUIT_AFTER_FRAMES", 0)
    // How many points the window's size sweeps by each frame, for measuring the
    // resize path. Zero, so a run that did not ask resizes nothing.
    state.resizeSweep = environmentInt("KIRA_GRAPHICS_RESIZE_SWEEP", 0)
    let logFps = environmentValue("KIRA_GRAPHICS_LOG_FPS")
    state.logFps = logFps.count > 0 && logFps != "0"
    let clickScript = environmentValue("KIRA_UI_CLICK_SCRIPT")
    if clickScript.count > 0 {
        state.clickScript = harnessEnvInts(clickScript)
    }
    let scrollScript = environmentValue("KIRA_UI_SCROLL_SCRIPT")
    if scrollScript.count > 0 {
        state.scrollScript = harnessEnvInts(scrollScript)
    }
    let dragScript = environmentValue("KIRA_UI_DRAG_SCRIPT")
    if dragScript.count > 0 {
        state.dragScript = harnessEnvInts(dragScript)
    }
    let keyScript = environmentValue("KIRA_UI_KEY_SCRIPT")
    if keyScript.count > 0 {
        state.keyScript = harnessEnvInts(keyScript)
    }
    let textScript = environmentValue("KIRA_UI_TEXT_SCRIPT")
    if textScript.count > 0 {
        state.textScript = harnessEnvInts(textScript)
    }
    state.capturePath = environmentValue("KIRA_GRAPHICS_CAPTURE_FRAME")
    if state.capturePath.count == 0 {
        // No frame is ever numbered 0, so nothing captures.
        state.captureAtFrame = 0
        return
    }
    var at = environmentInt("KIRA_GRAPHICS_CAPTURE_AT", 0)
    if at <= 0 {
        at = state.quitAfterFrames
    }
    if at <= 0 {
        at = 1
    }
    state.captureAtFrame = at
    return
}

// A harness value, copied into the run's knobs.
public @Native
function applyHarnessConfig(state: borrow mut GraphicsAppRuntimeState) {
    let h = state.app.harness
    state.quitAfterFrames = h.quitAfterFrames
    state.resizeSweep = h.resizeSweep
    state.logFps = h.logFps
    state.clickScript = h.clickScript
    state.scrollScript = h.scrollScript
    state.dragScript = h.dragScript
    state.keyScript = h.keyScript
    state.textScript = h.textScript
    state.capturePath = h.capturePath
    if state.capturePath.count == 0 {
        state.captureAtFrame = 0
        return
    }
    var at = h.captureAtFrame
    if at <= 0 {
        at = state.quitAfterFrames
    }
    if at <= 0 {
        at = 1
    }
    state.captureAtFrame = at
    return
}

// Replays the key and text scripts for one frame through the ordinary event
// handler, so a driven run and a real one take the same path.
public @Native
function driveTypingScripts(state: borrow mut GraphicsAppRuntimeState, scriptFrame: Int) {
    let onEvent: (borrow AppEvent) -> Void = state.app.eventHandler
    var keyIndex = 0
    while keyIndex + 3 <= state.keyScript.count {
        if state.keyScript[keyIndex] == scriptFrame {
            var kind: AppEventKind = .KeyUp
            if state.keyScript[keyIndex + 2] == 1 {
                kind = .KeyDown
            }
            onEvent(AppEvent {
                kind: kind,
                keyCode: state.keyScript[keyIndex + 1]
            })
        }
        keyIndex = keyIndex + 3
    }
    var textIndex = 0
    while textIndex + 2 <= state.textScript.count {
        if state.textScript[textIndex] == scriptFrame {
            onEvent(AppEvent {
                kind: .TextInput,
                textCodepoint: state.textScript[textIndex + 1]
            })
        }
        textIndex = textIndex + 2
    }
    return
}
