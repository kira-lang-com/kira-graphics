// Kira Graphics Metal backend — application lifecycle.
//
// This backend talks to Metal, QuartzCore and AppKit/UIKit DIRECTLY through
// Kira FFI (the Objective-C runtime: objc_getClass / sel_registerName /
// objc_msgSend, plus MTLCreateSystemDefaultDevice). There is no C/Objective-C
// shim: every native call is an `@FFI.Extern` to a system symbol, invoked from
// Kira. The `NativeLibs/Metal.toml` library carries only framework linkage.
//
// By default this opens a real on-screen window with a CAMetalLayer and runs the
// app's frame loop. Setting KIRA_METAL_OFFSCREEN renders one frame to an offscreen
// target and reads the center pixel back instead, for deterministic headless
// verification (the kik Test harness asserts pixels through the same paths via the
// MetalSelfTest entry points).

@Native
function metalRunApplication(app: borrow GraphicsApplication, runtimeUserData: RawPtr): Void {
    // Become a foreground GUI app BEFORE creating the Metal device. The device
    // (MTLCreateSystemDefaultDevice) and the window both need a WindowServer
    // connection; establishing the app up front keeps the ordering explicit.
    metalActivateApp()
    // One autorelease pool around the whole run; per-frame pools drain inside the
    // loop. The Metal shader compiler and Foundation helpers create many autoreleased
    // temporaries, and draining them at well-defined points keeps resource creation
    // deterministic and bounds memory over a long-running window.
    let pool = metalAutoreleasePoolPush()
    let ctxPtr = metalContextAlloc()

    // The recovered runtime state only carries the user pointer; lifecycle handlers
    // come directly from the borrowed application (closures captured in the app do
    // not survive the nativeState round-trip on the hybrid backend, but the borrowed
    // `app` retains them intact).
    var state = nativeRecover<GraphicsAppRuntimeState>(runtimeUserData)
    let userData = state.userData

    let offscreenEnv = metalGetEnv("KIRA_METAL_OFFSCREEN")
    if !pointerIsNull(offscreenEnv) {
        metalRunOffscreenApplication(app, ctxPtr, userData, pool)
        return
    }

    // On-screen: create a window + CAMetalLayer, run the frame loop until the app
    // requests quit or the window is closed.
    let view = metalCreateWindow(app.width, app.height, app.title, app.windowMode)
    metalContextSetHighDpi(ctxPtr, app.highDpi)
    // Launch harness: capture destination, the frame to take it on, and how many
    // frames the run lasts — the same knobs the sokol and Dawn loops resolve, so
    // `--capture` means the same thing on every backend rather than nothing on
    // this one.
    let harness = metalHarnessKnobs(app)
    metalContextAttachLayerToView(ctxPtr, view, app.width, app.height, harness.capturePath.count > 0)
    let nsApp = metalSharedApp()
    kiraGraphicsLiveBackendInitialized()

    let onInit: (Graphics) -> Void = app.initHandler
    let initGraphics = Graphics {
        userData: userData,
        backend: .Metal,
        backendContext: ctxPtr
    }
    onInit(move initGraphics)

    // Install a window-resize delegate that renders during a drag. AppKit runs a
    // modal resize-tracking loop inside -sendEvent:, so this main loop cannot
    // update layout until the delegate re-enters the frame handler.
    let liveStorage = nativeState(MetalLiveState {
        ctx: ctxPtr,
        userData: userData,
        runtimeUserData: runtimeUserData,
        closed: false
    })
    let liveHandle = nativeUserData(liveStorage)
    let hostWindow: RawPtr = metalMsgSend(view, metalSel("window"))
    var resizeDelegate = nullPointer()
    if !pointerIsNull(hostWindow) {
        resizeDelegate = metalInstallResizeDelegate(hostWindow, liveHandle)
    }

    let onFrame: (borrow mut RenderFrame) -> Void = app.frameHandler

    // Bound ONCE for the whole loop (like onFrame): calling a closure does not
    // consume it, but re-taking it from the app each frame would move its
    // captured environment out and leave later fetches dangling.
    let onWindowEvent: (borrow AppEvent) -> Void = app.eventHandler
    // Same synthetic-event scripts the offscreen harness honors, so on-screen
    // crashes reproduce deterministically under a debugger.
    var onClicks: [Int] = []
    let onClickEnv = metalGetEnv("KIRA_UI_CLICK_SCRIPT")
    if !pointerIsNull(onClickEnv) {
        onClicks = metalEnvInts(onClickEnv)
    }
    // Drag script (startFrame, x, y, dx, dy, buttonRaw, steps), the same tuples
    // the offscreen harness honors: press at (x,y), walk the delta over `steps`
    // frames, release after. A slider, a scrubber and a camera gesture are all
    // drags, and a click script reaches none of them — an on-screen loop that can
    // only be clicked leaves everything drag-driven untestable on the path that
    // actually runs.
    var onDrags: [Int] = []
    let onDragEnv = metalGetEnv("KIRA_UI_DRAG_SCRIPT")
    if !pointerIsNull(onDragEnv) {
        onDrags = metalEnvInts(onDragEnv)
    }
    // Programmatic window resize (frame, w, h triples) — drives the REAL AppKit
    // resize path (windowDidResize, drawable sync) for deterministic testing.
    var onResizes: [Int] = []
    let onResizeEnv = metalGetEnv("KIRA_UI_RESIZE_SCRIPT")
    if !pointerIsNull(onResizeEnv) {
        onResizes = metalEnvInts(onResizeEnv)
    }
    var onFrameIndex = 0
    // Deterministic shutdown for the real AppKit/CAMetalLayer path. This keeps
    // on-screen dump and leak probes bounded instead of leaving an orphaned
    // `main` process rendering forever after its launching shell exits.
    var onScreenFrameLimit = harness.quitAfterFrames
    let onScreenFramesEnv = metalGetEnv("KIRA_METAL_ONSCREEN_FRAMES")
    if !pointerIsNull(onScreenFramesEnv) {
        let parsedOnScreenFrames = metalEnvInt(onScreenFramesEnv)
        if parsedOnScreenFrames > 0 {
            onScreenFrameLimit = parsedOnScreenFrames
        }
    }
    var running = true
    var liveFramePresented = false
    var nextFrameDeadlineNs: U64 = 0
    // A visible window stays UNCAPPED. Pacing the loop to the display would make
    // every frame even, but only by refusing to let the app run: it caps the
    // measurement at the refresh period, so a frame that costs 1.5 ms and one
    // that costs 16 ms both read as 16.7 ms. A renderer is judged on the work a
    // frame takes, and a limiter is the one change guaranteed to hide it.
    //
    // An app that genuinely wants a cadence sets `targetFrameDurationNs`.
    let framePacingNs = app.targetFrameDurationNs
    // On-screen visual proof: the env VALUE is the destination path for the raw
    // BGRA8 bytes of the drawable this loop presented. A window's own pixels are
    // the only thing that settles "it renders" for a session that cannot look at
    // the screen — an offscreen dump proves the renderer, not the window. Each
    // frame overwrites the last, so the file holds whatever was on screen when the
    // run ended. Requires the layer to have opted out of framebufferOnly, which
    // the same variable does at attach time.
    let onScreenDumpEnv = metalGetEnv("KIRA_METAL_ONSCREEN_DUMP")
    // Per-frame trace for the ON-SCREEN loop, the counterpart of the benchmark's
    // KIRA_METAL_BENCH_DETAIL. The offscreen benchmark measures a compositor with
    // nothing to present to, so it cannot see the presentation path at all; only
    // this measures what a window does. A frame rate that swings has to be read
    // frame by frame — the HUD's own readout is one frame's delta, which shows
    // the swing without saying what it is made of.
    let onScreenTraceEnv = metalGetEnv("KIRA_METAL_ONSCREEN_TRACE")
    // KIRA_METAL_ONSCREEN_BENCH=N: the real-window percentile bench. N frames
    // are measured after a short warmup, on this same visible, presenting
    // loop; the summary prints at exit (metalBenchReport). Sets its own frame
    // limit so a bench run is bounded by construction.
    var benchFrames = 0
    let onScreenBenchEnv = metalGetEnv("KIRA_METAL_ONSCREEN_BENCH")
    if !pointerIsNull(onScreenBenchEnv) {
        let parsedBench = metalEnvInt(onScreenBenchEnv)
        if parsedBench > 0 {
            benchFrames = parsedBench
        }
    }
    let benchWarmup = 30
    if benchFrames > 0 && onScreenFrameLimit == 0 {
        onScreenFrameLimit = benchWarmup + benchFrames
    }
    var benchFrameNs: [Int] = []
    var benchCpuNs: [Int] = []
    var benchGpuNs: [Int] = []
    // Deterministic scheduler verification. Production leaves this unset and uses
    // AppKit visibility/occlusion; tests can force 1/2/3 without automating Finder.
    var windowStateOverride = 0
    let windowStateEnv = metalGetEnv("KIRA_METAL_WINDOW_STATE")
    if !pointerIsNull(windowStateEnv) {
        let parsedWindowState = metalEnvInt(windowStateEnv)
        if parsedWindowState >= 1 && parsedWindowState <= 3 {
            windowStateOverride = parsedWindowState
        }
    }
    while running {
        let frameStartNs = metalClockNs(metalClockUptimeRaw())
        let framePool = metalAutoreleasePoolPush()
        var oci = 0
        while oci + 3 <= onClicks.count {
            if onClicks[oci] == onFrameIndex {
                let opx = Float(onClicks[oci + 1])
                let opy = Float(onClicks[oci + 2])
                let odown = AppEvent {
                    kind: .PointerDown,
                    pointerX: opx,
                    pointerY: opy
                }
                onWindowEvent(odown)
                let oup = AppEvent {
                    kind: .PointerUp,
                    pointerX: opx,
                    pointerY: opy
                }
                onWindowEvent(oup)
            }
            oci = oci + 3
        }
        // One drag, walked a frame at a time: down on the start frame, a move per
        // frame after it, then up. Reported as absolute positions, exactly like a
        // real pointer — the UI derives the distance from its own press point.
        var odi = 0
        while odi + 7 <= onDrags.count {
            let dragStart = onDrags[odi]
            let dragSteps = onDrags[odi + 6]
            if onFrameIndex >= dragStart && onFrameIndex <= dragStart + dragSteps + 1 {
                let obx = Float(onDrags[odi + 1])
                let oby = Float(onDrags[odi + 2])
                let obutton = graphicsPointerButtonFromRaw(onDrags[odi + 5])
                if onFrameIndex == dragStart {
                    onWindowEvent(AppEvent {
                        kind: .PointerDown,
                        pointerButton: obutton,
                        pointerX: obx,
                        pointerY: oby
                    })
                } else {
                    let ostepped = onFrameIndex - dragStart
                    var ot = Float(ostepped) / Float(dragSteps)
                    if ot > 1.0 {
                        ot = 1.0
                    }
                    let omx = obx + Float(onDrags[odi + 3]) * ot
                    let omy = oby + Float(onDrags[odi + 4]) * ot
                    if onFrameIndex <= dragStart + dragSteps {
                        onWindowEvent(AppEvent {
                            kind: .PointerMoved,
                            pointerButton: obutton,
                            pointerX: omx,
                            pointerY: omy
                        })
                    } else {
                        onWindowEvent(AppEvent {
                            kind: .PointerUp,
                            pointerButton: obutton,
                            pointerX: omx,
                            pointerY: omy
                        })
                    }
                }
            }
            odi = odi + 7
        }
        var ori = 0
        while ori + 3 <= onResizes.count {
            if onResizes[ori] == onFrameIndex {
                if !pointerIsNull(hostWindow) {
                    metalMsgSend(hostWindow, metalSel("setFrame:display:"), 60.0, 60.0, Float(onResizes[ori + 1]), Float(onResizes[ori + 2]), true)
                }
            }
            ori = ori + 3
        }
        onFrameIndex = onFrameIndex + 1
        // Dispatch queued window/input events first (activation, title-bar buttons,
        // live resize); translated AppEvents come back for the app handler.
        let windowEvents = metalPumpEvents(nsApp, view, ctxPtr)
        for wei in 0..windowEvents.count {
            onWindowEvent(windowEvents[wei])
        }
        var windowState = metalViewWindowState(view)
        if windowStateOverride > 0 {
            windowState = windowStateOverride
        }
        metalContextSetWindowState(ctxPtr, windowState)
        metalContextBeginFrameTiming(ctxPtr)
        metalContextSyncViewportFromView(ctxPtr)
        let frameGraphics = Graphics {
            userData: userData,
            backend: .Metal,
            backendContext: ctxPtr
        }
        var frame = frameGraphics.frame()
        onFrame(frame)
        // The drawable this frame drew into, taken while the context still holds
        // it: submitting presents it and hands it back to Core Animation.
        var capturedTexture = nullPointer()
        if harness.capturePath.count > 0 && onFrameIndex == harness.captureAtFrame {
            capturedTexture = metalContextDrawableTexture(ctxPtr)
        }
        graphicsSubmitFrame(frame)
        if !pointerIsNull(capturedTexture) {
            let captureW = metalContextPhysicalWidth(ctxPtr)
            let captureH = metalContextPhysicalHeight(ctxPtr)
            if metalCapturePpm(ctxPtr, capturedTexture, captureW, captureH, harness.capturePath) {
                graphicsDiagnostic("Kira Graphics wrote the presented frame to " + harness.capturePath)
            } else {
                graphicsDiagnostic("Kira Graphics could not read the drawable back into " + harness.capturePath)
            }
        }
        metalContextEndFrameTiming(ctxPtr)
        if !pointerIsNull(onScreenTraceEnv) {
            metalReportBenchFrame(ctxPtr, onFrameIndex)
        }
        if benchFrames > 0 && onFrameIndex > benchWarmup && benchFrameNs.count < benchFrames {
            metalBenchCollect(ctxPtr, benchFrameNs, benchCpuNs, benchGpuNs)
        }
        // The frame's passes ended+committed inside graphicsSubmitFrame ->
        // metalContextEndAndCommit, which presented a real on-screen drawable.
        // Signal the live supervisor once (the sokol backend does the same from
        // its frame callback); without this a macOS live session never sees
        // `live.frame.presented` and fails with KCL038.
        if !liveFramePresented {
            liveFramePresented = true
            kiraGraphicsLiveFramePresented()
        }
        if !pointerIsNull(onScreenDumpEnv) {
            let onScreenW = metalContextPhysicalWidth(ctxPtr)
            let onScreenH = metalContextPhysicalHeight(ctxPtr)
            metalContextImageDump(ctxPtr, onScreenW, onScreenH, onScreenDumpEnv)
        }
        if frame.shouldQuit {
            running = false
        }
        if onScreenFrameLimit > 0 && onFrameIndex >= onScreenFrameLimit {
            running = false
        }
        if metalLiveStateClosed(liveHandle) {
            running = false
        }
        metalAutoreleasePoolPop(framePool)
        if windowState == 3 {
            let remainingInterval = metalWindowRemainingInterval(frameStartNs, windowState, metalViewMaximumFramesPerSecond(view))
            if remainingInterval > 0.0 {
                metalSpinRunLoop(remainingInterval)
            }
            nextFrameDeadlineNs = 0
        } else if framePacingNs > 0 {
            if nextFrameDeadlineNs == 0 {
                nextFrameDeadlineNs = frameStartNs + U64(framePacingNs)
            }
            metalContextWaitUntilNs(ctxPtr, nextFrameDeadlineNs)
            // Advance the beat rather than restarting it from now: a wait
            // overshoots its deadline by a little, and folding that overshoot
            // into the next period makes every frame late by it, which is a
            // cadence that drifts — 17.5 ms against a 16.7 ms display.
            //
            // A deadline already in the past is a real miss, and there the
            // cadence does restart: we deliberately never submit catch-up frames
            // against deadlines that have gone.
            let pacedNow = metalClockNs(metalClockUptimeRaw())
            nextFrameDeadlineNs = nextFrameDeadlineNs + U64(framePacingNs)
            if nextFrameDeadlineNs < pacedNow {
                nextFrameDeadlineNs = pacedNow + U64(framePacingNs)
            }
        }
    }

    if benchFrames > 0 {
        metalBenchReport(ctxPtr, benchFrameNs, benchCpuNs, benchGpuNs)
    }
    if !pointerIsNull(hostWindow) {
        metalRemoveResizeDelegate(hostWindow, resizeDelegate)
    }
    nativeStateFree(liveStorage)
    let onCleanup: (Graphics) -> Void = app.cleanupHandler
    let cleanupGraphics = Graphics {
        userData: userData,
        backend: .Metal,
        backendContext: ctxPtr
    }
    onCleanup(move cleanupGraphics)
    metalContextFree(ctxPtr)
    metalAutoreleasePoolPop(pool)
    return
}
