// Foreign-binding type vocabulary for the Win32 / DirectX 12 bindings — the C
// primitive typedefs `bindings/directx12.kira` (and the Win32 surface bits of
// `bindings/vulkan.kira`) assume already exist.
//
// STOPGAP: a header-driven autobind pass will emit these leaf typedefs into the
// binding itself (`typedef unsigned int UINT;` becomes `type UINT = U32`).
// Until autobind lands they live here, in `bind-types/` per the KPK025 rule.
// Delete this file when autobind emits them.
//
// Every alias is transparent: `UINT` and `U32` are the same type, so no use
// site changes and no backend learns the alias existed.

// Fixed-width integers.
type UINT = U32
type UINT32 = U32
type UINT16 = U16
type UINT8 = U8
type UINT64 = U64
type INT = I32
type INT8 = I8
type DWORD = U32
type BYTE = U8

// Win32 BOOL is a 32-bit int.
type BOOL = I32

// Floating point.
type FLOAT = F32

// COM result code (a LONG).
type HRESULT = I32

// Pointer-width integers on the 64-bit targets these bindings build for.
type SIZE_T = U64
type LONG_PTR = I64

// Opaque handles and C string pointers cross the seam as raw pointers.
type HANDLE = RawPtr
type HWND = RawPtr
type HMONITOR = RawPtr
type HINSTANCE = RawPtr
type LPCWSTR = RawPtr
type LPCSTR = RawPtr
type LPCVOID = RawPtr

// `wchar_t` on Windows is 16 bits, so `WCHAR` is an unsigned 16-bit code unit —
// not the 32-bit `wchar_t` of the System V targets.
type WCHAR = U16

// `DXGI_FORMAT` is a C enum (`typedef enum DXGI_FORMAT { … }`), so it carries
// the int width its variants are numbered in. Aliased to that width as a
// stopgap; the named variants arrive with the enum port, as for the Vulkan
// video enums.
type DXGI_FORMAT = I32

// `RECT` is a struct rather than a scalar typedef, so it is declared as the C
// layout it is: `typedef struct tagRECT { LONG left, top, right, bottom; }`,
// with `LONG` a signed 32-bit integer.
@FFI.Struct { layout: c; }
struct RECT {
    let left: I32 = 0
    let top: I32 = 0
    let right: I32 = 0
    let bottom: I32 = 0
}
