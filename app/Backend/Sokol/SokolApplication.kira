import Foundation

@Native
function sokolRunApplication(app: borrow GraphicsApplication, runtimeUserData: RawPtr): Void {
    // A VM hot patch can remap a callback while the original entrypoint is
    // still suspended inside sokol_app. Re-entering this boundary would create
    // a second native window; the process owns one Sokol application lifetime.
    if sapp_isvalid() {
        return
    }
    let desc = sapp_desc {
        init_userdata_cb: kiraGraphicsSokolInit
        frame_userdata_cb: kiraGraphicsSokolFrame
        cleanup_userdata_cb: kiraGraphicsSokolCleanup
        event_userdata_cb: kiraGraphicsSokolEvent
        user_data: runtimeUserData
        width: app.width
        height: app.height
        sample_count: app.sampleCount
        window_title: app.title
        high_dpi: app.highDpi
        fullscreen: sokolWindowIsCovering(app.windowMode)
        logger: sapp_logger {
            func: kiraGraphicsSokolLog
        }
    }

    sapp_run(move desc)
    return
}

@Native
function kiraGraphicsSokolLog(tag: String, level: U32, itemId: U32, message: String, lineNr: U32, filename: String, userData: RawPtr): Void {
    kgSappLog(tag, level, itemId, message, lineNr, filename, userData)
    return
}

@Native
function kiraGraphicsSokolInit(runtimeUserData: RawPtr): Void {
    kgSetup()
    kiraGraphicsLiveBackendInitialized()

    var state = nativeRecover<GraphicsAppRuntimeState>(runtimeUserData)
    readHarnessKnobs(state)
    let onInit: (Graphics) -> Void = state.app.initHandler
    let graphics = Graphics {
        userData: state.userData
        backend: .Sokol
        backendContext: runtimeUserData
    }
    onInit(move graphics)
    return
}

@Native
function kiraGraphicsSokolEvent(eventPtr: sapp_event_ptr, runtimeUserData: RawPtr): Void {
    var state = nativeRecover<GraphicsAppRuntimeState>(runtimeUserData)
    let onEvent: (borrow AppEvent) -> Void = state.app.eventHandler
    let event = graphicsEventFromSapp(eventPtr)
    sokolTrackWindowState(state, event.kind)
    onEvent(event)
    return
}

@Native
function kiraGraphicsSokolFrame(runtimeUserData: RawPtr): Void {
    var state = nativeRecover<GraphicsAppRuntimeState>(runtimeUserData)
    let onFrame: (borrow mut RenderFrame) -> Void = state.app.frameHandler
    let onEvent: (borrow AppEvent) -> Void = state.app.eventHandler
    let graphics = Graphics {
        userData: state.userData
        backend: .Sokol
        backendContext: runtimeUserData
    }
    var frame = graphics.frame()

    state.frameIndex = state.frameIndex + 1
    state.frameStats = sokolBeginFrameStats(state.frameStats)
    // Drive UI through the same event callback as a real pointer. This keeps
    // scripted runs honest: Foundation still updates hover/press state, finds
    // the hit region, invokes the button callback, and rebuilds before render.
    let scriptFrame = state.frameIndex - 1
    var clickIndex = 0
    while clickIndex + 3 <= state.clickScript.count {
        if state.clickScript[clickIndex] == scriptFrame {
            let px = Float(state.clickScript[clickIndex + 1])
            let py = Float(state.clickScript[clickIndex + 2])
            let down = AppEvent {
                kind: .PointerDown
                pointerButton: .Left
                pointerX: px
                pointerY: py
            }
            onEvent(down)
            let up = AppEvent {
                kind: .PointerUp
                pointerButton: .Left
                pointerX: px
                pointerY: py
            }
            onEvent(up)
        }
        clickIndex = clickIndex + 3
    }
    onFrame(frame)
    graphicsSubmitFrame(frame)
    state.frameStats = sokolEndFrameStats(state.frameStats)
    noteFrameCost(state, state.frameStats.cpuSeconds, state.frameStats.passes, state.frameStats.draws)
    state.lifetimePeaks = sokolSampleLifetimePeaks(state.lifetimePeaks)
    if state.frameIndex == state.captureAtFrame {
        sokolCaptureFrame(state.capturePath)
    }
    if state.quitAfterFrames > 0 && state.frameIndex >= state.quitAfterFrames {
        sapp_request_quit()
    }
    return
}

@Native
function kiraGraphicsSokolCleanup(runtimeUserData: RawPtr): Void {
    var state = nativeRecover<GraphicsAppRuntimeState>(runtimeUserData)
    let onCleanup: (Graphics) -> Void = state.app.cleanupHandler
    let graphics = Graphics {
        userData: state.userData
        backend: .Sokol
        backendContext: runtimeUserData
    }

    onCleanup(move graphics)
    sokolDestroyPassResources(state)
    reportFrameCost(state)
    sokolReportLifetime(state.lifetimePeaks)
    sg_shutdown()
    return
}

// The harness knobs a run was started with.
//
// A windowed example has no way to end on its own, and a run that never ends is
// a run a CI job kills rather than reports on — so `KIRA_GRAPHICS_QUIT_AFTER_FRAMES`
// names the frame to stop at. `KIRA_GRAPHICS_CAPTURE_FRAME` names a file the
// presented frame is written to, and `KIRA_GRAPHICS_CAPTURE_AT` the frame to take
// (the quit-after limit by default, so a run that ends on its own captures the
// last thing it drew). That capture is what proves what a frame CONTAINS:
// everything else a run can report — a submitted pass, a draw count, a
// first-frame marker — is equally true of a frame that came out blank.
//
// Read once, at init: they are launch settings, and asking the environment for
// one per frame puts a scan and a string allocation in the frame callback.
@Native
function readHarnessKnobs(state: borrow mut GraphicsAppRuntimeState) {
    state.quitAfterFrames = environmentInt("KIRA_GRAPHICS_QUIT_AFTER_FRAMES", 0)
    // How many points the window's size sweeps by each frame, for measuring the
    // resize path. A resize is the expensive frame — the layout is redone, and
    // for a host that rebuilds, the whole tree with it — and it is the one a
    // hand cannot drive repeatably. Zero, so a run that did not ask resizes
    // nothing.
    state.resizeSweep = environmentInt("KIRA_GRAPHICS_RESIZE_SWEEP", 0)
    let logFps = environmentValue("KIRA_GRAPHICS_LOG_FPS")
    state.logFps = logFps.count > 0 && logFps != "0"
    let clickScript = environmentValue("KIRA_UI_CLICK_SCRIPT")
    if clickScript.count > 0 {
        state.clickScript = sokolEnvInts(clickScript)
    }
    let scrollScript = environmentValue("KIRA_UI_SCROLL_SCRIPT")
    if scrollScript.count > 0 {
        state.scrollScript = sokolEnvInts(scrollScript)
    }
    let dragScript = environmentValue("KIRA_UI_DRAG_SCRIPT")
    if dragScript.count > 0 {
        state.dragScript = sokolEnvInts(dragScript)
    }
    state.capturePath = environmentValue("KIRA_GRAPHICS_CAPTURE_FRAME")
    if state.capturePath.count == 0 {
        // No frame is ever numbered 0, so nothing captures.
        state.captureAtFrame = 0
        return
    }
    var at = environmentInt("KIRA_GRAPHICS_CAPTURE_AT", 0)
    if at <= 0 {
        at = state.quitAfterFrames
    }
    if at <= 0 {
        at = 1
    }
    state.captureAtFrame = at
    return
}

@Native
function sokolCaptureFrame(path: borrow String) {
    if kgCaptureSwapchainPpm(path) {
        graphicsDiagnostic("Kira Graphics wrote the presented frame to " + path)
    } else {
        graphicsDiagnostic("Kira Graphics could not read the swapchain back into " + path)
    }
    return
}
