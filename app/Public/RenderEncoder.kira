import Foundation
public struct RenderEncoderState {
    var pipeline: RenderPipeline
    var hasPipeline: Bool = false
    var passActive: Bool = false
    // A non-null backendContext selects the Metal backend for draw encoding. (An
    // enum field here proved unreliable to read back from nativeState storage; a
    // pointer presence check is robust.) It is the Metal context and nothing
    // else.
    var backendContext: RawPtr
    // The `GraphicsAppRuntimeState` behind a Dawn frame, which is where the open
    // pass encoder lives. Non-null selects the WebGPU draw path; a Metal encoder
    // fills `backendContext` instead, and exactly one of the two is filled.
    var dawnRuntime: RawPtr
    // The Vulkan runtime state behind a Vulkan frame. Exactly one of the three
    // backend pointers is filled by `makeRenderEncoderForBackend`.
    var vulkanRuntime: RawPtr

    var vertexBufferId: U32 = 0
    var hasVertexBuffer: Bool = false

    var indexBufferId: U32 = 0
    var hasIndexBuffer: Bool = false
    var indexFormat: IndexFormat = .Uint32

    // Each slot holds the whole `BindGroup`, not just its id: Vulkan/Dawn draw
    // path reads bound uniforms' *current* values straight off it (see
    // code reads bound uniforms' current values, which a bare id would give it no way to reach now
    // that there is no `kg_bind_group_records` table to look one up in.
    var bindGroup0: BindGroup
    var hasBindGroup0: Bool = false
    var bindGroup1: BindGroup
    var hasBindGroup1: Bool = false
    var bindGroup2: BindGroup
    var hasBindGroup2: Bool = false
    var bindGroup3: BindGroup
    var hasBindGroup3: Bool = false

    var vertexCount: Int = 0
    var indexCount: Int = 0
    var instanceCount: Int = 1

    // The scissor a caller set, in top-left pixels of the pass. Remembered
    // rather than applied and forgotten: the portable draw paths set the viewport
    // and scissor itself on every draw — the pass it is drawing into may be an
    // offscreen target of its own size — and used to reset both to the whole
    // pass, so a `setScissorRect` was overwritten by the very next draw and the
    // glass capture redrew the whole scene for each of its bounds instead of
    // the rectangle it asked for.
    var hasScissor: Bool = false
    var scissorX: Int = 0
    var scissorY: Int = 0
    var scissorWidth: Int = 0
    var scissorHeight: Int = 0
}

public class RenderEncoder {
    var storage: NativeState<RenderEncoderState>

    function setPipeline(pipeline: borrow RenderPipeline) {
        var state = nativeRecover<RenderEncoderState>(self.storage)
        state.pipeline = pipeline
        state.hasPipeline = pipeline.id != 0
        return
    }

    function setVertexBuffer(buffer: borrow GraphicsBuffer) {
        var state = nativeRecover<RenderEncoderState>(self.storage)
        state.vertexBufferId = buffer.id
        state.hasVertexBuffer = buffer.id != 0
        return
    }

    function setIndexBuffer(buffer: borrow GraphicsBuffer, format: IndexFormat) {
        var state = nativeRecover<RenderEncoderState>(self.storage)
        state.indexBufferId = buffer.id
        state.indexFormat = format
        state.hasIndexBuffer = buffer.id != 0
        return
    }

    function setBindGroup(slot: Int, bindGroup: borrow BindGroup) {
        var state = nativeRecover<RenderEncoderState>(self.storage)
        if (slot == 0) {
            state.bindGroup0 = bindGroup
            state.hasBindGroup0 = bindGroup.id != 0
        }
        if (slot == 1) {
            state.bindGroup1 = bindGroup
            state.hasBindGroup1 = bindGroup.id != 0
        }
        if (slot == 2) {
            state.bindGroup2 = bindGroup
            state.hasBindGroup2 = bindGroup.id != 0
        }
        if (slot == 3) {
            state.bindGroup3 = bindGroup
            state.hasBindGroup3 = bindGroup.id != 0
        }
        return
    }

    function draw(vertexCount: Int) {
        var state = nativeRecover<RenderEncoderState>(self.storage)
        state.vertexCount = vertexCount
        state.indexCount = 0
        state.instanceCount = 1
        if (state.passActive && state.hasPipeline && state.pipeline.id != 0) {
            if !pointerIsNull(state.dawnRuntime) {
                dawnEncoderIssue(state, 0)
                return
            }
            if !pointerIsNull(state.vulkanRuntime) {
                vulkanEncoderIssue(state, 0)
                return
            }
            if metalContextActive(state.backendContext) {
                if state.hasBindGroup0 { metalEncoderApplyBindGroup(state.backendContext, state.bindGroup0.id) }
                if state.hasBindGroup1 { metalEncoderApplyBindGroup(state.backendContext, state.bindGroup1.id) }
                if state.hasBindGroup2 { metalEncoderApplyBindGroup(state.backendContext, state.bindGroup2.id) }
                if state.hasBindGroup3 { metalEncoderApplyBindGroup(state.backendContext, state.bindGroup3.id) }
                metalEncoderDraw(state.backendContext, state.pipeline.id, state.vertexBufferId, state.hasVertexBuffer, state.vertexCount, state.instanceCount)
                return
            }
        }
        return
    }

    function drawIndexed(indexCount: Int) {
        var state = nativeRecover<RenderEncoderState>(self.storage)
        state.indexCount = indexCount
        state.vertexCount = 0
        state.instanceCount = 1
        if (state.passActive && state.hasPipeline && state.pipeline.id != 0) {
            if !pointerIsNull(state.dawnRuntime) {
                dawnEncoderIssue(state, 0)
                return
            }
            if !pointerIsNull(state.vulkanRuntime) {
                vulkanEncoderIssue(state, 0)
                return
            }
            if metalContextActive(state.backendContext) {
                if state.hasBindGroup0 { metalEncoderApplyBindGroup(state.backendContext, state.bindGroup0.id) }
                if state.hasBindGroup1 { metalEncoderApplyBindGroup(state.backendContext, state.bindGroup1.id) }
                if state.hasBindGroup2 { metalEncoderApplyBindGroup(state.backendContext, state.bindGroup2.id) }
                if state.hasBindGroup3 { metalEncoderApplyBindGroup(state.backendContext, state.bindGroup3.id) }
                metalEncoderDrawIndexed(state.backendContext, state.pipeline.id, state.vertexBufferId, state.hasVertexBuffer, state.indexBufferId, state.indexCount, state.instanceCount)
                return
            }
        }
        return
    }

    // Pixel-space scissor in the current render target. Every backend
    // implement it; callers restore the full target explicitly when finished.
    function setScissorRect(x: Int, y: Int, width: Int, height: Int) {
        var state = nativeRecover<RenderEncoderState>(self.storage)
        if !state.passActive || width <= 0 || height <= 0 {
            return
        }
        if metalContextActive(state.backendContext) {
            metalEncoderSetScissorRect(state.backendContext, x, y, width, height)
            return
        }
        state.hasScissor = true
        state.scissorX = x
        state.scissorY = y
        state.scissorWidth = width
        state.scissorHeight = height
        return
    }

    function drawIndexedRange(indexCount: Int, firstIndex: Int) {
        var state = nativeRecover<RenderEncoderState>(self.storage)
        state.indexCount = indexCount
        state.vertexCount = 0
        state.instanceCount = 1
        if state.passActive && state.hasPipeline && state.pipeline.id != 0 {
            if !pointerIsNull(state.dawnRuntime) {
                dawnEncoderIssue(state, firstIndex)
                return
            }
            if !pointerIsNull(state.vulkanRuntime) {
                vulkanEncoderIssue(state, firstIndex)
                return
            }
            if metalContextActive(state.backendContext) {
                if state.hasBindGroup0 { metalEncoderApplyBindGroup(state.backendContext, state.bindGroup0.id) }
                if state.hasBindGroup1 { metalEncoderApplyBindGroup(state.backendContext, state.bindGroup1.id) }
                if state.hasBindGroup2 { metalEncoderApplyBindGroup(state.backendContext, state.bindGroup2.id) }
                if state.hasBindGroup3 { metalEncoderApplyBindGroup(state.backendContext, state.bindGroup3.id) }
                metalEncoderDrawIndexedRange(state.backendContext, state.pipeline.id, state.vertexBufferId, state.hasVertexBuffer, state.indexBufferId, state.indexCount, state.instanceCount, firstIndex)
                return
            }
        }
        return
    }

    // GPU-driven draw: arguments come from a compute-written indirect buffer.
    function drawIndirect(indirectBufferId: Int) {
        var state = nativeRecover<RenderEncoderState>(self.storage)
        if (state.passActive && state.hasPipeline && state.pipeline.id != 0) {
            if !pointerIsNull(state.dawnRuntime) {
                dawnEncoderDrawIndirect(state, indirectBufferId)
                return
            }
            if !pointerIsNull(state.vulkanRuntime) {
                vulkanEncoderDrawIndirect(state, indirectBufferId)
                return
            }
            if metalContextActive(state.backendContext) {
                if state.hasBindGroup0 { metalEncoderApplyBindGroup(state.backendContext, state.bindGroup0.id) }
                if state.hasBindGroup1 { metalEncoderApplyBindGroup(state.backendContext, state.bindGroup1.id) }
                if state.hasBindGroup2 { metalEncoderApplyBindGroup(state.backendContext, state.bindGroup2.id) }
                if state.hasBindGroup3 { metalEncoderApplyBindGroup(state.backendContext, state.bindGroup3.id) }
                metalEncoderDrawIndirect(state.backendContext, state.pipeline.id, state.vertexBufferId, state.hasVertexBuffer, indirectBufferId)
                return
            }
        }
        return
    }

    function drawInstanced(vertexCount: Int, instanceCount: Int) {
        var state = nativeRecover<RenderEncoderState>(self.storage)
        state.vertexCount = vertexCount
        state.indexCount = 0
        state.instanceCount = instanceCount
        if (state.passActive && state.hasPipeline && state.pipeline.id != 0) {
            if !pointerIsNull(state.dawnRuntime) {
                dawnEncoderIssue(state, 0)
                return
            }
            if !pointerIsNull(state.vulkanRuntime) {
                vulkanEncoderIssue(state, 0)
                return
            }
            if metalContextActive(state.backendContext) {
                if state.hasBindGroup0 { metalEncoderApplyBindGroup(state.backendContext, state.bindGroup0.id) }
                if state.hasBindGroup1 { metalEncoderApplyBindGroup(state.backendContext, state.bindGroup1.id) }
                if state.hasBindGroup2 { metalEncoderApplyBindGroup(state.backendContext, state.bindGroup2.id) }
                if state.hasBindGroup3 { metalEncoderApplyBindGroup(state.backendContext, state.bindGroup3.id) }
                metalEncoderDraw(state.backendContext, state.pipeline.id, state.vertexBufferId, state.hasVertexBuffer, state.vertexCount, state.instanceCount)
                return
            }
        }
        return
    }

    function drawIndexedInstanced(indexCount: Int, instanceCount: Int) {
        var state = nativeRecover<RenderEncoderState>(self.storage)
        state.indexCount = indexCount
        state.vertexCount = 0
        state.instanceCount = instanceCount
        if (state.passActive && state.hasPipeline && state.pipeline.id != 0) {
            if !pointerIsNull(state.dawnRuntime) {
                dawnEncoderIssue(state, 0)
                return
            }
            if !pointerIsNull(state.vulkanRuntime) {
                vulkanEncoderIssue(state, 0)
                return
            }
        }
        return
    }

}

// Everything a Dawn draw needs, read off the encoder's own state.
//
// One function rather than the same twenty arguments written out at each of the
// five draw methods — the Metal arm above predates it and still does.
public function dawnEncoderIssue(state: borrow RenderEncoderState, firstIndex: Int) {
    dawnDrawWithBindings(
        state.dawnRuntime,
        state.hasScissor, state.scissorX, state.scissorY, state.scissorWidth, state.scissorHeight,
        state.pipeline,
        state.vertexBufferId, state.hasVertexBuffer,
        state.indexBufferId, state.hasIndexBuffer,
        state.indexFormat,
        state.bindGroup0, state.hasBindGroup0,
        state.bindGroup1, state.hasBindGroup1,
        state.bindGroup2, state.hasBindGroup2,
        state.bindGroup3, state.hasBindGroup3,
        firstIndex,
        state.vertexCount,
        state.indexCount,
        state.instanceCount
    )
    return
}

public function vulkanEncoderIssue(state: borrow RenderEncoderState, firstIndex: Int) {
    vulkanDrawWithBindings(
        state.vulkanRuntime,
        state.hasScissor, state.scissorX, state.scissorY, state.scissorWidth, state.scissorHeight,
        state.pipeline,
        state.vertexBufferId, state.hasVertexBuffer,
        state.indexBufferId, state.hasIndexBuffer,
        state.indexFormat,
        state.bindGroup0, state.hasBindGroup0,
        state.bindGroup1, state.hasBindGroup1,
        state.bindGroup2, state.hasBindGroup2,
        state.bindGroup3, state.hasBindGroup3,
        firstIndex,
        state.vertexCount,
        state.indexCount,
        state.instanceCount
    )
    return
}

public @Native
function makeRenderEncoder() -> RenderEncoder {
    return makeRenderEncoderForBackend(false, nullPointer(), nullPointer(), nullPointer())
}

public function makeRenderEncoderForBackend(passActive: Bool, backendContext: RawPtr, dawnRuntime: RawPtr, vulkanRuntime: RawPtr) -> RenderEncoder {
    // The empty slots carry no state box: every read of a slot is gated on its
    // `has` flag, so a group that was never set needs no storage — and giving
    // it some, as this once did, allocated four boxes per encoder that nothing
    // could free once `setBindGroup` overwrote the only token naming them.
    let state = nativeState(RenderEncoderState {
        pipeline: emptyRenderPipeline(),
        hasPipeline: false,
        passActive: passActive,
        hasScissor: false,
        backendContext: backendContext,
        dawnRuntime: dawnRuntime,
        vulkanRuntime: vulkanRuntime,
        vertexBufferId: 0,
        hasVertexBuffer: false,
        indexBufferId: 0,
        hasIndexBuffer: false,
        indexFormat: .Uint32,
        bindGroup0: unboundBindGroup(),
        hasBindGroup0: false,
        bindGroup1: unboundBindGroup(),
        hasBindGroup1: false,
        bindGroup2: unboundBindGroup(),
        hasBindGroup2: false,
        bindGroup3: unboundBindGroup(),
        hasBindGroup3: false,
        vertexCount: 0,
        indexCount: 0,
        instanceCount: 1
    })
    return RenderEncoder {
        storage: move state
    }
}
