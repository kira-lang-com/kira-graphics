// The Linux window, opened on Wayland.
//
// The shape of a Wayland window is not the shape of a Win32 one, and this is
// where that shows. On Windows a window exists the moment `CreateWindowExA`
// returns. Here a client connects, asks the compositor what it offers, waits for
// the answer, binds the two globals a window needs out of it, makes a surface,
// gives that surface a role, and only then has something that can be shown --
// and the compositor decides when that is, by sending a configure the client
// acknowledges.
//
// The protocol entry points are generated C inline functions, exposed through
// the package's autobound Wayland seam so this file stays protocol-shaped Kira.
//
// The handlers write into a block the caller owns, passed as the `data` pointer
// `wl_proxy_add_listener` carries. That is not a workaround: Kira has no
// globals, and an event handler that must remember something has to be given
// somewhere to put it.

// The compositor pings; a client that never pongs is one it may call
// unresponsive and stop drawing.
function waylandOnPing(data: RawPtr, shell: RawPtr, serial: U32) {
    kira_wayland_shell_pong(shell, serial)
    return
}

// A surface is not shown until the serial its configure carried is acknowledged.
function waylandOnConfigure(data: RawPtr, xdgSurface: RawPtr, serial: U32) {
    kira_wayland_surface_ack_configure(xdgSurface, serial)
    return
}

// One global the compositor offers, reported by hanging what was bound on the
// registry that asked for it.
//
// There are two globals a window needs and one user-data word per proxy, so the
// window opens two registries and gives each its own handler. A client may open
// as many as it likes and every one replays the whole list, so this costs one
// extra replay at startup and buys a handler that stores without writing.
function waylandOnCompositorGlobal(data: RawPtr, registry: RawPtr, name: U32, interface: RawPtr, version: U32) {
    if waylandNameEquals(interface, "wl_compositor") == I32(0) {
        kira_wayland_proxy_set_user_data(registry, kira_wayland_registry_bind_compositor(registry, name, U32(4)))
    }
    return
}

function waylandOnShellGlobal(data: RawPtr, registry: RawPtr, name: U32, interface: RawPtr, version: U32) {
    if waylandNameEquals(interface, "xdg_wm_base") == I32(0) {
        kira_wayland_proxy_set_user_data(registry, kira_wayland_registry_bind_shell(registry, name, U32(1)))
    }
    return
}

// The decoration manager, on a registry of its own for the same reason the other
// two have theirs: one user-data word per proxy, and a handler that reports by
// setting it.
function waylandOnDecorationGlobal(data: RawPtr, registry: RawPtr, name: U32, interface: RawPtr, version: U32) {
    if waylandNameEquals(interface, "zxdg_decoration_manager_v1") == I32(0) {
        kira_wayland_proxy_set_user_data(
            registry,
            kira_wayland_registry_bind_decoration_manager(registry, name, U32(1)),
        )
    }
    return
}

// A global going away matters to a client holding one. This window binds only
// the compositor and the shell, and neither leaves while a window is open.
function waylandOnGlobalRemove(data: RawPtr, registry: RawPtr, name: U32) {
    return
}

construct DawnWindowWayland() extends DawnWindow {
    function open(title: borrow String, width: Int, height: Int, mode: borrow WindowMode, transparent: Bool, opacity: Float) -> RawPtr {
        let display = kira_wayland_display_connect()
        if pointerIsNull(display) {
            graphicsDiagnostic(
                "Kira Graphics: no Wayland display to open the Dawn backend's window on"
            )
            return nullPointer()
        }

        let registry = kira_wayland_display_get_registry(display)
        if pointerIsNull(registry) {
            graphicsDiagnostic("Kira Graphics: the Wayland display refused a registry")
            kira_wayland_display_disconnect(display)
            return nullPointer()
        }

        var compositorListener = kira_wayland_registry_listener {
            global: waylandOnCompositorGlobal
            global_remove: waylandOnGlobalRemove
        }
        let ignoredCompositorListener =
            kira_wayland_registry_add_listener(registry, move compositorListener, nullPointer())

        // The second registry, for the second global. See the handlers above.
        let shellRegistry = kira_wayland_display_get_registry(display)
        if pointerIsNull(shellRegistry) {
            graphicsDiagnostic("Kira Graphics: the Wayland display refused a second registry")
            kira_wayland_display_disconnect(display)
            return nullPointer()
        }
        var shellRegistryListener = kira_wayland_registry_listener {
            global: waylandOnShellGlobal
            global_remove: waylandOnGlobalRemove
        }
        let ignoredShellListener =
            kira_wayland_registry_add_listener(shellRegistry, move shellRegistryListener, nullPointer())

        // Everything the compositor offers arrives as events, so nothing is
        // bound until they have all been delivered.
        let ignoredRoundtrip = kira_wayland_display_roundtrip(display)

        let compositor = kira_wayland_proxy_get_user_data(registry)
        let shell = kira_wayland_proxy_get_user_data(shellRegistry)
        if pointerIsNull(compositor) || pointerIsNull(shell) {
            graphicsDiagnostic(
                "Kira Graphics: this Wayland compositor offers no wl_compositor or no \
                 xdg_wm_base, and a window needs both"
            )
            kira_wayland_proxy_destroy(registry)
            kira_wayland_display_disconnect(display)
            return nullPointer()
        }

        var shellListener = kira_wayland_shell_listener { ping: waylandOnPing }
        let ignoredShell = kira_wayland_shell_add_listener(shell, move shellListener, nullPointer())

        // A surface with no role is not a window. The role is what xdg-shell
        // gives it, in two steps: a surface becomes an xdg_surface, and an
        // xdg_surface becomes a toplevel.
        let surface = kira_wayland_compositor_create_surface(compositor)
        if pointerIsNull(surface) {
            graphicsDiagnostic("Kira Graphics: the Wayland compositor refused a surface")
            kira_wayland_display_disconnect(display)
            return nullPointer()
        }

        let xdgSurface = kira_wayland_shell_get_surface(shell, surface)
        if pointerIsNull(xdgSurface) {
            graphicsDiagnostic("Kira Graphics: xdg_wm_base refused a surface role")
            kira_wayland_display_disconnect(display)
            return nullPointer()
        }

        var configureListener = kira_wayland_surface_listener { configure: waylandOnConfigure }
        let ignoredConfigure = kira_wayland_surface_add_listener(xdgSurface, move configureListener, nullPointer())

        let toplevel = kira_wayland_surface_get_toplevel(xdgSurface)
        if pointerIsNull(toplevel) {
            graphicsDiagnostic("Kira Graphics: xdg_surface refused a toplevel")
            kira_wayland_display_disconnect(display)
            return nullPointer()
        }
        // The runtime state does not exist at open time. Keep the role on the
        // wl_surface until input attachment can install the configure listener
        // with that state as its callback data.
        kira_wayland_proxy_set_user_data(surface, toplevel)

        // Identity. A window with no app id is a window a shell has nothing to
        // match on -- no icon, no grouping, and nothing for an extension that
        // styles windows by who they belong to.
        kira_wayland_toplevel_set_app_id(toplevel, "dev.kira.HarmonyBrowser")

        kira_wayland_toplevel_set_title(toplevel, title)

        // The size the compositor was asked for, remembered so the client area
        // can be reported before any configure has been read. Without it the
        // window answers zero, `dawnResizeIfNeeded` returns early on every
        // frame, and Foundation is never told a viewport -- which renders
        // correctly, because that path takes the swapchain's size, and hit-tests
        // nothing, because that path takes this one.
        kira_wayland_surface_note_size(surface, I32(width), I32(height))

        // The initial empty commit is deferred to dawnWaylandAttachInput. That
        // is the first point carrying the runtime state the toplevel configure
        // listener needs, and installing it after this commit would miss the
        // size chosen by the compositor.

        return surface
    }

    // A Wayland surface is told its size by the compositor rather than asked,
    // and the size it was told arrives in a configure. Until the pump is ported
    // and those events are read, the size the caller asked for is the size it
    // gets -- which is what the compositor was asked for too, and what `open`
    // noted beside the surface.
    function clientWidth(window: RawPtr) -> Int { return Int(kira_wayland_surface_width(window)) }
    function clientHeight(window: RawPtr) -> Int { return Int(kira_wayland_surface_height(window)) }

    // A surface learns its scale from the output it is shown on, through an
    // event. 1.0 is what an unscaled surface reads.
    function scale(window: RawPtr) -> Float { return 1.0 }

    // A client does not resize its own surface: it acknowledges a configure and
    // draws at the size that carried. This becomes that acknowledgement.
    function resize(window: RawPtr, width: Int, height: Int) {
        return
    }

    function createSurface(instance: RawPtr, window: RawPtr) -> RawPtr {
        return wgpuInstanceCreateSurface(instance, WGPUSurfaceDescriptor {
            nextInChain: WGPUSurfaceSourceWaylandSurface {
                chain: WGPUChainedStruct { sType: dawnStructureWaylandSurface() }
                display: kira_wayland_proxy_get_display(window)
                surface: window
            }
            label: dawnText("kira-graphics-surface")
        })
    }

    function close(window: RawPtr) -> Void {
        kira_wayland_proxy_destroy(window)
        return
    }
}

// One frame's worth of Wayland events.
//
// A Wayland client has no message queue to peek: what it has is a socket. The C
// seam performs prepare-read/poll(0)/read-events/dispatch as one operation, so
// newly arrived motion is decoded without blocking an idle frame or racing a
// packet that arrives between checking pending events and reading the socket.
function dawnPumpWayland(window: RawPtr) {
    if pointerIsNull(window) {
        return
    }
    let display = kira_wayland_proxy_get_display(window)
    if pointerIsNull(display) {
        return
    }
    let ignoredPump = kira_wayland_display_pump(display)
    return
}
