import Foundation
import KiraGraphics
// Metal render Tests. Names use the mtk / Mtk prefix.

construct MtkClearRendersExactColor() extends Test {
    test { return metalSelfTestClearOk() }
    expect { let e: Result<Bool, TestFailure> = Result.Ok(true); return e }
}

construct MtkTriangleRasterizes() extends Test {
    test { return metalSelfTestTriangleOk() }
    expect { let e: Result<Bool, TestFailure> = Result.Ok(true); return e }
}

