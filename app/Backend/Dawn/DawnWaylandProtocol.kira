// Wayland values that are part of the wire protocol rather than the native
// binding. Calls and listener layouts come from `app/bindings/wayland.kira`,
// generated from `NativeLibs/Wayland/kira_wayland.h`.

// A registry event names its interface as a string. The descriptor names and
// the compositor's event bytes have no identity to compare, so use libc's
// value comparison through the runtime already loaded in every process.
@FFI.Extern { library: kira_runtime; symbol: strcmp; abi: c; }
function waylandNameEquals(a: RawPtr, b: CString) -> I32;

// `wl_seat.capabilities`: pointer is bit 0, keyboard bit 1, touch bit 2.
function waylandSeatPointerCapability() -> U32 { return U32(1) }

// Linux input event codes carried by `wl_pointer.button`.
function waylandButtonLeft() -> U32 { return U32(272) }
function waylandButtonRight() -> U32 { return U32(273) }
function waylandButtonMiddle() -> U32 { return U32(274) }
function waylandButtonPressed() -> U32 { return U32(1) }

// `wl_pointer.axis`: vertical is axis 0, horizontal axis 1.
function waylandAxisVertical() -> U32 { return U32(0) }

// `wl_fixed_t` is signed 24.8 fixed point.
function waylandFixedToFloat(value: I32) -> Float {
    return Float(Int(value)) / 256.0
}
