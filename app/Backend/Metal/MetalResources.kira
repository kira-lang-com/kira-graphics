// Metal resource creation and draw encoding, built from Objective-C messages via
// FFI. Shaders, vertex buffers and render pipeline states are created as real
// Metal objects, registered in the context's id->pointer table, and resolved back
// at draw time to encode onto the active render-command encoder.
//
// Shader entry points use the fixed names `v_main` / `f_main`; the supplied MSL
// source is a single library containing both stages. (The KSL pipeline emits
// `{Shader}__vertex__main` / `{Shader}__fragment__main`; wiring those configurable
// names follows once the KSL .metal assets are loaded.)

function metalPrimitiveTriangle() -> U64 { return 3 }
function metalIndexTypeUInt32() -> U64 { return 1 }

// Compile an MSL source library and register it as a shader handle.
@Native
function metalCreateShader(ctx: RawPtr, source: borrow String) -> Int {
    let device = metalMemReadPtr(ctx, metalOffsetDevice())
    let nsstr = metalMsgSendStr(metalObjcGetClass("NSString"), metalSel("stringWithUTF8String:"), source)
    let opts = metalMsgSend(metalMsgSend(metalObjcGetClass("MTLCompileOptions"), metalSel("alloc")), metalSel("init"))
    let errSlot = metalMemAlloc(8)
    metalMemWriteU64(errSlot, 0, 0)
    let library = metalMsgSendPPP(device, metalSel("newLibraryWithSource:options:error:"), nsstr, opts, errSlot)
    // MTLCompileOptions is a +1-owned alloc/init temporary; the compiled library keeps
    // no reference to it, so release it here rather than leaking one per shader.
    metalMsgSendVoid(opts, metalSel("release"))
    // A shader that does not compile leaves a nil library and an NSError nobody
    // was reading. The next thing to fail is the pipeline, reporting only that
    // its vertex function is nil — which says nothing about why. Say why.
    if metalPtrIsNull(library) {
        graphicsDiagnostic("kira-graphics: Metal rejected a shader library")
        let err = metalMemReadPtr(errSlot, 0)
        if !metalPtrIsNull(err) {
            let described = metalMsgSend(err, metalSel("localizedDescription"))
            if !metalPtrIsNull(described) {
                let utf8 = metalMsgSend(described, metalSel("UTF8String"))
                if !metalPtrIsNull(utf8) {
                    metalPutsRaw(utf8)
                }
            }
        }
    }
    let id = metalRegister(ctx, library)
    metalMemFree(errSlot)
    return id
}

// Upload float vertex data into a new MTLBuffer and register it. Kira `Float` is a
// double; the values are narrowed to 32-bit floats (the GPU vertex format) by the
// F32 store at the FFI boundary.
@Native
function metalCreateVertexBuffer(ctx: RawPtr, data: borrow [Float]) -> Int {
    let device = metalMemReadPtr(ctx, metalOffsetDevice())
    let count = data.count
    let bytes = metalMemAlloc(count * 4)
    var i = 0
    while i < count {
        metalMemWriteF32(bytes, i * 4, data[i])
        i = i + 1
    }
    let buffer = metalMsgSendNewBuffer(device, metalSel("newBufferWithBytes:length:options:"), bytes, count * 4, 0)
    let id = metalRegister(ctx, buffer)
    metalMemFree(bytes)
    return id
}

// Upload integer index data into a new MTLBuffer as uint32 indices and register it.
@Native
function metalCreateIndexBuffer(ctx: RawPtr, data: borrow [Int]) -> Int {
    let device = metalMemReadPtr(ctx, metalOffsetDevice())
    let count = data.count
    let bytes = metalMemAlloc(count * 4)
    var i = 0
    while i < count {
        metalMemWriteU32(bytes, i * 4, data[i])
        i = i + 1
    }
    let buffer = metalMsgSendNewBuffer(device, metalSel("newBufferWithBytes:length:options:"), bytes, count * 4, 0)
    let id = metalRegister(ctx, buffer)
    metalMemFree(bytes)
    return id
}

// MTLBlendFactor / MTLBlendOperation constants used by the premultiplied-alpha
// compositing path (UI). Premultiplied: srcRGB*One + dstRGB*(1-srcA).
function metalBlendFactorOne() -> U64 { return 1 }
function metalBlendFactorOneMinusSourceAlpha() -> U64 { return 5 }
function metalBlendOperationAdd() -> U64 { return 0 }

// Build an MTLRenderPipelineState from a shader library and a color pixel format,
// and register it.
@Native
function metalCreateRenderPipeline(ctx: RawPtr, shaderId: Int, colorFormat: U64, depthEnabled: Bool) -> Int {
    return metalCreateRenderPipelineBlended(ctx, shaderId, colorFormat, depthEnabled, false)
}

// Build an MTLRenderPipelineState, optionally enabling premultiplied-alpha blending
// on color attachment 0 (the UI compositor draws translucent, premultiplied quads).
@Native
function metalCreateRenderPipelineBlended(ctx: RawPtr, shaderId: Int, colorFormat: U64, depthEnabled: Bool, blendEnabled: Bool) -> Int {
    var noFmt: [Int] = []
    var noOff: [Int] = []
    return metalCreateRenderPipelineWithEntries(ctx, shaderId, colorFormat, depthEnabled, blendEnabled, "v_main", "f_main", 0, noFmt, noOff)
}

// Map a KiraGraphics vertex format (Constants.kira) to an MTLVertexFormat raw value.
function metalVertexFormat(kiraFormat: Int) -> U64 {
    if kiraFormat == 1 { return 29 }   // Float2 -> MTLVertexFormatFloat2
    if kiraFormat == 2 { return 30 }   // Float3 -> MTLVertexFormatFloat3
    if kiraFormat == 3 { return 31 }   // Float4 -> MTLVertexFormatFloat4
    return 28                          // Float
}

// As above, with configurable entry-point names AND a vertex layout. KSL-compiled
// shaders use `[[stage_in]]` inputs, which REQUIRE an MTLVertexDescriptor on the
// pipeline (entries `{shader}__vertex__main` / `__fragment__main`). Buffer-indexing
// shaders (self-tests, UI) pass an empty layout and skip the descriptor.
@Native
function metalCreateRenderPipelineWithEntries(ctx: RawPtr, shaderId: Int, colorFormat: U64, depthEnabled: Bool, blendEnabled: Bool, vertexEntry: borrow String, fragmentEntry: borrow String, stride: Int, attrFormats: borrow [Int], attrOffsets: borrow [Int]) -> Int {
    let device = metalMemReadPtr(ctx, metalOffsetDevice())
    let library = metalLookup(ctx, shaderId)
    let vname = metalMsgSendStr(metalObjcGetClass("NSString"), metalSel("stringWithUTF8String:"), vertexEntry)
    let fname = metalMsgSendStr(metalObjcGetClass("NSString"), metalSel("stringWithUTF8String:"), fragmentEntry)
    let vfn = metalMsgSendP(library, metalSel("newFunctionWithName:"), vname)
    let ffn = metalMsgSendP(library, metalSel("newFunctionWithName:"), fname)

    let desc = metalMsgSend(metalMsgSend(metalObjcGetClass("MTLRenderPipelineDescriptor"), metalSel("alloc")), metalSel("init"))
    metalMsgSendVoidP(desc, metalSel("setVertexFunction:"), vfn)
    metalMsgSendVoidP(desc, metalSel("setFragmentFunction:"), ffn)

    // Build an MTLVertexDescriptor for [[stage_in]] shaders.
    if attrFormats.count > 0 {
        let vd = metalMsgSend(metalObjcGetClass("MTLVertexDescriptor"), metalSel("vertexDescriptor"))
        let attrs = metalMsgSend(vd, metalSel("attributes"))
        var ai = 0
        while ai < attrFormats.count {
            let attr = metalMsgSendPU(attrs, metalSel("objectAtIndexedSubscript:"), U64(ai))
            metalMsgSendVoidU(attr, metalSel("setFormat:"), metalVertexFormat(attrFormats[ai]))
            metalMsgSendVoidU(attr, metalSel("setOffset:"), U64(attrOffsets[ai]))
            metalMsgSendVoidU(attr, metalSel("setBufferIndex:"), 0)
            ai = ai + 1
        }
        let layouts = metalMsgSend(vd, metalSel("layouts"))
        let layout0 = metalMsgSendPU(layouts, metalSel("objectAtIndexedSubscript:"), 0)
        metalMsgSendVoidU(layout0, metalSel("setStride:"), U64(stride))
        metalMsgSendVoidU(layout0, metalSel("setStepFunction:"), 1)   // MTLVertexStepFunctionPerVertex
        metalMsgSendVoidP(desc, metalSel("setVertexDescriptor:"), vd)
    }

    let colorAttachment = metalMsgSendPU(metalMsgSend(desc, metalSel("colorAttachments")), metalSel("objectAtIndexedSubscript:"), 0)
    metalMsgSendVoidU(colorAttachment, metalSel("setPixelFormat:"), colorFormat)
    if blendEnabled {
        metalMsgSendVoidB(colorAttachment, metalSel("setBlendingEnabled:"), true)
        metalMsgSendVoidU(colorAttachment, metalSel("setRgbBlendOperation:"), metalBlendOperationAdd())
        metalMsgSendVoidU(colorAttachment, metalSel("setAlphaBlendOperation:"), metalBlendOperationAdd())
        metalMsgSendVoidU(colorAttachment, metalSel("setSourceRGBBlendFactor:"), metalBlendFactorOne())
        metalMsgSendVoidU(colorAttachment, metalSel("setSourceAlphaBlendFactor:"), metalBlendFactorOne())
        metalMsgSendVoidU(colorAttachment, metalSel("setDestinationRGBBlendFactor:"), metalBlendFactorOneMinusSourceAlpha())
        metalMsgSendVoidU(colorAttachment, metalSel("setDestinationAlphaBlendFactor:"), metalBlendFactorOneMinusSourceAlpha())
    }
    if depthEnabled {
        metalMsgSendVoidU(desc, metalSel("setDepthAttachmentPixelFormat:"), metalPixelFormatDepth32Float())
    }

    let errSlot = metalMemAlloc(8)
    metalMemWriteU64(errSlot, 0, 0)
    let pipeline = metalMsgSendPP(device, metalSel("newRenderPipelineStateWithDescriptor:error:"), desc, errSlot)
    // vfn/ffn (newFunctionWithName:) and desc (alloc/init) are +1-owned transients: the
    // compiled pipeline state retains what it needs, so release them here to avoid
    // leaking one MTLFunction pair and one MTLRenderPipelineDescriptor per pipeline.
    metalMsgSendVoid(vfn, metalSel("release"))
    metalMsgSendVoid(ffn, metalSel("release"))
    metalMsgSendVoid(desc, metalSel("release"))
    let id = metalRegister(ctx, pipeline)
    metalMemFree(errSlot)
    return id
}

// Create a persistent, CPU-writable MTLBuffer for `floatCount` f32 slots and register
// it. The UI compositor allocates one of these per frame-stream and rewrites its
// shared contents every frame (no per-frame buffer churn), binding it as the vertex
// buffer at slot 0 — so, like a uniform, it holds a whole RING and each frame writes
// its own slot (MetalPacing.kira). Without that, the frame being written and a frame
// still on the GPU share the same vertices, and the window shows part of each.
@Native
function metalCreateDynamicBuffer(ctx: RawPtr, floatCount: Int) -> Int {
    let device = metalMemReadPtr(ctx, metalOffsetDevice())
    let byteCount = U64(floatCount) * U64(4)
    let buffer = metalMsgSendNewBufferLength(device, metalSel("newBufferWithLength:options:"), metalRingBytes(byteCount), 0)
    let id = metalRegister(ctx, buffer)
    metalRingInit(ctx, U64(id), metalRingSlotStride(byteCount))
    return id
}

// The CPU-visible base of a dynamic buffer's whole ring. Stable for the buffer's
// lifetime, so a caller may still fetch it once — but every write through it must be
// offset by this frame's slot (metalDynamicBufferFrameStart), or it lands in the slot
// the GPU is reading. The pointer is the base rather than the current slot precisely
// so that a stale cached copy cannot silently mean the wrong slot.
@Native
function metalDynamicBufferContents(ctx: RawPtr, bufferId: Int) -> RawPtr {
    let buffer = metalLookup(ctx, bufferId)
    return metalMsgSend(buffer, metalSel("contents"))
}

// Claim this frame's slot and return the byte offset every write this frame adds to
// its own. The frame still on the GPU keeps the slot it was recorded with, so writes
// past this offset cannot disturb it.
@Native
function metalDynamicBufferFrameStart(ctx: RawPtr, bufferId: Int) -> Int {
    return Int(metalRingAdvance(ctx, U64(bufferId)))
}

// Overwrite the first `data.count` f32 slots of a dynamic buffer, in this frame's
// ring slot.
@Native
function metalUpdateDynamicBuffer(ctx: RawPtr, bufferId: Int, data: borrow [Float]) {
    let buffer = metalLookup(ctx, bufferId)
    let contents = metalMsgSend(buffer, metalSel("contents"))
    let base = Int(metalRingAdvance(ctx, U64(bufferId)))
    var i = 0
    while i < data.count {
        metalMemWriteF32(contents, base + i * 4, data[i])
        i = i + 1
    }
    return
}

// Create a CPU-writable uniform MTLBuffer for `floatCount` floats and register it.
// The buffer holds a whole RING of the uniform (see MetalPacing.kira): the CPU
// writes the next frame's values while the GPU is still reading the last frame's,
// so each frame needs its own slot rather than a shared set of bytes.
@Native
function metalCreateUniform(ctx: RawPtr, floatCount: Int) -> Int {
    let device = metalMemReadPtr(ctx, metalOffsetDevice())
    let byteCount = U64(floatCount) * U64(4)
    let buffer = metalMsgSendNewBufferLength(device, metalSel("newBufferWithLength:options:"), metalRingBytes(byteCount), 0)
    let id = metalRegister(ctx, buffer)
    metalRingInit(ctx, U64(id), metalRingSlotStride(byteCount))
    return id
}

// Upload float uniform data into the uniform's NEXT ring slot, which becomes the
// offset every later bind of this uniform reads from. The slot the previous frame
// bound is left untouched, so a frame still on the GPU keeps the values it was
// drawn with.
@Native
function metalUpdateUniform(ctx: RawPtr, uniformId: Int, data: borrow [Float]) {
    metalRaceProbeUniformWrite(ctx)
    let buffer = metalLookup(ctx, uniformId)
    let contents = metalMsgSend(buffer, metalSel("contents"))
    let base = Int(metalRingAdvance(ctx, U64(uniformId)))
    var i = 0
    while i < data.count {
        metalMemWriteF32(contents, base + i * 4, data[i])
        i = i + 1
    }
    return
}

// Bind a uniform buffer to a fragment-shader buffer slot on the active encoder, at
// the ring slot its most recent write went to.
@Native
function metalEncoderBindFragmentUniform(ctx: RawPtr, uniformId: Int, index: Int) {
    let encoder = metalMemReadPtr(ctx, metalOffsetEncoder())
    let buffer = metalLookup(ctx, uniformId)
    let offset = metalRingOffset(ctx, U64(uniformId))
    metalMsgSendSetFragmentBuffer(encoder, metalSel("setFragmentBuffer:offset:atIndex:"), buffer, offset, index)
    return
}

// Encode a non-indexed draw on the active render-command encoder: bind the pipeline
// state, the vertex buffer (slot 0), then draw `vertexCount` triangle vertices.
@Native
function metalEncoderDraw(ctx: RawPtr, pipelineId: Int, vertexBufferId: Int, hasVertexBuffer: Bool, vertexCount: Int, instanceCount: Int) {
    let encoder = metalMemReadPtr(ctx, metalOffsetEncoder())
    let pipeline = metalLookup(ctx, pipelineId)
    metalMsgSendVoidP(encoder, metalSel("setRenderPipelineState:"), pipeline)
    if hasVertexBuffer {
        let buffer = metalLookup(ctx, vertexBufferId)
        metalMsgSendSetVertexBuffer(encoder, metalSel("setVertexBuffer:offset:atIndex:"), buffer, metalRingOffset(ctx, U64(vertexBufferId)), 0)
    }
    metalContextCountDraw(ctx, (vertexCount / 3) * instanceCount)
    if instanceCount > 1 {
        metalMsgSendDrawPrimitivesInstanced(encoder, metalSel("drawPrimitives:vertexStart:vertexCount:instanceCount:"), metalPrimitiveTriangle(), 0, vertexCount, instanceCount)
        return
    }
    metalMsgSendDrawPrimitives(encoder, metalSel("drawPrimitives:vertexStart:vertexCount:"), metalPrimitiveTriangle(), 0, vertexCount)
    return
}

// Encode an INDIRECT draw: bind pipeline + vertex buffer, then let the GPU read
// the draw arguments (vertexCount/instanceCount/...) from a compute-written
// argument buffer — the CPU never learns the count (GPU-driven rendering).
@Native
function metalEncoderDrawIndirect(ctx: RawPtr, pipelineId: Int, vertexBufferId: Int, hasVertexBuffer: Bool, indirectBufferId: Int) {
    let encoder = metalMemReadPtr(ctx, metalOffsetEncoder())
    let pipeline = metalLookup(ctx, pipelineId)
    metalMsgSendVoidP(encoder, metalSel("setRenderPipelineState:"), pipeline)
    if hasVertexBuffer {
        let buffer = metalLookup(ctx, vertexBufferId)
        metalMsgSendSetVertexBuffer(encoder, metalSel("setVertexBuffer:offset:atIndex:"), buffer, metalRingOffset(ctx, U64(vertexBufferId)), 0)
    }
    let indirect = metalLookup(ctx, indirectBufferId)
    metalContextCountDraw(ctx, 0)
    metalMsgSendDrawPrimitivesIndirect(encoder, metalSel("drawPrimitives:indirectBuffer:indirectBufferOffset:"), metalPrimitiveTriangle(), indirect, 0)
    return
}

// Encode an indexed draw: bind the pipeline state and vertex buffer, then draw
// `indexCount` triangle indices (uint32) from the index buffer.
@Native
function metalEncoderDrawIndexed(ctx: RawPtr, pipelineId: Int, vertexBufferId: Int, hasVertexBuffer: Bool, indexBufferId: Int, indexCount: Int, instanceCount: Int) {
    metalEncoderDrawIndexedRange(ctx, pipelineId, vertexBufferId, hasVertexBuffer, indexBufferId, indexCount, instanceCount, 0)
    return
}

@Native
function metalEncoderDrawIndexedRange(ctx: RawPtr, pipelineId: Int, vertexBufferId: Int, hasVertexBuffer: Bool, indexBufferId: Int, indexCount: Int, instanceCount: Int, firstIndex: Int) {
    let encoder = metalMemReadPtr(ctx, metalOffsetEncoder())
    let pipeline = metalLookup(ctx, pipelineId)
    metalMsgSendVoidP(encoder, metalSel("setRenderPipelineState:"), pipeline)
    if hasVertexBuffer {
        let buffer = metalLookup(ctx, vertexBufferId)
        metalMsgSendSetVertexBuffer(encoder, metalSel("setVertexBuffer:offset:atIndex:"), buffer, metalRingOffset(ctx, U64(vertexBufferId)), 0)
    }
    let indexBuffer = metalLookup(ctx, indexBufferId)
    metalContextCountDraw(ctx, (indexCount / 3) * instanceCount)
    metalMsgSendDrawIndexed(encoder, metalSel("drawIndexedPrimitives:indexCount:indexType:indexBuffer:indexBufferOffset:"), metalPrimitiveTriangle(), indexCount, metalIndexTypeUInt32(), indexBuffer, firstIndex * 4)
    return
}

// MTLScissorRect is four NSUIntegers (32 bytes), passed indirectly on arm64 just
// like MTLRegion. Limit fill work without changing vertex coordinates or UVs.
@Native
function metalEncoderSetScissorRect(ctx: RawPtr, x: Int, y: Int, width: Int, height: Int) {
    let encoder = metalMemReadPtr(ctx, metalOffsetEncoder())
    if metalPtrIsNull(encoder) || width <= 0 || height <= 0 {
        return
    }
    let rect = metalMemAlloc(32)
    metalMemWriteU64(rect, 0, x)
    metalMemWriteU64(rect, 8, y)
    metalMemWriteU64(rect, 16, width)
    metalMemWriteU64(rect, 24, height)
    metalMsgSendVoidP(encoder, metalSel("setScissorRect:"), rect)
    metalMemFree(rect)
    return
}
