// Metal texture and sampler resources, built from Objective-C messages via FFI and
// registered in the context's id->pointer table.

function metalPixelFormatRGBA8Unorm() -> U64 { return 70 }
function metalTextureUsageShaderRead() -> U64 { return 1 }
function metalSamplerFilterNearest() -> U64 { return 0 }
function metalSamplerFilterLinear() -> U64 { return 1 }
function metalSamplerAddressClampToEdge() -> U64 { return 0 }

// Create an RGBA8 sampled texture (shared storage so pixels can be uploaded from
// the CPU) and register it.
@Native
function metalCreateTexture(ctx: RawPtr, width: Int, height: Int) -> Int {
    let device = metalMemReadPtr(ctx, metalOffsetDevice())
    let descClass = metalObjcGetClass("MTLTextureDescriptor")
    let desc = metalMsgSendTexDesc(descClass, metalSel("texture2DDescriptorWithPixelFormat:width:height:mipmapped:"), metalPixelFormatRGBA8Unorm(), width, height, false)
    metalMsgSendVoidU(desc, metalSel("setUsage:"), metalTextureUsageShaderRead())
    metalMsgSendVoidU(desc, metalSel("setStorageMode:"), metalStorageModeShared())
    let texture = metalMsgSendP(device, metalSel("newTextureWithDescriptor:"), desc)
    return metalRegister(ctx, texture)
}

// The `GraphicsTexture` the public API hands back, so a caller never learns
// which backend minted the id. Metal has one object where sokol has an image
// and separate views onto it, so the view fields repeat the texture rather than
// sit at zero: code that reads `viewId` gets something that works on both.
@Native
function metalGraphicsTexture(textureId: Int) -> GraphicsTexture {
    let id = U32(textureId)
    return GraphicsTexture {
        id: id
        viewId: id
        colorViewId: id
        depthViewId: id
        storageViewId: id
    }
}

// Render-target-capable and sampled, in the requested format — what a
// multi-pass renderer needs, e.g. the deferred-resolve visibility texture.
@Native
function metalCreateGraphicsTexture(ctx: RawPtr, descriptor: borrow TextureDescriptor) -> TextureResult {
    return metalTextureResult(metalCreateColorTargetTexture(
        ctx,
        descriptor.width,
        descriptor.height,
        metalPixelFormatForTexture(textureFormatCode(descriptor.format)),
        attachmentStorageCode(descriptor.storage)
    ), descriptor.width, descriptor.height)
}

// A Metal id as an outcome: zero is the device declining, which is the only way
// this path fails — the format and extent were already checked by the caller.
//
// The extent travels with the texture, as it does on the other backend: a pass
// sized to this target, a managed depth buffer matched to it and a whole-image
// upload into it all need the numbers, and asking Metal for them later means an
// Objective-C round trip for something the caller just said.
@Native
function metalTextureResult(textureId: Int, width: Int, height: Int) -> TextureResult {
    if textureId == 0 {
        return .Error(.DeviceRefused)
    }
    var texture = metalGraphicsTexture(textureId)
    texture.width = width
    texture.height = height
    return .Ok(move texture)
}

// Create a sampled texture and give it its pixels.
//
// The upload needs the CPU-writable linear rows a shared-storage texture has,
// and every later sample would keep paying for that layout — so one blit
// re-tiles it afterwards, which is the right trade for contents loaded once.
@Native
function metalCreateGraphicsTextureFromPixels(ctx: RawPtr, descriptor: borrow TextureDescriptor, pixels: borrow [U8]) -> TextureResult {
    let textureId = metalCreateTexture(ctx, descriptor.width, descriptor.height)
    if textureId == 0 {
        return .Error(.DeviceRefused)
    }
    metalUpdateTexture(ctx, textureId, descriptor.width, descriptor.height, pixels)
    metalOptimizeTextureForGpu(ctx, textureId)
    var texture = metalGraphicsTexture(textureId)
    texture.width = descriptor.width
    texture.height = descriptor.height
    return .Ok(move texture)
}

// Replace a texture's pixels, leaving it CPU-writable for the next write.
//
// No re-tiling here, unlike the create path: a texture being updated is one
// that will be updated again — a glyph atlas — and optimizing it would undo the
// linear layout the next upload needs.
@Native
function metalUpdateGraphicsTexture(ctx: RawPtr, texture: borrow GraphicsTexture, width: Int, height: Int, pixels: borrow [U8]) {
    metalUpdateTexture(ctx, Int(texture.id), width, height, pixels)
    return
}

// Upload RGBA8 pixel bytes (row-major, 4 bytes/pixel) into a texture region.
@Native
function metalUpdateTexture(ctx: RawPtr, textureId: Int, width: Int, height: Int, data: borrow [U8]) {
    let texture = metalLookup(ctx, textureId)
    let count = data.count
    let bytes = metalMemAlloc(count)
    var i = 0
    while i < count {
        metalMemWriteU8(bytes, i, data[i])
        i = i + 1
    }
    let region = metalMemAlloc(48)
    metalMemWriteU64(region, 0, 0)
    metalMemWriteU64(region, 8, 0)
    metalMemWriteU64(region, 16, 0)
    metalMemWriteU64(region, 24, width)
    metalMemWriteU64(region, 32, height)
    metalMemWriteU64(region, 40, 1)
    metalMsgSendReplaceRegion(texture, metalSel("replaceRegion:mipmapLevel:withBytes:bytesPerRow:"), region, 0, bytes, width * 4)
    metalMemFree(bytes)
    metalMemFree(region)
    return
}

// Replace a texture's contents from raw memory the caller already owns.
//
// The bytes go straight to `replaceRegion:` — nothing is staged, because the
// caller's block is already C storage. That is the whole reason the API takes a
// pointer rather than a Kira array: the one texture written this way is a glyph
// atlas, whose CPU side has to exist anyway so a new glyph can be packed beside
// the old ones, and copying it into an array to hand it back would cost a
// megabyte-scale loop on every frame that adds a glyph.
@Native
function metalUpdateTextureBytes(ctx: RawPtr, textureId: Int, width: Int, height: Int, bytes: RawPtr, byteCount: Int) {
    if textureId == 0 || byteCount <= 0 || width <= 0 || height <= 0 {
        return
    }
    let texture = metalLookup(ctx, textureId)
    let region = metalMemAlloc(48)
    metalMemWriteU64(region, 0, 0)
    metalMemWriteU64(region, 8, 0)
    metalMemWriteU64(region, 16, 0)
    metalMemWriteU64(region, 24, width)
    metalMemWriteU64(region, 32, height)
    metalMemWriteU64(region, 40, 1)
    metalMsgSendReplaceRegion(texture, metalSel("replaceRegion:mipmapLevel:withBytes:bytesPerRow:"), region, 0, bytes, width * 4)
    metalMemFree(region)
    return
}

// Re-tile a sampled texture's contents into the GPU-optimal layout. A
// shared-storage texture keeps the CPU-writable linear rows `replaceRegion:`
// needs, and every sample of it pays for that layout. After the last CPU
// upload, one blit pass lets Metal re-lay the pixels out (and losslessly
// compress them on Apple GPUs). One-shot and synchronous, so a caller can
// treat the upload as complete when this returns; wrong for textures that
// keep taking CPU writes, like the glyph atlas.
@Native
function metalOptimizeTextureForGpu(ctx: RawPtr, textureId: Int) {
    let texture = metalLookup(ctx, textureId)
    let queue = metalMemReadPtr(ctx, metalOffsetQueue())
    let commandBuffer = metalMsgSend(queue, metalSel("commandBuffer"))
    let blit = metalMsgSend(commandBuffer, metalSel("blitCommandEncoder"))
    metalMsgSendVoidP(blit, metalSel("optimizeContentsForGPUAccess:"), texture)
    metalMsgSendVoid(blit, metalSel("endEncoding"))
    metalMsgSendVoid(commandBuffer, metalSel("commit"))
    metalMsgSendVoid(commandBuffer, metalSel("waitUntilCompleted"))
    return
}

// As metalOptimizeTextureForGpu, but encoded on the FRAME's active command
// buffer, ordered after whatever the frame already encoded — the shape a
// mid-frame producer (the blur compute) needs, where a separate committed
// buffer would race the uncommitted writes it must follow.
@Native
function metalContextOptimizeTextureInFrame(ctx: RawPtr, textureId: Int) {
    let commandBuffer = metalContextActiveCommandBuffer(ctx)
    let blit = metalMsgSend(commandBuffer, metalSel("blitCommandEncoder"))
    metalMsgSendVoidP(blit, metalSel("optimizeContentsForGPUAccess:"), metalLookup(ctx, textureId))
    metalMsgSendVoid(blit, metalSel("endEncoding"))
    return
}

// Create an MTLSamplerState with the given min/mag filters and address mode.
@Native
function metalCreateSampler(ctx: RawPtr, minFilter: U64, magFilter: U64, addressMode: U64) -> Int {
    let device = metalMemReadPtr(ctx, metalOffsetDevice())
    let descClass = metalObjcGetClass("MTLSamplerDescriptor")
    let desc = metalMsgSend(metalMsgSend(descClass, metalSel("alloc")), metalSel("init"))
    metalMsgSendVoidU(desc, metalSel("setMinFilter:"), minFilter)
    metalMsgSendVoidU(desc, metalSel("setMagFilter:"), magFilter)
    metalMsgSendVoidU(desc, metalSel("setSAddressMode:"), addressMode)
    metalMsgSendVoidU(desc, metalSel("setTAddressMode:"), addressMode)
    let sampler = metalMsgSendP(device, metalSel("newSamplerStateWithDescriptor:"), desc)
    // The descriptor is a +1-owned alloc/init temporary; the sampler state does not
    // retain it, so release it here rather than leaking one per sampler.
    metalMsgSendVoid(desc, metalSel("release"))
    return metalRegister(ctx, sampler)
}

// Bind a texture / sampler to a fragment-shader slot on the active encoder.
@Native
function metalEncoderBindFragmentTexture(ctx: RawPtr, textureId: Int, index: Int) {
    let encoder = metalMemReadPtr(ctx, metalOffsetEncoder())
    let texture = metalLookup(ctx, textureId)
    metalMsgSendVoidPU(encoder, metalSel("setFragmentTexture:atIndex:"), texture, index)
    return
}

@Native
function metalEncoderBindFragmentSampler(ctx: RawPtr, samplerId: Int, index: Int) {
    let encoder = metalMemReadPtr(ctx, metalOffsetEncoder())
    let sampler = metalLookup(ctx, samplerId)
    metalMsgSendVoidPU(encoder, metalSel("setFragmentSamplerState:atIndex:"), sampler, index)
    return
}
