class Graphics {
    var userData: RawPtr
    var backend: GraphicsBackend = GraphicsBackend.Sokol
    var metalContext: RawPtr

    function createShader(descriptor: borrow ShaderDescriptor) -> GraphicsShader {
        if self.backend == GraphicsBackend.Metal {
            let metalShaderId = metalCreateShader(self.metalContext, descriptor.vertexSource)
            return GraphicsShader {
                handle: BackendShaderHandle {
                    id: metalShaderId
                }
                id: metalShaderId
            }
        }
        let shaderId = sokolCreateShaderId(descriptor.label, descriptor.vertexSource, descriptor.fragmentSource, descriptor.vertexPath, descriptor.fragmentPath)
        return GraphicsShader {
            handle: BackendShaderHandle {
                id: shaderId
            }
            id: shaderId
        }
    }

    function createShaderFromKsl(descriptor: borrow KslShaderDescriptor) -> GraphicsShader {
        let shaderId = sokolCreateShaderFromKslId(descriptor.label, descriptor.asset, descriptor.directory)
        return GraphicsShader {
            handle: BackendShaderHandle {
                id: shaderId
            }
            id: shaderId
        }
    }

    function destroyShader(shader: GraphicsShader) {
        sokolDestroyShaderId(shader.id)
        return
    }

    function createRenderPipeline(descriptor: borrow RenderPipelineDescriptor) -> RenderPipeline {
        if self.backend == GraphicsBackend.Metal {
            var blendEnabled = false
            if descriptor.colorTargets.count > 0 {
                blendEnabled = descriptor.colorTargets[0].blend.enabled
            }
            let metalPipelineId = metalCreateRenderPipelineBlended(self.metalContext, descriptor.shader.id, metalPixelFormatBGRA8Unorm(), descriptor.depthStencil.depthEnabled, blendEnabled)
            return RenderPipeline {
                handle: BackendPipelineHandle {
                    id: metalPipelineId
                }
                id: metalPipelineId
            }
        }
        return sokolCreateRenderPipeline(descriptor)
    }

    // A persistent, CPU-writable vertex buffer sized for `floatCapacity` f32 slots.
    // The UI compositor allocates one and rewrites its contents every frame
    // (updateDynamicBuffer), avoiding per-frame buffer churn. Bind it like any
    // vertex buffer through the render encoder.
    function createDynamicBuffer(floatCapacity: Int) -> GraphicsBuffer {
        if self.backend == GraphicsBackend.Metal {
            let id = metalCreateDynamicBuffer(self.metalContext, floatCapacity)
            return GraphicsBuffer {
                handle: BackendBufferHandle {
                    id: id
                }
                id: id
            }
        }
        graphicsDiagnostic("Kira Graphics: createDynamicBuffer is only implemented on the Metal backend")
        return GraphicsBuffer {
            handle: BackendBufferHandle {
                id: 0
            }
            id: 0
        }
    }

    // Overwrite the first data.count f32 slots of a dynamic buffer's contents.
    function updateDynamicBuffer(buffer: borrow GraphicsBuffer, data: borrow [Float]) {
        if self.backend == GraphicsBackend.Metal {
            metalUpdateDynamicBuffer(self.metalContext, buffer.id, data)
            return
        }
        graphicsDiagnostic("Kira Graphics: updateDynamicBuffer is only implemented on the Metal backend")
        return
    }

    // Upload RGBA8 bytes into a sub-region of a texture (the UI glyph atlas blits one
    // rasterized glyph at a time into its packed slot).
    function updateTextureRegion(texture: borrow GraphicsTexture, x: Int, y: Int, width: Int, height: Int, data: borrow [Int]) {
        if self.backend == GraphicsBackend.Metal {
            metalUpdateTextureRegion(self.metalContext, texture.id, x, y, width, height, data)
            return
        }
        graphicsDiagnostic("Kira Graphics: updateTextureRegion is only implemented on the Metal backend")
        return
    }

    function destroyPipeline(pipeline: borrow RenderPipeline) {
        sokolDestroyRenderPipelineId(pipeline.id)
        return
    }

    function destroyRenderPipeline(pipeline: borrow RenderPipeline) {
        destroyPipeline(pipeline)
        return
    }

    function createBuffer(descriptor: borrow BufferDescriptor) -> GraphicsBuffer {
        if self.backend == GraphicsBackend.Metal {
            let metalBufferId = metalCreateVertexBuffer(self.metalContext, descriptor.data)
            return GraphicsBuffer {
                handle: BackendBufferHandle {
                    id: metalBufferId
                }
                id: metalBufferId
            }
        }
        let uploadId = sokolBeginFloatBufferUpload(descriptor.label, descriptor.usage, descriptor.stride, descriptor.data.count)
        var index = 0

        while index < descriptor.data.count {
            sokolSetFloatBufferUploadValue(uploadId, index, descriptor.data[index])
            index = index + 1
        }

        let bufferId = sokolFinalizeFloatBufferUpload(uploadId)
        return GraphicsBuffer {
            handle: BackendBufferHandle {
                id: bufferId
            }
            id: bufferId
        }
    }

    function createIndexBuffer(descriptor: borrow IndexBufferDescriptor) -> GraphicsBuffer {
        if self.backend == GraphicsBackend.Metal {
            let metalIndexId = metalCreateIndexBuffer(self.metalContext, descriptor.data)
            return GraphicsBuffer {
                handle: BackendBufferHandle {
                    id: metalIndexId
                }
                id: metalIndexId
            }
        }
        let uploadId = sokolBeginIndexBufferUpload(descriptor.label, descriptor.usage, descriptor.data.count)
        var index = 0

        while index < descriptor.data.count {
            sokolSetIndexBufferUploadValue(uploadId, index, descriptor.data[index])
            index = index + 1
        }

        let bufferId = sokolFinalizeIndexBufferUpload(uploadId)
        return GraphicsBuffer {
            handle: BackendBufferHandle {
                id: bufferId
            }
            id: bufferId
        }
    }

    function destroyBuffer(buffer: borrow GraphicsBuffer) {
        sokolDestroyBufferId(buffer.id)
        return
    }

    function createUniform(descriptor: borrow UniformDescriptor) -> GraphicsUniform {
        if self.backend == GraphicsBackend.Metal {
            let metalUniformId = metalCreateUniform(self.metalContext, descriptor.expectedFloatCount)
            metalUpdateUniform(self.metalContext, metalUniformId, descriptor.data)
            return GraphicsUniform {
                handle: BackendUniformHandle {
                    id: metalUniformId
                }
                id: metalUniformId
            }
        }
        let uniformId = sokolCreateUniformId(descriptor.label, descriptor.expectedFloatCount)
        let uniform = GraphicsUniform {
            handle: BackendUniformHandle {
                id: uniformId
            }
            id: uniformId
        }
        updateUniform(uniform, descriptor.data)
        return uniform
    }

    function updateUniform(uniform: borrow GraphicsUniform, data: borrow [Float]) {
        if self.backend == GraphicsBackend.Metal {
            metalUpdateUniform(self.metalContext, uniform.id, data)
            return
        }
        updateGraphicsUniform(uniform, data)
        return
    }

    function destroyUniform(uniform: borrow GraphicsUniform) {
        sokolDestroyUniformId(uniform.id)
        return
    }

    function createBindGroup(descriptor: borrow BindGroupDescriptor) -> BindGroup {
        if self.backend == GraphicsBackend.Metal {
            let metalBindGroupId = metalCreateBindGroup(self.metalContext)
            var mi = 0
            while mi < descriptor.uniformEntries.count {
                let uEntry = descriptor.uniformEntries[mi]
                metalBindGroupAddEntry(self.metalContext, metalBindGroupId, metalBindEntryKindUniform(), uEntry.uniformSlot, uEntry.uniform.id)
                mi = mi + 1
            }
            mi = 0
            while mi < descriptor.textureEntries.count {
                let tEntry = descriptor.textureEntries[mi]
                metalBindGroupAddEntry(self.metalContext, metalBindGroupId, metalBindEntryKindTexture(), tEntry.textureSlot, tEntry.texture.id)
                mi = mi + 1
            }
            mi = 0
            while mi < descriptor.samplerEntries.count {
                let sEntry = descriptor.samplerEntries[mi]
                metalBindGroupAddEntry(self.metalContext, metalBindGroupId, metalBindEntryKindSampler(), sEntry.samplerSlot, sEntry.sampler.id)
                mi = mi + 1
            }
            return BindGroup {
                handle: BackendBindGroupHandle {
                    id: metalBindGroupId
                }
                id: metalBindGroupId
            }
        }
        let bindGroupId = sokolCreateBindGroupId(descriptor.label)
        var index = 0
        while index < descriptor.uniformEntries.count {
            let entry = descriptor.uniformEntries[index]
            sokolSetBindGroupUniform(bindGroupId, index, entry.uniformSlot, entry.uniform.id)
            index = index + 1
        }
        index = 0
        while index < descriptor.textureEntries.count {
            let entry = descriptor.textureEntries[index]
            sokolSetBindGroupTexture(bindGroupId, index, entry.textureSlot, entry.texture.id)
            index = index + 1
        }
        index = 0
        while index < descriptor.samplerEntries.count {
            let entry = descriptor.samplerEntries[index]
            sokolSetBindGroupSampler(bindGroupId, index, entry.samplerSlot, entry.sampler.id)
            index = index + 1
        }
        return BindGroup {
            handle: BackendBindGroupHandle {
                id: bindGroupId
            }
            id: bindGroupId
        }
    }

    function createUniformBindGroup(label: borrow String, uniformSlot: Int, uniform: borrow GraphicsUniform) -> BindGroup {
        if self.backend == GraphicsBackend.Metal {
            let metalBindGroupId = metalCreateBindGroup(self.metalContext)
            metalBindGroupAddEntry(self.metalContext, metalBindGroupId, metalBindEntryKindUniform(), uniformSlot, uniform.id)
            return BindGroup {
                handle: BackendBindGroupHandle {
                    id: metalBindGroupId
                }
                id: metalBindGroupId
            }
        }
        let bindGroupId = sokolCreateBindGroupId(label)
        sokolSetBindGroupUniform(bindGroupId, 0, uniformSlot, uniform.id)
        return BindGroup {
            handle: BackendBindGroupHandle {
                id: bindGroupId
            }
            id: bindGroupId
        }
    }

    function createTextureSamplerBindGroup(label: borrow String, textureSlot: Int, texture: borrow GraphicsTexture, samplerSlot: Int, sampler: borrow GraphicsSampler) -> BindGroup {
        if self.backend == GraphicsBackend.Metal {
            let metalBindGroupId = metalCreateBindGroup(self.metalContext)
            metalBindGroupAddEntry(self.metalContext, metalBindGroupId, metalBindEntryKindTexture(), textureSlot, texture.id)
            metalBindGroupAddEntry(self.metalContext, metalBindGroupId, metalBindEntryKindSampler(), samplerSlot, sampler.id)
            return BindGroup {
                handle: BackendBindGroupHandle {
                    id: metalBindGroupId
                }
                id: metalBindGroupId
            }
        }
        let bindGroupId = sokolCreateBindGroupId(label)
        sokolSetBindGroupTexture(bindGroupId, 0, textureSlot, texture.id)
        sokolSetBindGroupSampler(bindGroupId, 0, samplerSlot, sampler.id)
        return BindGroup {
            handle: BackendBindGroupHandle {
                id: bindGroupId
            }
            id: bindGroupId
        }
    }

    function destroyBindGroup(bindGroup: borrow BindGroup) {
        sokolDestroyBindGroupId(bindGroup.id)
        return
    }

    function createTexture(descriptor: borrow TextureDescriptor) -> GraphicsTexture {
        if self.backend == GraphicsBackend.Metal {
            let metalTextureId = metalCreateTexture(self.metalContext, descriptor.width, descriptor.height)
            return GraphicsTexture {
                handle: BackendTextureHandle {
                    id: metalTextureId
                }
                id: metalTextureId
            }
        }
        let textureId = sokolCreateTextureId(
            descriptor.label,
            descriptor.width,
            descriptor.height,
            descriptor.format,
            descriptor.usage,
            descriptor.sampleCount,
            descriptor.storageMode
        )
        return GraphicsTexture {
            handle: BackendTextureHandle {
                id: textureId
            }
            id: textureId
        }
    }

    function destroyTexture(texture: borrow GraphicsTexture) {
        sokolDestroyTextureId(texture.id)
        return
    }

    function createTextureFromFile(label: borrow String, path: borrow String) -> GraphicsTexture {
        let textureId = sokolCreateTextureFromFileId(label, path)
        return GraphicsTexture {
            handle: BackendTextureHandle {
                id: textureId
            }
            id: textureId
        }
    }

    function createSampler(descriptor: borrow SamplerDescriptor) -> GraphicsSampler {
        if self.backend == GraphicsBackend.Metal {
            var metalMin = metalSamplerFilterNearest()
            if descriptor.minFilter == textureFilterLinear() {
                metalMin = metalSamplerFilterLinear()
            }
            var metalMag = metalSamplerFilterNearest()
            if descriptor.magFilter == textureFilterLinear() {
                metalMag = metalSamplerFilterLinear()
            }
            let metalSamplerId = metalCreateSampler(self.metalContext, metalMin, metalMag, metalSamplerAddressClampToEdge())
            return GraphicsSampler {
                handle: BackendSamplerHandle {
                    id: metalSamplerId
                }
                id: metalSamplerId
            }
        }
        let samplerId = sokolCreateSamplerId(
            descriptor.label,
            descriptor.minFilter,
            descriptor.magFilter,
            descriptor.addressModeU,
            descriptor.addressModeV
        )
        return GraphicsSampler {
            handle: BackendSamplerHandle {
                id: samplerId
            }
            id: samplerId
        }
    }

    function destroySampler(sampler: borrow GraphicsSampler) {
        sokolDestroySamplerId(sampler.id)
        return
    }

    @Native
    function runLifetimeStress(iterations: Int, shaderDirectory: borrow String, shaderAsset: borrow String) -> Bool {
        let nativeIterations: I64 = iterations
        return kgRunLifetimeStress(nativeIterations, shaderDirectory, shaderAsset) != 0
    }

    @Native
    function frame() -> GraphicsFrame {
        return GraphicsFrame {
            hasColorAttachment: false
            colorTargetKind: 0
            colorTextureId: 0
            colorMipLevel: 0
            colorArrayLayer: 0
            colorLoadAction: 0
            colorStoreAction: 0
            clearR: 0.0
            clearG: 0.0
            clearB: 0.0
            clearA: 1.0
            hasResolveTarget: false
            resolveTextureId: 0
            resolveMipLevel: 0
            resolveArrayLayer: 0
            hasDepthAttachment: false
            depthTextureId: 0
            depthLoadAction: 0
            depthStoreAction: 0
            clearDepth: 1.0
            depthReadOnly: false
            hasStencilAttachment: false
            stencilTextureId: 0
            stencilLoadAction: 0
            stencilStoreAction: 0
            clearStencil: 0
            stencilReadOnly: false
            encoderPipelineId: 0
            encoderHasPipeline: false
            encoderVertexBufferId: 0
            encoderHasVertexBuffer: false
            encoderIndexBufferId: 0
            encoderHasIndexBuffer: false
            encoderIndexFormat: indexFormatUint32()
            encoderVertexCount: 0
            encoderIndexCount: 0
            encoderInstanceCount: 1
            hasRenderPass: false
            renderPassActive: false
            currentEncoder: makeRenderEncoder()
            shouldPresent: false
            passSubmitted: false
            shouldQuit: false
            userData: self.userData
            backend: self.backend
            metalContext: self.metalContext
        }
    }
}
