// Metal frame bridge: the seam the public GraphicsFrame dispatches to when its
// backend is Metal. Mirrors the Sokol begin/end/submit contract but submits work
// through the Metal context built from Objective-C messages.

// The public descriptor layer uses Sokol-style load-action constants
// (clear = 1, load = 2, dontCare = 3). Metal's MTLLoadAction values differ
// (clear = 2, load = 1, dontCare = 0), so translate at the boundary.
@Native
function metalMapLoadAction(publicLoadAction: Int) -> U64 {
    if publicLoadAction == 1 {
        return metalLoadActionClear()
    }
    if publicLoadAction == 2 {
        return metalLoadActionLoad()
    }
    return metalLoadActionClear()
}

// Begin the frame's render pass on the Metal context. Today this drives the
// color clear; pipeline/buffer/draw encoding lands in later phases.
@Native
function metalBeginRenderPassFromFrame(frame: borrow GraphicsFrame, ctxPtr: RawPtr) -> Bool {
    let load = metalMapLoadAction(frame.colorLoadAction)
    // A custom texture target (multi-pass rendering) begins a targeted pass; the
    // default swapchain/offscreen target uses the context color texture.
    if frame.colorTargetKind == renderTargetKindTexture() {
        metalContextBeginClearTarget(ctxPtr, Int(frame.colorTextureId), load, frame.clearR, frame.clearG, frame.clearB, frame.clearA, frame.hasDepthAttachment)
    } else {
        metalContextBeginClear(ctxPtr, load, frame.clearR, frame.clearG, frame.clearB, frame.clearA, frame.hasDepthAttachment)
    }
    return true
}

// End the current pass and submit it (offscreen: commit + wait).
@Native
function metalEndPassAndCommit(ctxPtr: RawPtr) {
    metalContextEndAndCommit(ctxPtr)
    return
}

// Frame submission hook. The clear pass already committed in endPass, so this is
// a no-op for the current offscreen path; on-screen presentation will hook here.
@Native
function metalSubmitFrame(frame: borrow GraphicsFrame) {
    return
}

// Headless verification: report the center pixel the GPU actually produced for
// the frame, so an offscreen run proves real Kira-owned rendering (not a marker).
@Native
function metalReportCenterPixel(ctxPtr: RawPtr, width: Int, height: Int) {
    let cx = width / 2
    let cy = height / 2
    let packed = metalContextReadPixel(ctxPtr, cx, cy)
    print(packed)
    return
    // packed is little-endian BGRA: (A<<24)|(R<<16)|(G<<8)|B
}

// Headless verification for spatially-varying output: report two probe pixels at
// the left-quarter and right-quarter columns (screen mid-height). Used to prove a
// pass produces DIFFERENT values in different regions (e.g. a visibility buffer
// carrying distinct per-primitive ids that resolve to distinct materials). Printed
// in addition to the center pixel, so single-value readback assertions are
// unaffected; only callers that opt in (KIRA_METAL_READBACK_POINTS) read these.
@Native
function metalReportProbePixels(ctxPtr: RawPtr, width: Int, height: Int) {
    let my = height / 2
    let left = metalContextReadPixel(ctxPtr, width / 4, my)
    let right = metalContextReadPixel(ctxPtr, (width * 3) / 4, my)
    print(left)
    print(right)
    return
}

// Golden-image report: prints a sentinel (313131) then a deterministic digest of the
// whole framebuffer, so a shell harness can assert pixel-exact stability of the entire
// rendered image. Opt-in (KIRA_METAL_IMAGE_DIGEST); does not affect other readback.
@Native
function metalReportImageDigest(ctxPtr: RawPtr, width: Int, height: Int) {
    let digest = metalContextImageDigest(ctxPtr, width, height)
    print(313131)
    print(digest)
    return
}

// Frame-time benchmark report: prints a sentinel then nanoseconds-per-frame, so a
// shell harness can derive ms/FPS without on-screen present/vsync. Integer-only to
// avoid float/FFI marshalling edge cases.
@Native
function metalReportBench(totalNs: Int, frames: Int) {
    print(424242)
    print(totalNs / frames)
    return
}
