// Metal rendering context, built entirely from Objective-C messages via FFI.
//
// The context owns the device and command queue, the current color target (an
// offscreen texture today; a CAMetalLayer drawable once the host surface lands),
// and the in-flight command buffer + render-command encoder for the active pass.
//
// The context is a small raw heap block whose handle (RawPtr) is threaded across
// the begin/end seam. We deliberately store it as raw memory rather than a Kira
// struct behind `nativeState`: a render pass begins in one `@Native` call and ends
// in another (the public GraphicsFrame splits beginRenderPass/endPass across the
// VM in hybrid mode), and the in-flight encoder/command-buffer pointers must
// survive between those calls identically on the native and hybrid backends. A
// raw block read/written through the kira_runtime pointer helpers gives that
// persistence unconditionally.
//
// Layout (byte offsets into the block):
//   0  device           (id<MTLDevice>)
//   8  queue            (id<MTLCommandQueue>)
//  16  colorTexture     (id<MTLTexture>)
//  24  commandBuffer    (id<MTLCommandBuffer>, per pass)
//  32  encoder          (id<MTLRenderCommandEncoder>, per pass)
//  40  width            (U64)
//  48  height           (U64)
//  56  layer            (CAMetalLayer, null in offscreen mode)
//  64  drawable         (id<CAMetalDrawable>, per pass in layer mode)
//  72  registry         (raw block of resource pointers indexed by handle id)
//  80  nextId           (U64, next resource handle id; id 0 is reserved/invalid)
//  88  depthTexture     (id<MTLTexture>, Depth32Float; null until attached)
//  96  depthState       (id<MTLDepthStencilState>, less + write)
// 104  hostView         (NSView/UIView the layer is attached to; null in offscreen)
// 112  lastFrameNs      (U64 nanoseconds; the previous frame's monotonic clock)
// 120  frameDurationNs  (U64 nanoseconds; the most recent inter-frame delta, for FPS)
// 128  physicalWidth    (U64 backing pixels; width/height stay in points, so
//                        scale = physicalWidth / width — the Retina backing factor)
// 136  registryKinds    (raw block of per-id U8 kind tags parallel to `registry`:
//                        1 = Objective-C object (teardown releases it), 2 = raw
//                        metalMemAlloc block such as a bind group (teardown frees it))
// 144  lockSeeded       (U64; 1 once the locked pointer has an anchor to walk from)
// 152  lockedX          (F64 bits; the virtual pointer's window-space x while locked)
// 160  lockedY          (F64 bits; the virtual pointer's window-space y while locked)
// 168  registryCap      (U64; how many ids the registry blocks currently hold)
// 176  freeId           (U64; head of the freed-id list, 0 when empty — id 0 is
//                        the reserved sentinel, so it can never be a real entry)
function metalContextSize() -> U64 { return 184 }
function metalOffsetDevice() -> U64 { return 0 }
function metalOffsetQueue() -> U64 { return 8 }
function metalOffsetColorTexture() -> U64 { return 16 }
function metalOffsetCommandBuffer() -> U64 { return 24 }
function metalOffsetEncoder() -> U64 { return 32 }
function metalOffsetWidth() -> U64 { return 40 }
function metalOffsetHeight() -> U64 { return 48 }
function metalOffsetLayer() -> U64 { return 56 }
function metalOffsetDrawable() -> U64 { return 64 }
function metalOffsetRegistry() -> U64 { return 72 }
function metalOffsetNextId() -> U64 { return 80 }
function metalOffsetDepthTexture() -> U64 { return 88 }
function metalOffsetDepthState() -> U64 { return 96 }
function metalOffsetHostView() -> U64 { return 104 }
function metalOffsetLastFrameNs() -> U64 { return 112 }
function metalOffsetFrameDurationNs() -> U64 { return 120 }
function metalOffsetPhysicalWidth() -> U64 { return 128 }
function metalOffsetRegistryKinds() -> U64 { return 136 }
function metalOffsetLockSeeded() -> U64 { return 144 }
function metalOffsetLockedX() -> U64 { return 152 }
function metalOffsetLockedY() -> U64 { return 160 }
function metalOffsetRegistryCap() -> U64 { return 168 }
function metalOffsetFreeId() -> U64 { return 176 }

// Registry entry kinds (parallel `registryKinds` table). An entry is either a
// +1-owned Objective-C object (released at teardown) or a raw metalMemAlloc block
// such as a bind group (freed at teardown); the untyped pointer registry cannot
// tell them apart, so the kind is recorded when the handle is registered.
function metalRegistryKindObject() -> U8 { return 1 }
function metalRegistryKindRawBlock() -> U8 { return 2 }
// A slot whose resource was released. Its pointer word holds the next free id
// rather than a resource, so nothing may release or free what it points at.
function metalRegistryKindFree() -> U8 { return 0 }

// Stash the frame's command buffer for the DEFERRED readback wait (the GPU wait was
// moved out of endAndCommit into metalContextReadPixel so offscreen frames pipeline).
// `[queue commandBuffer]` returns an AUTORELEASED buffer, so the enclosing per-frame
// autorelease pool would free it at frame end — before the post-loop readback runs.
// Retain it here (releasing the previous frame's committed buffer) so it survives the
// pool pop; metalContextFree releases the last one.
@Native
function metalStashCommandBuffer(ctx: RawPtr, commandBuffer: RawPtr) {
    let previous = metalMemReadPtr(ctx, metalOffsetCommandBuffer())
    if !metalPtrIsNull(previous) {
        metalMsgSendVoid(previous, metalSel("release"))
    }
    metalMsgSendVoid(commandBuffer, metalSel("retain"))
    metalMemWritePtr(ctx, metalOffsetCommandBuffer(), commandBuffer)
    return
}

// The resource registry maps small integer handle ids (stored as U32 in the public
// handle types) to the Objective-C resource pointers (MTLBuffer / MTLLibrary /
// MTLRenderPipelineState / ...). Ids start at 1 so 0 stays a sentinel, and they are
// never reused — nothing unregisters — so the table has to grow with the scene.
//
// It used to be a fixed 1024 with no bounds check, which is not a limit but a
// silent heap corruption: id 1024 wrote one word past the table and one byte past
// the kinds block, into whatever the allocator had put there. A scene that built
// enough resources — a lot of entities, each with its own buffers — would start
// finding its own data changed underneath it, which reads as geometry shifting
// slightly for no reason.
function metalRegistryInitialCapacity() -> U64 { return 1024 }

// Make room for id `needed`, doubling until it fits.
//
// Copies both parallel blocks and frees the old ones. Growth is amortised, so a
// scene that registers n resources copies O(n) entries in total rather than per
// registration.
function metalRegistryReserve(ctx: RawPtr, needed: U64) {
    let cap = metalMemReadU64(ctx, metalOffsetRegistryCap())
    if needed < cap {
        return
    }
    var grown = cap
    if grown == 0 {
        grown = metalRegistryInitialCapacity()
    }
    while needed >= grown {
        grown = grown * U64(2)
    }
    let oldRegistry = metalMemReadPtr(ctx, metalOffsetRegistry())
    let oldKinds = metalMemReadPtr(ctx, metalOffsetRegistryKinds())
    let registry = metalMemAlloc(grown * 8)
    let kinds = metalMemAlloc(grown)
    var id: U64 = 0
    while id < cap {
        metalMemWritePtr(registry, id * 8, metalMemReadPtr(oldRegistry, id * 8))
        metalMemWriteU8(kinds, id, metalMemReadU8(oldKinds, id))
        id = id + U64(1)
    }
    metalMemFree(oldRegistry)
    metalMemFree(oldKinds)
    metalMemWritePtr(ctx, metalOffsetRegistry(), registry)
    metalMemWritePtr(ctx, metalOffsetRegistryKinds(), kinds)
    metalMemWriteU64(ctx, metalOffsetRegistryCap(), grown)
    return
}

// Register a +1-owned Objective-C resource pointer and return its handle id. The
// entry is tagged as an object so teardown releases it.
@Native
function metalRegister(ctx: RawPtr, object: RawPtr) -> Int {
    let id = metalTakeId(ctx)
    let registry = metalMemReadPtr(ctx, metalOffsetRegistry())
    metalMemWritePtr(registry, id * 8, object)
    let kinds = metalMemReadPtr(ctx, metalOffsetRegistryKinds())
    metalMemWriteU8(kinds, id, metalRegistryKindObject())
    return id
}

// Register a raw metalMemAlloc block (e.g. a bind group) and return its handle id.
// The entry is tagged as a raw block so teardown frees it with metalMemFree rather
// than sending it an Objective-C `release` (which would crash on a non-object).
@Native
function metalRegisterRawBlock(ctx: RawPtr, block: RawPtr) -> Int {
    let id = metalTakeId(ctx)
    let registry = metalMemReadPtr(ctx, metalOffsetRegistry())
    metalMemWritePtr(registry, id * 8, block)
    let kinds = metalMemReadPtr(ctx, metalOffsetRegistryKinds())
    metalMemWriteU8(kinds, id, metalRegistryKindRawBlock())
    return id
}

// The id a new resource takes: a released one if any are waiting, otherwise the
// next never-used one, growing the table to fit it.
//
// Reuse is what keeps a long session bounded. Ids are handed out per resource and
// a scene rebuilds its per-entity uniforms whenever the entity count changes, so
// without reuse the table grows by the whole scene every rebuild and never
// shrinks — which is a leak of both ids and the memory they index.
function metalTakeId(ctx: RawPtr) -> U64 {
    let free = metalMemReadU64(ctx, metalOffsetFreeId())
    if free != 0 {
        let registry = metalMemReadPtr(ctx, metalOffsetRegistry())
        metalMemWriteU64(ctx, metalOffsetFreeId(), metalMemReadU64(registry, free * 8))
        return free
    }
    let id = metalMemReadU64(ctx, metalOffsetNextId())
    metalRegistryReserve(ctx, id)
    metalMemWriteU64(ctx, metalOffsetNextId(), id + U64(1))
    return id
}

// Release the resource behind a handle id and put the id back in circulation.
//
// Releasing twice, or releasing an id that was never registered, does nothing:
// the kind tag says what a slot holds, and a freed slot holds neither an object
// nor a block. That matters because a caller cannot see the difference — a
// double `destroyUniform` would otherwise over-release an Objective-C object and
// take the process down some frames later.
@Native
function metalUnregister(ctx: RawPtr, id: Int) {
    if id <= 0 {
        return
    }
    let slot = U64(id)
    if slot >= metalMemReadU64(ctx, metalOffsetNextId()) {
        return
    }
    let kinds = metalMemReadPtr(ctx, metalOffsetRegistryKinds())
    let kind = metalMemReadU8(kinds, slot)
    if kind == metalRegistryKindFree() {
        return
    }
    let registry = metalMemReadPtr(ctx, metalOffsetRegistry())
    let entry = metalMemReadPtr(registry, slot * 8)
    if !metalPtrIsNull(entry) {
        if kind == metalRegistryKindRawBlock() {
            metalMemFree(entry)
        } else {
            metalMsgSendVoid(entry, metalSel("release"))
        }
    }
    // The slot's pointer word becomes the link to the next free id, which is why
    // the kind has to say "free" before anything reads it as a resource again.
    metalMemWriteU8(kinds, slot, metalRegistryKindFree())
    metalMemWriteU64(registry, slot * 8, metalMemReadU64(ctx, metalOffsetFreeId()))
    metalMemWriteU64(ctx, metalOffsetFreeId(), slot)
    return
}

// Resolve a handle id back to its Objective-C resource pointer.
@Native
function metalLookup(ctx: RawPtr, id: Int) -> RawPtr {
    let registry = metalMemReadPtr(ctx, metalOffsetRegistry())
    return metalMemReadPtr(registry, id * 8)
}

// True when a context handle is present (the Metal backend is active for a pass).
@Native
function metalContextActive(ctx: RawPtr) -> Bool {
    return !metalPtrIsNull(ctx)
}

// Sample the frame clock: record the delta since the previous tick as the current
// frame duration (seconds). Called once per frame by the on-screen run loop; the live
// FPS readout reads it back through metalContextFrameDuration.
@Native
function metalContextTickFrameTime(ctx: RawPtr) {
    let now = metalClockNs(metalClockUptimeRaw())
    let last = metalMemReadU64(ctx, metalOffsetLastFrameNs())
    if last > 0 && now > last {
        metalMemWriteU64(ctx, metalOffsetFrameDurationNs(), now - last)
    }
    metalMemWriteU64(ctx, metalOffsetLastFrameNs(), now)
    return
}

// The most recent inter-frame delta in seconds (nanoseconds / 1e9), for the FPS
// readout. The conversion is a normal Kira Float division — no floating-point value
// crosses the FFI boundary.
@Native
function metalContextFrameDuration(ctx: RawPtr) -> Float {
    let durNs = metalMemReadU64(ctx, metalOffsetFrameDurationNs())
    return Float(durNs) / 1000000000.0
}

// Decode a positive IEEE-754 double (its 64 bits read as a u64) to an Int with integer
// arithmetic only. AppKit returns geometry as CGRect/CGFloat by value, which the FFI
// does not marshal (struct and floating-point returns read back as 0), so the value is
// fetched into a buffer via NSValue -getValue: and decoded here. 2^52 = 4503599627370496.
// Implicit U64->Int coercion (an explicit Int(u64) cast does not lower; a return-typed
// coercion does, as metalContextWidth relies on).
@Native
function metalU64ToInt(v: U64) -> Int {
    return v
}

// Full f64 decode (sign + fraction preserved) from raw bits — for event
// coordinates and scroll deltas, where metalDoubleBitsToInt's positive-integer
// truncation drops trackpad sub-point deltas and negative values entirely.
// Works in the sign-free domain: top 12 bits = sign(1) + exponent(11).
@Native
function metalDoubleBitsToFloat(bits: U64) -> Float {
    let top = metalU64ToInt(bits / U64(4503599627370496))
    let sign = top / 2048
    let exp = top % 2048
    if exp == 0 || exp == 2047 {
        return 0.0
    }
    let mant = metalU64ToInt(bits % U64(4503599627370496))
    var frac = 1.0 + Float(mant) / 4503599627370496.0
    var k = exp - 1023
    while k > 0 {
        frac = frac * 2.0
        k = k - 1
    }
    while k < 0 {
        frac = frac / 2.0
        k = k + 1
    }
    if sign == 1 {
        return 0.0 - frac
    }
    return frac
}

@Native
function metalDoubleBitsToInt(bits: U64) -> Int {
    let b = metalU64ToInt(bits)
    if b <= 0 {
        return 0
    }
    let topBits = b / 4503599627370496
    let exp = topBits % 2048
    if exp == 0 || exp == 2047 {
        return 0
    }
    let mantissa = b % 4503599627370496
    let frac = 1.0 + Float(mantissa) / 4503599627370496.0
    var p = 1.0
    var k = exp - 1023
    while k > 0 {
        p = p * 2.0
        k = k - 1
    }
    while k < 0 {
        p = p / 2.0
        k = k + 1
    }
    return Int(frac * p)
}

// Track the host view's current size and the display's backing scale so the drawable is
// sized in physical pixels at the live window size and the UI layout reflows on resize.
// Called once per frame by the on-screen run loop. Geometry is read through KVC because
// the direct CGRect/CGFloat message returns do not marshal across the FFI: -valueForKey:
// returns an NSValue/NSNumber (a pointer), -getValue: writes the boxed NSRect's four
// doubles into a buffer, and -integerValue returns the scale as a plain integer.
@Native
function metalContextSyncViewportFromView(ctx: RawPtr) {
    let view = metalMemReadPtr(ctx, metalOffsetHostView())
    if metalPtrIsNull(view) {
        return
    }
    let boundsKey = metalMsgSendStr(metalObjcGetClass("NSString"), metalSel("stringWithUTF8String:"), "bounds")
    let value = metalMsgSendP(view, metalSel("valueForKey:"), boundsKey)
    if metalPtrIsNull(value) {
        return
    }
    let buf = metalMemAlloc(32)
    metalMsgSendVoidP(value, metalSel("getValue:"), buf)
    let w = metalDoubleBitsToInt(metalMemReadU64(buf, 16))
    let h = metalDoubleBitsToInt(metalMemReadU64(buf, 24))
    metalMemFree(buf)
    if w <= 0 || h <= 0 || w > 16384 || h > 16384 {
        return
    }

    var scale = 1
    let window = metalMsgSend(view, metalSel("window"))
    if !metalPtrIsNull(window) {
        let scaleKey = metalMsgSendStr(metalObjcGetClass("NSString"), metalSel("stringWithUTF8String:"), "backingScaleFactor")
        let scaleNum = metalMsgSendP(window, metalSel("valueForKey:"), scaleKey)
        if !metalPtrIsNull(scaleNum) {
            let s = metalU64ToInt(metalMsgSendU64(scaleNum, metalSel("integerValue")))
            if s >= 1 && s <= 4 {
                scale = s
            }
        }
    }
    let pw = w * scale
    let ph = h * scale

    let curW = metalMemReadU64(ctx, metalOffsetWidth())
    let curH = metalMemReadU64(ctx, metalOffsetHeight())
    let curPhysical = metalMemReadU64(ctx, metalOffsetPhysicalWidth())
    if w == curW && h == curH && curPhysical != 0 {
        return
    }
    let layer = metalMemReadPtr(ctx, metalOffsetLayer())
    if !metalPtrIsNull(layer) {
        // Layer frame in points (so the content tracks the window), drawable in physical
        // pixels and contentsScale the backing factor (so it is crisp at native res).
        metalMsgSendVoid4F(layer, metalSel("setFrame:"), 0.0, 0.0, Float(w), Float(h))
        metalMsgSendVoid2F(layer, metalSel("setDrawableSize:"), Float(pw), Float(ph))
        metalMsgSendVoidF(layer, metalSel("setContentsScale:"), Float(scale))
    }
    metalMemWriteU64(ctx, metalOffsetWidth(), w)
    metalMemWriteU64(ctx, metalOffsetHeight(), h)
    metalMemWriteU64(ctx, metalOffsetPhysicalWidth(), pw)
    return
}

// Backing (Retina) scale = physical pixels / points. 1.0 until the first viewport sync.
@Native
function metalContextScale(ctx: RawPtr) -> Float {
    let pw = metalMemReadU64(ctx, metalOffsetPhysicalWidth())
    let w = metalMemReadU64(ctx, metalOffsetWidth())
    if w <= 0 || pw <= 0 {
        return 1.0
    }
    return Float(pw) / Float(w)
}

// Drawable dimensions recorded on the context (the UI layout/viewport source on the
// Metal path, where Sokol's sapp_width/height are not valid).
@Native
function metalContextWidth(ctx: RawPtr) -> Int {
    return metalMemReadU64(ctx, metalOffsetWidth())
}

@Native
function metalContextHeight(ctx: RawPtr) -> Int {
    return metalMemReadU64(ctx, metalOffsetHeight())
}

// Resolve a handle id (as U64) to its Objective-C resource pointer. Used by the
// bind-group apply loop, which carries ids as U64 in its raw entry block.
@Native
function metalLookupU64(ctx: RawPtr, id: U64) -> RawPtr {
    let registry = metalMemReadPtr(ctx, metalOffsetRegistry())
    return metalMemReadPtr(registry, id * 8)
}

// Metal enum constants we reference (kept local and explicit, not magic numbers
// at the call sites).
function metalPixelFormatBGRA8Unorm() -> U64 { return 80 }
function metalTextureUsageRenderTarget() -> U64 { return 4 }
function metalStorageModeShared() -> U64 { return 0 }
function metalLoadActionClear() -> U64 { return 2 }
function metalLoadActionLoad() -> U64 { return 1 }
function metalStoreActionStore() -> U64 { return 1 }
function metalStoreActionDontCare() -> U64 { return 0 }
function metalPixelFormatDepth32Float() -> U64 { return 252 }
function metalStorageModePrivate() -> U64 { return 2 }
function metalCompareFunctionLess() -> U64 { return 1 }

// Allocate the context block and create the device + command queue.
@Native
function metalContextAlloc() -> RawPtr {
    let ctx = metalMemAlloc(metalContextSize())
    let device = metalCreateSystemDefaultDevice()
    let queue = metalMsgSend(device, metalSel("newCommandQueue"))
    metalMemWritePtr(ctx, metalOffsetDevice(), device)
    metalMemWritePtr(ctx, metalOffsetQueue(), queue)
    // Null the surface/depth slots so offscreen mode (no layer/drawable) and the
    // no-depth path are detectable.
    metalMemWritePtr(ctx, metalOffsetLayer(), metalNullPtr())
    metalMemWritePtr(ctx, metalOffsetDrawable(), metalNullPtr())
    metalMemWritePtr(ctx, metalOffsetDepthTexture(), metalNullPtr())
    metalMemWritePtr(ctx, metalOffsetDepthState(), metalNullPtr())
    metalMemWritePtr(ctx, metalOffsetHostView(), metalNullPtr())
    metalMemWriteU64(ctx, metalOffsetLastFrameNs(), 0)
    metalMemWriteU64(ctx, metalOffsetFrameDurationNs(), 0)
    metalMemWriteU64(ctx, metalOffsetPhysicalWidth(), 0)
    // Resource registry: capacity pointers, ids starting at 1. The parallel kinds
    // table (one U8 per id) records whether each entry is an Objective-C object or a
    // raw block so teardown can release vs free it correctly.
    let registry = metalMemAlloc(metalRegistryInitialCapacity() * 8)
    metalMemWritePtr(ctx, metalOffsetRegistry(), registry)
    let kinds = metalMemAlloc(metalRegistryInitialCapacity())
    metalMemWritePtr(ctx, metalOffsetRegistryKinds(), kinds)
    metalMemWriteU64(ctx, metalOffsetRegistryCap(), metalRegistryInitialCapacity())
    metalMemWriteU64(ctx, metalOffsetFreeId(), 0)
    metalMemWriteU64(ctx, metalOffsetNextId(), 1)
    return ctx
}

// Attach a CAMetalLayer surface (the real on-screen path, replacing the legacy
// OpenGL layer). Today the layer is created standalone and verified by reading
// the presented drawable back; the host runner attaches it to its NSView/UIView
// in the on-screen integration. Switching a context to layer mode makes each pass
// acquire and present a CAMetalLayer drawable instead of rendering to a fixed
// offscreen texture.
@Native
function metalContextAttachLayer(ctx: RawPtr, width: Int, height: Int) {
    let device = metalMemReadPtr(ctx, metalOffsetDevice())
    let layerClass = metalObjcGetClass("CAMetalLayer")
    let layerAlloc = metalMsgSend(layerClass, metalSel("alloc"))
    let layer = metalMsgSend(layerAlloc, metalSel("init"))
    metalMsgSendVoidP(layer, metalSel("setDevice:"), device)
    metalMsgSendVoidU(layer, metalSel("setPixelFormat:"), metalPixelFormatBGRA8Unorm())
    metalMsgSendVoidB(layer, metalSel("setFramebufferOnly:"), false)
    metalMsgSendVoid2F(layer, metalSel("setDrawableSize:"), Float(width), Float(height))
    metalMemWritePtr(ctx, metalOffsetLayer(), layer)
    metalMemWriteU64(ctx, metalOffsetWidth(), width)
    metalMemWriteU64(ctx, metalOffsetHeight(), height)
    return
}

// Destroy the context: release every Objective-C object it owns (each backend
// resource is created through a +1-owned `new*`/`alloc`+`init` message and never
// released elsewhere), free the registry and handle blocks. Wired to run at app
// shutdown (metalRunApplication) so these process-lifetime objects — the render/
// compute pipelines, shader libraries, buffers, textures, samplers, the command
// queue and its dispatch sources, and the device — do not survive to `leaks --atExit`.
@Native
function metalContextFree(ctx: RawPtr) {
    // Release the last command buffer we retained for the deferred readback wait.
    let pending = metalMemReadPtr(ctx, metalOffsetCommandBuffer())
    if !metalPtrIsNull(pending) {
        metalMsgSendVoid(pending, metalSel("release"))
    }
    // Release/free every registered resource (ids 1..nextId-1; id 0 is the reserved
    // sentinel), then free the registry and its parallel kinds table. Object entries
    // are +1-owned `new*` results (library / buffer / pipeline / texture / sampler)
    // and are released; raw-block entries (bind groups) are freed with metalMemFree —
    // sending them an Objective-C `release` would crash on a non-object.
    let registry = metalMemReadPtr(ctx, metalOffsetRegistry())
    let kinds = metalMemReadPtr(ctx, metalOffsetRegistryKinds())
    if !metalPtrIsNull(registry) {
        let nextId = metalMemReadU64(ctx, metalOffsetNextId())
        var id: U64 = 1
        while id < nextId {
            let kind = metalMemReadU8(kinds, id)
            let entry = metalMemReadPtr(registry, id * 8)
            // A freed slot's word is a free-list link, not a resource: releasing
            // it would send `release` to a small integer.
            if kind != metalRegistryKindFree() && !metalPtrIsNull(entry) {
                if kind == metalRegistryKindRawBlock() {
                    metalMemFree(entry)
                } else {
                    metalMsgSendVoid(entry, metalSel("release"))
                }
            }
            id = id + 1
        }
        metalMemFree(registry)
    }
    if !metalPtrIsNull(kinds) {
        metalMemFree(kinds)
    }
    // Release the context-owned depth target/state (null unless depth was attached).
    let depthState = metalMemReadPtr(ctx, metalOffsetDepthState())
    if !metalPtrIsNull(depthState) {
        metalMsgSendVoid(depthState, metalSel("release"))
    }
    let depthTexture = metalMemReadPtr(ctx, metalOffsetDepthTexture())
    if !metalPtrIsNull(depthTexture) {
        metalMsgSendVoid(depthTexture, metalSel("release"))
    }
    // The color target is +1-owned ONLY in offscreen mode (newTextureWithDescriptor:).
    // In layer mode it is the drawable's texture, which we do not own — releasing it
    // would over-release — so skip it whenever a layer is present.
    let layer = metalMemReadPtr(ctx, metalOffsetLayer())
    if metalPtrIsNull(layer) {
        let colorTexture = metalMemReadPtr(ctx, metalOffsetColorTexture())
        if !metalPtrIsNull(colorTexture) {
            metalMsgSendVoid(colorTexture, metalSel("release"))
        }
    } else {
        // The CAMetalLayer is a +1-owned alloc/init we created for the on-screen path.
        metalMsgSendVoid(layer, metalSel("release"))
    }
    // Release the command queue, breaking its dispatch-source retain cycles.
    let queue = metalMemReadPtr(ctx, metalOffsetQueue())
    if !metalPtrIsNull(queue) {
        metalMsgSendVoid(queue, metalSel("release"))
    }
    // The device is NOT released: MTLCreateSystemDefaultDevice returns a cached
    // process-lifetime singleton (the same object every call), which Metal retains
    // internally. Releasing our reference per-context over-releases the shared device
    // and crashes the next context that recreates it. It is process-lifetime and does
    // not appear in the per-run leak buckets, so we intentionally leave it reachable.
    metalMemFree(ctx)
    return
}

function metalPixelFormatR32Uint() -> U64 { return 53 }

// Map a KiraGraphics texture format (Constants.kira) to an MTLPixelFormat.
function metalPixelFormatForTexture(kiraFormat: Int) -> U64 {
    if kiraFormat == 10 { return metalPixelFormatR32Uint() }   // textureFormatR32Uint
    return metalPixelFormatBGRA8Unorm()                        // swapchain / default
}

// Allocate an offscreen BGRA8 render target and make it the context's color target.
@Native
function metalContextAttachOffscreen(ctx: RawPtr, width: Int, height: Int) {
    metalContextAttachOffscreenFormat(ctx, width, height, metalPixelFormatBGRA8Unorm())
    return
}

// As above but with an explicit MTLPixelFormat (e.g. R32Uint for a visibility
// buffer). The readback path reads the raw 32-bit texel, which is the uint value
// directly for R32Uint targets.
//
// KIRA_METAL_OFFSCREEN_SCALE emulates a Retina backing factor headlessly:
// width/height stay in points, the color target is points x scale physical
// pixels, and physicalWidth records the factor — the same shape the on-screen
// layer path produces, so scale-dependent rendering bugs reproduce offscreen.
@Native
function metalContextAttachOffscreenFormat(ctx: RawPtr, width: Int, height: Int, pixelFormat: U64) {
    var scaleFactor = 1
    let scaleEnv = metalGetEnv("KIRA_METAL_OFFSCREEN_SCALE")
    if !metalPtrIsNull(scaleEnv) {
        let parsed = metalEnvInt(scaleEnv)
        if parsed > 1 {
            scaleFactor = parsed
        }
    }
    let device = metalMemReadPtr(ctx, metalOffsetDevice())
    let descClass = metalObjcGetClass("MTLTextureDescriptor")
    let desc = metalMsgSendTexDesc(descClass, metalSel("texture2DDescriptorWithPixelFormat:width:height:mipmapped:"), pixelFormat, width * scaleFactor, height * scaleFactor, false)
    metalMsgSendVoidU(desc, metalSel("setUsage:"), metalTextureUsageRenderTarget())
    metalMsgSendVoidU(desc, metalSel("setStorageMode:"), metalStorageModeShared())
    let texture = metalMsgSendP(device, metalSel("newTextureWithDescriptor:"), desc)
    metalMemWritePtr(ctx, metalOffsetColorTexture(), texture)
    metalMemWriteU64(ctx, metalOffsetWidth(), width)
    metalMemWriteU64(ctx, metalOffsetHeight(), height)
    metalMemWriteU64(ctx, metalOffsetPhysicalWidth(), width * scaleFactor)
    return
}

// Create a color texture usable as BOTH a render target and a sampled input
// (usage = RenderTarget | ShaderRead), registered so it can be targeted by a pass
// and bound to a later pass. Enables multi-pass rendering (e.g. deferred resolve:
// pass 1 -> visibility texture, pass 2 samples it -> final color).
@Native
function metalCreateColorTargetTexture(ctx: RawPtr, width: Int, height: Int, pixelFormat: U64) -> Int {
    let device = metalMemReadPtr(ctx, metalOffsetDevice())
    let descClass = metalObjcGetClass("MTLTextureDescriptor")
    let desc = metalMsgSendTexDesc(descClass, metalSel("texture2DDescriptorWithPixelFormat:width:height:mipmapped:"), pixelFormat, width, height, false)
    metalMsgSendVoidU(desc, metalSel("setUsage:"), metalTextureUsageRenderTarget() + 1)   // RenderTarget(4) | ShaderRead(1)
    metalMsgSendVoidU(desc, metalSel("setStorageMode:"), metalStorageModeShared())
    let texture = metalMsgSendP(device, metalSel("newTextureWithDescriptor:"), desc)
    return metalRegister(ctx, texture)
}

// Begin a render pass that targets a REGISTERED texture (not the context's swapchain/
// offscreen color texture). Used for intermediate passes in multi-pass rendering. Does
// not touch the context colorTexture slot, so a later swapchain pass + readback still
// see the final image.
@Native
function metalContextBeginClearTarget(ctx: RawPtr, textureId: Int, loadAction: U64, r: F64, g: F64, b: F64, a: F64, depthEnabled: Bool) {
    let queue = metalMemReadPtr(ctx, metalOffsetQueue())
    let texture = metalLookup(ctx, textureId)
    let rpClass = metalObjcGetClass("MTLRenderPassDescriptor")
    let rp = metalMsgSend(rpClass, metalSel("renderPassDescriptor"))
    let colorAttachments = metalMsgSend(rp, metalSel("colorAttachments"))
    let ca0 = metalMsgSendPU(colorAttachments, metalSel("objectAtIndexedSubscript:"), 0)
    metalMsgSendVoidP(ca0, metalSel("setTexture:"), texture)
    metalMsgSendVoidU(ca0, metalSel("setLoadAction:"), loadAction)
    metalMsgSendVoidU(ca0, metalSel("setStoreAction:"), metalStoreActionStore())
    metalMsgSendVoid4F(ca0, metalSel("setClearColor:"), r, g, b, a)
    if depthEnabled {
        let depthTexture = metalMemReadPtr(ctx, metalOffsetDepthTexture())
        let depthAtt = metalMsgSend(rp, metalSel("depthAttachment"))
        metalMsgSendVoidP(depthAtt, metalSel("setTexture:"), depthTexture)
        metalMsgSendVoidU(depthAtt, metalSel("setLoadAction:"), metalLoadActionClear())
        metalMsgSendVoidU(depthAtt, metalSel("setStoreAction:"), metalStoreActionStore())
        metalMsgSendVoidF(depthAtt, metalSel("setClearDepth:"), 1.0)
    }
    let commandBuffer = metalMsgSend(queue, metalSel("commandBuffer"))
    let encoder = metalMsgSendP(commandBuffer, metalSel("renderCommandEncoderWithDescriptor:"), rp)
    if depthEnabled {
        let depthState = metalMemReadPtr(ctx, metalOffsetDepthState())
        metalMsgSendVoidP(encoder, metalSel("setDepthStencilState:"), depthState)
    }
    metalStashCommandBuffer(ctx, commandBuffer)
    metalMemWritePtr(ctx, metalOffsetEncoder(), encoder)
    return
}

// Create a Depth32Float depth target and a less/write depth-stencil state for the
// context (sized to the current color target). Enables depth-tested passes.
@Native
function metalContextAttachDepth(ctx: RawPtr) {
    let device = metalMemReadPtr(ctx, metalOffsetDevice())
    let width = metalMemReadU64(ctx, metalOffsetWidth())
    let height = metalMemReadU64(ctx, metalOffsetHeight())
    let descClass = metalObjcGetClass("MTLTextureDescriptor")
    let desc = metalMsgSendTexDesc(descClass, metalSel("texture2DDescriptorWithPixelFormat:width:height:mipmapped:"), metalPixelFormatDepth32Float(), width, height, false)
    metalMsgSendVoidU(desc, metalSel("setUsage:"), metalTextureUsageRenderTarget() + metalTextureUsageShaderRead())
    metalMsgSendVoidU(desc, metalSel("setStorageMode:"), metalStorageModePrivate())
    let depthTexture = metalMsgSendP(device, metalSel("newTextureWithDescriptor:"), desc)
    metalMemWritePtr(ctx, metalOffsetDepthTexture(), depthTexture)

    let dsDescClass = metalObjcGetClass("MTLDepthStencilDescriptor")
    let dsDesc = metalMsgSend(metalMsgSend(dsDescClass, metalSel("alloc")), metalSel("init"))
    metalMsgSendVoidU(dsDesc, metalSel("setDepthCompareFunction:"), metalCompareFunctionLess())
    metalMsgSendVoidB(dsDesc, metalSel("setDepthWriteEnabled:"), true)
    let depthState = metalMsgSendP(device, metalSel("newDepthStencilStateWithDescriptor:"), dsDesc)
    // The descriptor is a +1-owned alloc/init temporary; the depth-stencil state does
    // not retain it, so release it here rather than leaking one per attach.
    metalMsgSendVoid(dsDesc, metalSel("release"))
    metalMemWritePtr(ctx, metalOffsetDepthState(), depthState)
    return
}

// Attach a CAMetalLayer to a host-provided NSView/UIView (the on-screen path: the
// platform runner creates the window + view and drives the run loop; the backend
// owns the layer and all draw/present). After this the context is in layer mode, so
// each pass acquires and presents a drawable from the on-screen layer. macOS sets
// the view layer-backed via setWantsLayer:/setLayer:; on iOS a UIView is already
// layer-backed and the layer is added as a sublayer by the runner.
@Native
function metalContextAttachLayerToView(ctx: RawPtr, viewPtr: RawPtr, width: Int, height: Int) {
    let device = metalMemReadPtr(ctx, metalOffsetDevice())
    let layerClass = metalObjcGetClass("CAMetalLayer")
    let layer = metalMsgSend(metalMsgSend(layerClass, metalSel("alloc")), metalSel("init"))
    metalMsgSendVoidP(layer, metalSel("setDevice:"), device)
    metalMsgSendVoidU(layer, metalSel("setPixelFormat:"), metalPixelFormatBGRA8Unorm())
    // Let Core Animation resize the layer (and thus its auto-sized drawable) with the
    // view: kCALayerWidthSizable|kCALayerHeightSizable = 2|16. We do NOT pin
    // drawableSize, so CAMetalLayer keeps it at bounds x contentsScale and updates it
    // on resize; the actual pixel size is read back from the drawable's texture.
    metalMsgSendVoidU(layer, metalSel("setAutoresizingMask:"), 18)
    // A drawable is write-only by default, which is exactly right for a window and
    // exactly wrong for proving one draws: nothing may read back what was presented.
    // KIRA_METAL_ONSCREEN_DUMP opts out of that so a headless session can dump the
    // frame the screen received. Opt-in, because framebufferOnly is a real
    // optimisation (it lets Core Animation pick a lossless-compressed texture) and
    // a window nobody is verifying should keep it.
    let onScreenDumpEnv = metalGetEnv("KIRA_METAL_ONSCREEN_DUMP")
    if !metalPtrIsNull(onScreenDumpEnv) {
        metalMsgSendVoidB(layer, metalSel("setFramebufferOnly:"), false)
    }
    // During a live drag the Kira frame loop is blocked inside AppKit's modal resize
    // tracking, so no new frame is presented until the drag ends. contentsGravity
    // "resize" makes the last presented frame stretch to fill the growing/shrinking
    // layer in the meantime, so the content visually tracks the window during the drag
    // and snaps back to crisp native resolution when the loop resumes and re-renders.
    let gravity = metalMsgSendStr(metalObjcGetClass("NSString"), metalSel("stringWithUTF8String:"), "resize")
    metalMsgSendVoidP(layer, metalSel("setContentsGravity:"), gravity)
    // `KIRA_METAL_NO_VSYNC=1` presents without waiting for the display, so the
    // window runs as fast as a frame costs rather than as fast as the panel
    // refreshes. That is what makes a real workload's frame budget visible: on
    // the beam, every frame under 16.7 ms looks the same, and the difference
    // between 3 ms of work and 15 ms shows up only as headroom nobody can see.
    // Opt-in, because a shipped app should present on the beam.
    if !metalPtrIsNull(metalGetEnv("KIRA_METAL_NO_VSYNC")) {
        metalMsgSendVoidB(layer, metalSel("setDisplaySyncEnabled:"), false)
    }
    // Order matters: assign the layer FIRST, then turn on wantsLayer. This makes the
    // view layer-HOSTING (the CAMetalLayer is ours to drive) rather than layer-backed
    // (where AppKit owns the layer and would draw the view's opaque background over our
    // rendered content on every display pass, blanking the frame).
    metalMsgSendVoidP(viewPtr, metalSel("setLayer:"), layer)
    metalMsgSendVoidB(viewPtr, metalSel("setWantsLayer:"), true)
    metalMemWritePtr(ctx, metalOffsetLayer(), layer)
    metalMemWritePtr(ctx, metalOffsetHostView(), viewPtr)
    metalMemWriteU64(ctx, metalOffsetWidth(), width)
    metalMemWriteU64(ctx, metalOffsetHeight(), height)
    return
}

// Begin a render pass that clears the color target to (r,g,b,a), optionally with a
// depth attachment cleared to 1.0 and a less/write depth-stencil state bound. Builds
// the MTLRenderPassDescriptor, attachments, command buffer and render-command
// encoder, leaving the encoder recorded on the context.
@Native
function metalContextBeginClear(ctx: RawPtr, loadAction: U64, r: F64, g: F64, b: F64, a: F64, depthEnabled: Bool) {
    let queue = metalMemReadPtr(ctx, metalOffsetQueue())
    // In layer mode, acquire the next CAMetalLayer drawable and render into its
    // texture; in offscreen mode, render into the fixed offscreen texture. Either
    // way the active texture is recorded at the colorTexture slot so readback
    // (verification) targets exactly what was rendered.
    let layer = metalMemReadPtr(ctx, metalOffsetLayer())
    var texture = metalMemReadPtr(ctx, metalOffsetColorTexture())
    if !metalPtrIsNull(layer) {
        let drawable = metalMsgSend(layer, metalSel("nextDrawable"))
        metalMemWritePtr(ctx, metalOffsetDrawable(), drawable)
        texture = metalMsgSend(drawable, metalSel("texture"))
        metalMemWritePtr(ctx, metalOffsetColorTexture(), texture)
    }
    let rpClass = metalObjcGetClass("MTLRenderPassDescriptor")
    let rp = metalMsgSend(rpClass, metalSel("renderPassDescriptor"))
    let colorAttachments = metalMsgSend(rp, metalSel("colorAttachments"))
    let ca0 = metalMsgSendPU(colorAttachments, metalSel("objectAtIndexedSubscript:"), 0)
    metalMsgSendVoidP(ca0, metalSel("setTexture:"), texture)
    metalMsgSendVoidU(ca0, metalSel("setLoadAction:"), loadAction)
    metalMsgSendVoidU(ca0, metalSel("setStoreAction:"), metalStoreActionStore())
    metalMsgSendVoid4F(ca0, metalSel("setClearColor:"), r, g, b, a)

    if depthEnabled {
        let depthTexture = metalMemReadPtr(ctx, metalOffsetDepthTexture())
        let depthAtt = metalMsgSend(rp, metalSel("depthAttachment"))
        metalMsgSendVoidP(depthAtt, metalSel("setTexture:"), depthTexture)
        metalMsgSendVoidU(depthAtt, metalSel("setLoadAction:"), metalLoadActionClear())
        metalMsgSendVoidU(depthAtt, metalSel("setStoreAction:"), metalStoreActionStore())
        metalMsgSendVoidF(depthAtt, metalSel("setClearDepth:"), 1.0)
    }

    let commandBuffer = metalMsgSend(queue, metalSel("commandBuffer"))
    let encoder = metalMsgSendP(commandBuffer, metalSel("renderCommandEncoderWithDescriptor:"), rp)
    if depthEnabled {
        let depthState = metalMemReadPtr(ctx, metalOffsetDepthState())
        metalMsgSendVoidP(encoder, metalSel("setDepthStencilState:"), depthState)
    }
    metalStashCommandBuffer(ctx, commandBuffer)
    metalMemWritePtr(ctx, metalOffsetEncoder(), encoder)
    return
}

// End the current pass, submit it, and wait for completion (offscreen path).
@Native
function metalContextEndAndCommit(ctx: RawPtr) {
    let encoder = metalMemReadPtr(ctx, metalOffsetEncoder())
    let commandBuffer = metalMemReadPtr(ctx, metalOffsetCommandBuffer())
    metalMsgSendVoid(encoder, metalSel("endEncoding"))
    // Present the drawable in layer mode before committing.
    let drawable = metalMemReadPtr(ctx, metalOffsetDrawable())
    if !metalPtrIsNull(drawable) {
        metalMsgSendVoidP(commandBuffer, metalSel("presentDrawable:"), drawable)
        metalMemWritePtr(ctx, metalOffsetDrawable(), metalNullPtr())
    }
    metalMsgSendVoid(commandBuffer, metalSel("commit"))
    // No waitUntilCompleted here: the on-screen path presents the drawable (which
    // sequences its own work and never blocks), and the offscreen path only needs
    // GPU completion when a pixel is read back — so the wait lives in
    // metalContextReadPixel. Blocking every offscreen frame serialized CPU and GPU
    // (no pipelining) — the resize-bench cost that does not exist on screen. The
    // command buffer stays retained at metalOffsetCommandBuffer() for that wait.
    return
}

// Read back a single pixel from the color target. The four BGRA bytes are read as
// one little-endian U32, i.e. (A << 24) | (R << 16) | (G << 8) | B, so callers can
// unpack without extra FFI round-trips and we avoid any width-casting in the hot
// readback path.
@Native
function metalContextReadPixel(ctx: RawPtr, x: Int, y: Int) -> U32 {
    // Block on the last submitted command buffer before reading its output (the
    // per-frame wait was removed from metalContextEndAndCommit so offscreen frames
    // pipeline; correctness for the readback path is restored here).
    let pending = metalMemReadPtr(ctx, metalOffsetCommandBuffer())
    if !metalPtrIsNull(pending) {
        metalMsgSendVoid(pending, metalSel("waitUntilCompleted"))
    }
    let texture = metalMemReadPtr(ctx, metalOffsetColorTexture())
    let region = metalMemAlloc(48)
    metalMemWriteU64(region, 0, x)
    metalMemWriteU64(region, 8, y)
    metalMemWriteU64(region, 16, 0)
    metalMemWriteU64(region, 24, 1)
    metalMemWriteU64(region, 32, 1)
    metalMemWriteU64(region, 40, 1)
    let px = metalMemAlloc(4)
    metalMsgSendGetBytes(texture, metalSel("getBytes:bytesPerRow:fromRegion:mipmapLevel:"), px, 4, region, 0)
    let packed = metalMemReadU32(px, 0)
    metalMemFree(region)
    metalMemFree(px)
    return packed
}

// Deterministic digest of the WHOLE color target — a golden-image gate. Reads every
// texel once and folds it into a rolling modular hash (in U64 to avoid overflow; the
// result fits in U32). Identical rendering -> identical digest, so a shell harness can
// assert pixel-exact stability of the entire framebuffer, not just probe points.
@Native
function metalContextImageDigest(ctx: RawPtr, width: Int, height: Int) -> U32 {
    let pending = metalMemReadPtr(ctx, metalOffsetCommandBuffer())
    if !metalPtrIsNull(pending) {
        metalMsgSendVoid(pending, metalSel("waitUntilCompleted"))
    }
    let texture = metalMemReadPtr(ctx, metalOffsetColorTexture())
    let bytesPerRow = width * 4
    let total = width * height * 4
    let buf = metalMemAlloc(U64(total))
    let region = metalMemAlloc(48)
    metalMemWriteU64(region, 0, 0)
    metalMemWriteU64(region, 8, 0)
    metalMemWriteU64(region, 16, 0)
    metalMemWriteU64(region, 24, width)
    metalMemWriteU64(region, 32, height)
    metalMemWriteU64(region, 40, 1)
    metalMsgSendGetBytes(texture, metalSel("getBytes:bytesPerRow:fromRegion:mipmapLevel:"), buf, U64(bytesPerRow), region, 0)
    let prime: U64 = 2147483647
    var hash: U64 = 2166136261
    let words = width * height
    var i = 0
    while i < words {
        let word = metalMemReadU32(buf, U64(i * 4))
        hash = (hash * U64(31) + U64(word)) % prime
        i = i + 1
    }
    metalMemFree(buf)
    metalMemFree(region)
    return U32(hash)
}

// Full-framebuffer dump — writes the color target's raw texel bytes (BGRA8, row-major,
// width*4 bytes per row, no header) to `path` for visual verification of a rendered
// frame. Dimensions are known to the harness, so a raw blob keeps the writer trivial;
// opt-in via KIRA_METAL_IMAGE_DUMP (the env VALUE is the destination path).
@Native
function metalContextImageDump(ctx: RawPtr, width: Int, height: Int, path: RawPtr) {
    let pending = metalMemReadPtr(ctx, metalOffsetCommandBuffer())
    if !metalPtrIsNull(pending) {
        metalMsgSendVoid(pending, metalSel("waitUntilCompleted"))
    }
    let texture = metalMemReadPtr(ctx, metalOffsetColorTexture())
    let bytesPerRow = width * 4
    let total = width * height * 4
    let buf = metalMemAlloc(U64(total))
    let region = metalMemAlloc(48)
    metalMemWriteU64(region, 0, 0)
    metalMemWriteU64(region, 8, 0)
    metalMemWriteU64(region, 16, 0)
    metalMemWriteU64(region, 24, width)
    metalMemWriteU64(region, 32, height)
    metalMemWriteU64(region, 40, 1)
    metalMsgSendGetBytes(texture, metalSel("getBytes:bytesPerRow:fromRegion:mipmapLevel:"), buf, U64(bytesPerRow), region, 0)
    let stream = metalFOpen(path, "wb")
    if !metalPtrIsNull(stream) {
        let written = metalFWrite(buf, 1, U64(total), stream)
        let ignored = written + 0
        metalFClose(stream)
    }
    metalMemFree(buf)
    metalMemFree(region)
    return
}
