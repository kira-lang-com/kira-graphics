import Foundation

// Vulkan keeps its wire vocabulary in C enums and bit flags. These helpers keep
// that representation at the FFI edge; the public API remains the typed Kira
// enums from `Formats` and `PassVocabulary`.

@FFI.Array { element: U32, count: 4 }
struct VulkanWordArray4 {}

@FFI.Array { element: VkPipelineShaderStageCreateInfo, count: 2 }
struct VulkanShaderStageArray2 {}

@FFI.Array { element: VkVertexInputAttributeDescription, count: 16 }
struct VulkanVertexAttributeArray16 {}

@FFI.Array { element: VkVertexInputBindingDescription, count: 1 }
struct VulkanVertexBindingArray1 {}

@FFI.Array { element: VkPipelineColorBlendAttachmentState, count: 1 }
struct VulkanBlendAttachmentArray1 {}

@FFI.Array { element: VkDescriptorSetLayoutBinding, count: 32 }
struct VulkanDescriptorBindingArray32 {}

@FFI.Array { element: VkDescriptorPoolSize, count: 5 }
struct VulkanDescriptorPoolSizeArray5 {}

@FFI.Struct { layout: c }
struct VkClearColorValue {
    var words: VulkanWordArray4
}

@FFI.Struct { layout: c }
struct VkClearValue {
    var color: VkClearColorValue
}

@FFI.Struct { layout: c }
struct VkRenderingAttachmentInfo {
    var sType: I32
    var pNext: RawPtr
    var imageView: VkImageView_T_ptr
    var imageLayout: I32
    var resolveMode: I32
    var resolveImageView: VkImageView_T_ptr
    var resolveImageLayout: I32
    var loadOp: I32
    var storeOp: I32
    var clearValue: VkClearValue
}

function vulkanSuccess() -> I32 { return I32(0) }
function vulkanNotReady() -> I32 { return I32(1) }
function vulkanTimeout() -> I32 { return I32(2) }
function vulkanIncomplete() -> I32 { return I32(5) }
function vulkanErrorOutOfHostMemory() -> I32 { return I32(0 - 1) }
function vulkanErrorOutOfDeviceMemory() -> I32 { return I32(0 - 2) }
function vulkanErrorInitializationFailed() -> I32 { return I32(0 - 3) }
function vulkanErrorDeviceLost() -> I32 { return I32(0 - 4) }
function vulkanErrorExtensionNotPresent() -> I32 { return I32(0 - 7) }
function vulkanErrorFeatureNotPresent() -> I32 { return I32(0 - 8) }
function vulkanErrorIncompatibleDriver() -> I32 { return I32(0 - 9) }
function vulkanErrorFormatNotSupported() -> I32 { return I32(0 - 11) }
function vulkanErrorSurfaceLost() -> I32 { return I32(0 - 1000000000) }
function vulkanErrorOutOfDate() -> I32 { return I32(0 - 1000001004) }
function vulkanSuboptimal() -> I32 { return I32(1000001003) }

function vulkanStructureApplicationInfo() -> I32 { return I32(0) }
function vulkanStructureInstanceCreateInfo() -> I32 { return I32(1) }
function vulkanStructureDeviceQueueCreateInfo() -> I32 { return I32(2) }
function vulkanStructureDeviceCreateInfo() -> I32 { return I32(3) }
function vulkanStructureSubmitInfo() -> I32 { return I32(4) }
function vulkanStructureMemoryAllocateInfo() -> I32 { return I32(5) }
function vulkanStructureMappedMemoryRange() -> I32 { return I32(6) }
function vulkanStructureImageMemoryBarrier() -> I32 { return I32(45) }
function vulkanStructureFenceCreateInfo() -> I32 { return I32(8) }
function vulkanStructureSemaphoreCreateInfo() -> I32 { return I32(9) }
function vulkanStructureBufferCreateInfo() -> I32 { return I32(12) }
function vulkanStructureImageCreateInfo() -> I32 { return I32(14) }
function vulkanStructureImageViewCreateInfo() -> I32 { return I32(15) }
function vulkanStructureShaderModuleCreateInfo() -> I32 { return I32(16) }
function vulkanStructurePipelineShaderStageCreateInfo() -> I32 { return I32(18) }
function vulkanStructurePipelineVertexInputStateCreateInfo() -> I32 { return I32(19) }
function vulkanStructurePipelineInputAssemblyStateCreateInfo() -> I32 { return I32(20) }
function vulkanStructurePipelineViewportStateCreateInfo() -> I32 { return I32(22) }
function vulkanStructurePipelineRasterizationStateCreateInfo() -> I32 { return I32(23) }
function vulkanStructurePipelineMultisampleStateCreateInfo() -> I32 { return I32(24) }
function vulkanStructurePipelineDepthStencilStateCreateInfo() -> I32 { return I32(25) }
function vulkanStructurePipelineColorBlendStateCreateInfo() -> I32 { return I32(26) }
function vulkanStructurePipelineDynamicStateCreateInfo() -> I32 { return I32(27) }
function vulkanStructureGraphicsPipelineCreateInfo() -> I32 { return I32(28) }
function vulkanStructureComputePipelineCreateInfo() -> I32 { return I32(29) }
function vulkanStructurePipelineLayoutCreateInfo() -> I32 { return I32(30) }
function vulkanStructureSamplerCreateInfo() -> I32 { return I32(31) }
function vulkanStructureDescriptorSetLayoutCreateInfo() -> I32 { return I32(32) }
function vulkanStructureDescriptorPoolCreateInfo() -> I32 { return I32(33) }
function vulkanStructureDescriptorSetAllocateInfo() -> I32 { return I32(34) }
function vulkanStructureWriteDescriptorSet() -> I32 { return I32(35) }
function vulkanStructureCommandPoolCreateInfo() -> I32 { return I32(39) }
function vulkanStructureCommandBufferAllocateInfo() -> I32 { return I32(40) }
function vulkanStructureCommandBufferBeginInfo() -> I32 { return I32(42) }
function vulkanStructureRenderPassBeginInfo() -> I32 { return I32(43) }
function vulkanStructureFramebufferCreateInfo() -> I32 { return I32(37) }
function vulkanStructureSwapchainCreateInfo() -> I32 { return I32(1000001000) }
function vulkanStructurePresentInfo() -> I32 { return I32(1000001001) }
function vulkanStructurePipelineRenderingCreateInfo() -> I32 { return I32(1000044002) }
function vulkanStructureDynamicRenderingFeatures() -> I32 { return I32(1000044003) }
function vulkanStructureRenderingInfo() -> I32 { return I32(1000044000) }
function vulkanStructureRenderingAttachmentInfo() -> I32 { return I32(1000044001) }
function vulkanStructureWaylandSurfaceCreateInfo() -> I32 { return I32(1000006000) }
function vulkanStructureWin32SurfaceCreateInfo() -> I32 { return I32(1000009000) }

function vulkanApiVersion12() -> U32 { return U32(4202496) }
function vulkanQueueGraphics() -> U32 { return U32(1) }
function vulkanQueueCompute() -> U32 { return U32(2) }
function vulkanImageType2d() -> I32 { return I32(1) }
function vulkanImageViewType2d() -> I32 { return I32(1) }
function vulkanSharingExclusive() -> I32 { return I32(0) }
function vulkanCommandBufferPrimary() -> I32 { return I32(0) }
function vulkanCommandBufferOneTime() -> U32 { return U32(1) }
function vulkanCommandPoolResettable() -> U32 { return U32(2) }
function vulkanFenceSignaled() -> U32 { return U32(1) }
function vulkanSampleCount1() -> I32 { return I32(1) }
function vulkanPolygonFill() -> I32 { return I32(0) }
function vulkanCullNone() -> U32 { return U32(0) }
function vulkanCullFront() -> U32 { return U32(1) }
function vulkanCullBack() -> U32 { return U32(2) }
function vulkanFrontCounterClockwise() -> I32 { return I32(0) }
function vulkanFrontClockwise() -> I32 { return I32(1) }
function vulkanTopologyTriangleList() -> I32 { return I32(3) }
function vulkanTopologyTriangleStrip() -> I32 { return I32(4) }
function vulkanTopologyLineList() -> I32 { return I32(1) }
function vulkanInputRateVertex() -> I32 { return I32(0) }
function vulkanIndexUint16() -> I32 { return I32(0) }
function vulkanIndexUint32() -> I32 { return I32(1) }
function vulkanCompareNever() -> I32 { return I32(0) }
function vulkanCompareLess() -> I32 { return I32(1) }
function vulkanCompareLessEqual() -> I32 { return I32(3) }
function vulkanCompareEqual() -> I32 { return I32(2) }
function vulkanCompareGreaterEqual() -> I32 { return I32(6) }
function vulkanCompareGreater() -> I32 { return I32(4) }
function vulkanCompareAlways() -> I32 { return I32(7) }
function vulkanBlendZero() -> I32 { return I32(0) }
function vulkanBlendOne() -> I32 { return I32(1) }
function vulkanBlendSrcAlpha() -> I32 { return I32(6) }
function vulkanBlendOneMinusSrcAlpha() -> I32 { return I32(7) }
function vulkanBlendDstAlpha() -> I32 { return I32(8) }
function vulkanBlendOneMinusDstAlpha() -> I32 { return I32(9) }
function vulkanBlendAdd() -> I32 { return I32(0) }
function vulkanDescriptorSampler() -> I32 { return I32(0) }
function vulkanDescriptorCombinedImageSampler() -> I32 { return I32(1) }
function vulkanDescriptorSampledImage() -> I32 { return I32(2) }
function vulkanDescriptorStorageImage() -> I32 { return I32(3) }
function vulkanDescriptorUniformBuffer() -> I32 { return I32(8) }
function vulkanDescriptorStorageBuffer() -> I32 { return I32(9) }
function vulkanPipelineGraphics() -> I32 { return I32(0) }
function vulkanPipelineCompute() -> I32 { return I32(1) }
function vulkanFilterNearest() -> I32 { return I32(0) }
function vulkanFilterLinear() -> I32 { return I32(1) }
function vulkanSamplerAddressRepeat() -> I32 { return I32(0) }
function vulkanSamplerAddressClamp() -> I32 { return I32(2) }
function vulkanMipmapNearest() -> I32 { return I32(0) }
function vulkanMipmapLinear() -> I32 { return I32(1) }
function vulkanLoadLoad() -> I32 { return I32(0) }
function vulkanLoadClear() -> I32 { return I32(1) }
function vulkanLoadDontCare() -> I32 { return I32(2) }
function vulkanStoreStore() -> I32 { return I32(0) }
function vulkanStoreDontCare() -> I32 { return I32(1) }
function vulkanResolveNone() -> I32 { return I32(0) }
function vulkanSubpassInline() -> I32 { return I32(0) }

function vulkanFormatRgba8() -> I32 { return I32(37) }
function vulkanFormatBgra8() -> I32 { return I32(44) }
function vulkanFormatRgba16Float() -> I32 { return I32(97) }
function vulkanFormatR32Uint() -> I32 { return I32(98) }
function vulkanFormatDepth24Stencil8() -> I32 { return I32(129) }

function vulkanImageUsageTransferSource() -> U32 { return U32(1) }
function vulkanImageUsageTransferDestination() -> U32 { return U32(2) }
function vulkanImageUsageSampled() -> U32 { return U32(4) }
function vulkanImageUsageStorage() -> U32 { return U32(8) }
function vulkanImageUsageColorAttachment() -> U32 { return U32(16) }
function vulkanImageUsageDepthAttachment() -> U32 { return U32(32) }
function vulkanBufferUsageTransferSource() -> U32 { return U32(1) }
function vulkanBufferUsageTransferDestination() -> U32 { return U32(2) }
function vulkanBufferUsageUniform() -> U32 { return U32(16) }
function vulkanBufferUsageStorage() -> U32 { return U32(32) }
function vulkanBufferUsageIndex() -> U32 { return U32(64) }
function vulkanBufferUsageVertex() -> U32 { return U32(128) }
function vulkanBufferUsageIndirect() -> U32 { return U32(256) }
function vulkanMemoryHostVisible() -> U32 { return U32(2) }
function vulkanMemoryHostCoherent() -> U32 { return U32(4) }
function vulkanMemoryDeviceLocal() -> U32 { return U32(1) }
function vulkanImageLayoutUndefined() -> I32 { return I32(0) }
function vulkanImageLayoutGeneral() -> I32 { return I32(1) }
function vulkanImageLayoutColorAttachment() -> I32 { return I32(2) }
function vulkanImageLayoutDepthAttachment() -> I32 { return I32(3) }
function vulkanImageLayoutShaderRead() -> I32 { return I32(5) }
function vulkanImageLayoutTransferSource() -> I32 { return I32(6) }
function vulkanImageLayoutTransferDestination() -> I32 { return I32(7) }
function vulkanImageLayoutPresent() -> I32 { return I32(1000001002) }
function vulkanAspectColor() -> U32 { return U32(1) }
function vulkanAspectDepth() -> U32 { return U32(2) }
function vulkanAspectStencil() -> U32 { return U32(4) }
function vulkanStageTopOfPipe() -> U32 { return U32(1) }
function vulkanStageTransfer() -> U32 { return U32(4096) }
function vulkanStageFragmentShader() -> U32 { return U32(128) }
function vulkanStageComputeShader() -> U32 { return U32(2048) }
function vulkanStageColorAttachmentOutput() -> U32 { return U32(1024) }
function vulkanStageEarlyFragmentTests() -> U32 { return U32(256) }
function vulkanStageBottomOfPipe() -> U32 { return U32(8192) }
function vulkanAccessNone() -> U32 { return U32(0) }
function vulkanAccessTransferRead() -> U32 { return U32(2048) }
function vulkanAccessTransferWrite() -> U32 { return U32(4096) }
function vulkanAccessShaderRead() -> U32 { return U32(32) }
function vulkanAccessShaderWrite() -> U32 { return U32(64) }
function vulkanAccessColorAttachmentWrite() -> U32 { return U32(256) }
function vulkanAccessDepthStencilWrite() -> U32 { return U32(1024) }

function vulkanTextureFormat(format: borrow TextureFormat) -> I32 {
    match format {
        Rgba8Unorm -> return vulkanFormatRgba8()
        Rgba16Float -> return vulkanFormatRgba16Float()
        Depth24Stencil8 -> return vulkanFormatDepth24Stencil8()
        R32Uint -> return vulkanFormatR32Uint()
        Swapchain -> return vulkanFormatBgra8()
        None -> return I32(0)
    }
}

function vulkanVertexFormat(format: borrow VertexFormat) -> I32 {
    match format {
        Float -> return I32(100)
        Float2 -> return I32(103)
        Float3 -> return I32(106)
        Float4 -> return I32(109)
    }
}

function vulkanVertexFormatBytes(format: borrow VertexFormat) -> Int {
    match format {
        Float -> return 4
        Float2 -> return 8
        Float3 -> return 12
        Float4 -> return 16
    }
}

function vulkanBufferUsage(usage: borrow BufferUsage) -> U32 {
    let common = vulkanBufferUsageTransferDestination() | vulkanBufferUsageTransferSource()
    match usage {
        Vertex -> return common | vulkanBufferUsageVertex()
        Index -> return common | vulkanBufferUsageIndex()
        Uniform -> return common | vulkanBufferUsageUniform()
        Storage -> return common | vulkanBufferUsageStorage()
    }
}

function vulkanImageUsage(usage: borrow TextureUsage) -> U32 {
    match usage {
        Sampled -> return vulkanImageUsageTransferDestination() | vulkanImageUsageSampled()
        SampledStreaming -> return vulkanImageUsageTransferDestination() | vulkanImageUsageSampled()
        RenderTarget -> return vulkanImageUsageColorAttachment() | vulkanImageUsageTransferDestination() | vulkanImageUsageSampled()
        RenderTargetSampled -> return vulkanImageUsageColorAttachment() | vulkanImageUsageSampled() | vulkanImageUsageTransferDestination()
        DepthStencil -> return vulkanImageUsageDepthAttachment() | vulkanImageUsageSampled()
        SampledStorage -> return vulkanImageUsageSampled() | vulkanImageUsageStorage() | vulkanImageUsageTransferDestination()
    }
}

function vulkanImageAspectFor(usage: borrow TextureUsage) -> U32 {
    if usage == .DepthStencil {
        return vulkanAspectDepth() | vulkanAspectStencil()
    }
    return vulkanAspectColor()
}

function vulkanCompareFunction(compare: borrow CompareFunction) -> I32 {
    match compare {
        Never -> return vulkanCompareNever()
        Less -> return vulkanCompareLess()
        LessEqual -> return vulkanCompareLessEqual()
        Equal -> return vulkanCompareEqual()
        GreaterEqual -> return vulkanCompareGreaterEqual()
        Greater -> return vulkanCompareGreater()
        Always -> return vulkanCompareAlways()
    }
}

function vulkanCullMode(mode: borrow CullMode) -> U32 {
    match mode {
        None -> return vulkanCullNone()
        Front -> return vulkanCullFront()
        Back -> return vulkanCullBack()
    }
}

function vulkanFrontFace(face: borrow FrontFace) -> I32 {
    match face {
        CounterClockwise -> return vulkanFrontCounterClockwise()
        Clockwise -> return vulkanFrontClockwise()
    }
}

function vulkanTopology(topology: borrow PrimitiveTopology) -> I32 {
    match topology {
        TriangleList -> return vulkanTopologyTriangleList()
        TriangleStrip -> return vulkanTopologyTriangleStrip()
        LineList -> return vulkanTopologyLineList()
    }
}

function vulkanLoadOp(action: borrow LoadAction) -> I32 {
    match action {
        Clear -> return vulkanLoadClear()
        Load -> return vulkanLoadLoad()
        DontCare -> return vulkanLoadDontCare()
    }
}

function vulkanStoreOp(action: borrow StoreAction) -> I32 {
    match action {
        Store -> return vulkanStoreStore()
        DontCare -> return vulkanStoreDontCare()
    }
}

function vulkanSamplerFilter(filter: borrow TextureFilter) -> I32 {
    match filter {
        Nearest -> return vulkanFilterNearest()
        Linear -> return vulkanFilterLinear()
    }
}

function vulkanAddressMode(mode: borrow AddressMode) -> I32 {
    match mode {
        ClampToEdge -> return vulkanSamplerAddressClamp()
        Repeat -> return vulkanSamplerAddressRepeat()
    }
}
