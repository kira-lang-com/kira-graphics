// macOS host window + run loop for self-contained Metal apps, created from Kira via
// FFI (no shim). The backend creates an NSApplication, an NSWindow, and returns the
// window's content view; the Metal context attaches a CAMetalLayer to that view and
// drives draw/present each frame while the run loop is pumped between frames.
//
// (When the platform runner provides its own NSView/UIView, the backend skips this
// and attaches to the provided view instead — see metalContextAttachLayerToView.)

function metalWindowStyleMask() -> U64 { return 15 }
function metalWindowBackingBuffered() -> U64 { return 2 }
function metalActivationPolicyRegular() -> U64 { return 0 }

// Create the application + window and return the content view to render into.
@Native
function metalCreateWindow(width: Int, height: Int, title: borrow String) -> RawPtr {
    let app = metalMsgSend(metalObjcGetClass("NSApplication"), metalSel("sharedApplication"))
    metalMsgSendVoidU(app, metalSel("setActivationPolicy:"), metalActivationPolicyRegular())
    metalMsgSendVoidB(app, metalSel("activateIgnoringOtherApps:"), true)
    metalMsgSendVoid(app, metalSel("finishLaunching"))

    let windowAlloc = metalMsgSend(metalObjcGetClass("NSWindow"), metalSel("alloc"))
    let window = metalMsgSendInitWindow(windowAlloc, metalSel("initWithContentRect:styleMask:backing:defer:"), 120.0, 120.0, Float(width), Float(height), metalWindowStyleMask(), metalWindowBackingBuffered(), false)
    let nsTitle = metalMsgSendStr(metalObjcGetClass("NSString"), metalSel("stringWithUTF8String:"), title)
    metalMsgSendVoidP(window, metalSel("setTitle:"), nsTitle)
    metalMsgSendVoidP(window, metalSel("makeKeyAndOrderFront:"), metalObjcGetClass("NSObject"))
    return metalMsgSend(window, metalSel("contentView"))
}

// Pump the main run loop for `seconds` so Core Animation / timers run between frames.
@Native
function metalSpinRunLoop(seconds: F64) {
    let runloop = metalMsgSend(metalObjcGetClass("NSRunLoop"), metalSel("currentRunLoop"))
    let until = metalMsgSendDateInterval(metalObjcGetClass("NSDate"), metalSel("dateWithTimeIntervalSinceNow:"), seconds)
    metalMsgSendVoidP(runloop, metalSel("runUntilDate:"), until)
    return
}

// The shared NSApplication (singleton), used to dispatch the event queue each frame.
@Native
function metalSharedApp() -> RawPtr {
    return metalMsgSend(metalObjcGetClass("NSApplication"), metalSel("sharedApplication"))
}

// Cursor visibility on the native Metal window path (Sokol's sapp_show_mouse is a
// no-op here). `[NSCursor hide]`/`[NSCursor unhide]` are counted, so calls must be
// balanced — one hide per one unhide.
@Native
function metalSetCursorHidden(hidden: Bool) {
    let cls = metalObjcGetClass("NSCursor")
    if hidden {
        metalMsgSendVoid(cls, metalSel("hide"))
    } else {
        metalMsgSendVoid(cls, metalSel("unhide"))
        // Manual hide/unhide leaves the window's AUTOMATIC cursor rectangles
        // stale, so AppKit stops re-asserting the edge resize cursors (the frame
        // just shows the arrow). Invalidating them forces a rebuild on the next
        // pointer move, restoring the resize arrows at the window border.
        let app = metalSharedApp()
        let window = metalMsgSend(app, metalSel("keyWindow"))
        if metalPtrIsNull(window) == false {
            let view = metalMsgSend(window, metalSel("contentView"))
            metalMsgSendVoidP(window, metalSel("invalidateCursorRectsForView:"), view)
        }
    }
    return
}

// All event types (every real NSEvent type is a low bit; this covers bits 0-62, well
// above the highest NSEventType, standing in for NSEventMaskAny == NSUIntegerMax).
function metalEventMaskAny() -> U64 { return 9223372036854775807 }

// NSEventType values (AppKit stable ABI).
function metalNsLeftDown() -> Int { return 1 }
function metalNsLeftUp() -> Int { return 2 }
function metalNsRightDown() -> Int { return 3 }
function metalNsRightUp() -> Int { return 4 }
function metalNsMoved() -> Int { return 5 }
function metalNsLeftDragged() -> Int { return 6 }
function metalNsRightDragged() -> Int { return 7 }
function metalNsKeyDown() -> Int { return 10 }
function metalNsKeyUp() -> Int { return 11 }
function metalNsScroll() -> Int { return 22 }

// macOS virtual keycodes -> the neutral key codes the UI layer expects for the
// special keys it acts on (GLFW-style, matching the offscreen input scripts):
// Return / keypad-Enter -> 257 (submit), Delete/Backspace -> 259. Character keys
// keep their raw code (foundationKeyBit maps those to held-key bits) and ALSO
// emit a TextInput event carrying the typed codepoint (see metalPumpEvents).
function metalMapKeyCode(raw: Int) -> Int {
    if raw == 36 { return 257 }    // Return -> Enter (submit)
    if raw == 76 { return 257 }    // keypad Enter
    if raw == 51 { return 259 }    // Delete -> Backspace
    if raw == 123 { return 263 }   // Left arrow
    if raw == 124 { return 262 }   // Right arrow
    if raw == 125 { return 264 }   // Down arrow
    if raw == 126 { return 265 }   // Up arrow
    if raw == 115 { return 268 }   // Home
    if raw == 119 { return 269 }   // End
    if raw == 117 { return 261 }   // Forward Delete
    if raw == 53 { return 256 }    // Escape
    return raw
}
function metalNsOtherDown() -> Int { return 25 }
function metalNsOtherUp() -> Int { return 26 }
function metalNsOtherDragged() -> Int { return 27 }

// KVC fetch of a geometry/scalar property into a caller buffer: -valueForKey:
// boxes NSPoint/NSRect/CGFloat as NSValue/NSNumber (a pointer return, which
// marshals), and -getValue: writes the raw doubles into `buf`. A null boxed
// value leaves the buffer's first slot zeroed so stale reads decode to 0.
@Native
function metalKvcValueInto(obj: RawPtr, key: RawPtr, buf: RawPtr) {
    metalMemWriteU64(buf, 0, 0)
    metalMemWriteU64(buf, 8, 0)
    metalMemWriteU64(buf, 16, 0)
    metalMemWriteU64(buf, 24, 0)
    let value = metalMsgSendP(obj, metalSel("valueForKey:"), key)
    if metalPtrIsNull(value) {
        return
    }
    metalMsgSendVoidP(value, metalSel("getValue:"), buf)
    return
}

// Modifier state from -[NSEvent modifierFlags] (bit 17 shift, 18 control,
// 19 option, 20 command), extracted with div/mod (no bitwise ops needed).
@Native
function metalModifiersFromFlags(flags: Int) -> GraphicsModifierState {
    return GraphicsModifierState {
        shift: (flags / 131072) - ((flags / 131072) / 2) * 2 == 1
        control: (flags / 262144) - ((flags / 262144) / 2) * 2 == 1
        alt: (flags / 524288) - ((flags / 524288) / 2) * 2 == 1
        superKey: (flags / 1048576) - ((flags / 1048576) / 2) * 2 == 1
    }
}

// Translate one queued NSEvent into a GraphicsEvent (kind None when the event
// carries nothing for the app). Pointer coordinates convert from window space
// (bottom-left origin, points) to view-local top-left via the content view's
// bounds height.
@Native
function metalTranslateEvent(event: RawPtr, view: RawPtr) -> GraphicsEvent {
    let etype = Int(metalMsgSendU64(event, metalSel("type")))
    var kind = GraphicsEventKind.None
    var button = GraphicsPointerButton.None
    var isPointer = false
    if etype == metalNsLeftDown() {
        kind = GraphicsEventKind.PointerDown
        button = GraphicsPointerButton.Left
        isPointer = true
    }
    if etype == metalNsLeftUp() {
        kind = GraphicsEventKind.PointerUp
        button = GraphicsPointerButton.Left
        isPointer = true
    }
    if etype == metalNsRightDown() {
        kind = GraphicsEventKind.PointerDown
        button = GraphicsPointerButton.Right
        isPointer = true
    }
    if etype == metalNsRightUp() {
        kind = GraphicsEventKind.PointerUp
        button = GraphicsPointerButton.Right
        isPointer = true
    }
    if etype == metalNsOtherDown() {
        kind = GraphicsEventKind.PointerDown
        button = GraphicsPointerButton.Middle
        isPointer = true
    }
    if etype == metalNsOtherUp() {
        kind = GraphicsEventKind.PointerUp
        button = GraphicsPointerButton.Middle
        isPointer = true
    }
    if etype == metalNsMoved() {
        kind = GraphicsEventKind.PointerMoved
        isPointer = true
    }
    if etype == metalNsLeftDragged() {
        kind = GraphicsEventKind.PointerMoved
        button = GraphicsPointerButton.Left
        isPointer = true
    }
    if etype == metalNsRightDragged() {
        kind = GraphicsEventKind.PointerMoved
        button = GraphicsPointerButton.Right
        isPointer = true
    }
    if etype == metalNsOtherDragged() {
        kind = GraphicsEventKind.PointerMoved
        button = GraphicsPointerButton.Middle
        isPointer = true
    }
    if etype == metalNsScroll() {
        kind = GraphicsEventKind.Scroll
        isPointer = true
    }
    let flags = Int(metalMsgSendU64(event, metalSel("modifierFlags")))
    if isPointer {
        // Geometry through KVC + NSValue/NSNumber -getValue: into a buffer:
        // direct CGRect/NSPoint/CGFloat message RETURNS do not marshal across
        // the FFI (they read back as garbage — the same gap the viewport sync
        // in MetalContext works around; see metalContextSyncViewportFromView).
        let buf = metalMemAlloc(32)
        let locKey = metalMsgSendStr(metalObjcGetClass("NSString"), metalSel("stringWithUTF8String:"), "locationInWindow")
        metalKvcValueInto(event, locKey, buf)
        let locX = metalDoubleBitsToFloat(metalMemReadU64(buf, 0))
        let locY = metalDoubleBitsToFloat(metalMemReadU64(buf, 8))
        let boundsKey = metalMsgSendStr(metalObjcGetClass("NSString"), metalSel("stringWithUTF8String:"), "bounds")
        metalKvcValueInto(view, boundsKey, buf)
        let boundsH = metalDoubleBitsToFloat(metalMemReadU64(buf, 24))
        var sx = 0.0
        var sy = 0.0
        if etype == metalNsScroll() {
            let sxKey = metalMsgSendStr(metalObjcGetClass("NSString"), metalSel("stringWithUTF8String:"), "scrollingDeltaX")
            metalKvcValueInto(event, sxKey, buf)
            sx = metalDoubleBitsToFloat(metalMemReadU64(buf, 0))
            let syKey = metalMsgSendStr(metalObjcGetClass("NSString"), metalSel("stringWithUTF8String:"), "scrollingDeltaY")
            metalKvcValueInto(event, syKey, buf)
            sy = metalDoubleBitsToFloat(metalMemReadU64(buf, 0))
        }
        metalMemFree(buf)
        return GraphicsEvent {
            kind: kind
            pointerButton: button
            pointerX: locX
            pointerY: boundsH - locY
            scrollX: sx
            scrollY: sy
            modifiers: metalModifiersFromFlags(flags)
        }
    }
    if etype == metalNsKeyDown() {
        let rawKey = Int(metalMsgSendU64(event, metalSel("keyCode")))
        let cmdHeld = (flags / 1048576) - ((flags / 1048576) / 2) * 2 == 1
        var mappedKey = metalMapKeyCode(rawKey)
        // Cmd+A ('A' is mac keyCode 0) -> synthetic Select-All (300) so a focused
        // field selects its whole text instead of inserting 'a' / strafing.
        if cmdHeld && rawKey == 0 {
            mappedKey = 300
        }
        return GraphicsEvent {
            kind: GraphicsEventKind.KeyDown
            keyCode: mappedKey
            keyRepeat: metalMsgSendBoolEmpty(event, metalSel("isARepeat"))
            modifiers: metalModifiersFromFlags(flags)
        }
    }
    if etype == metalNsKeyUp() {
        return GraphicsEvent {
            kind: GraphicsEventKind.KeyUp
            keyCode: metalMapKeyCode(Int(metalMsgSendU64(event, metalSel("keyCode"))))
            modifiers: metalModifiersFromFlags(flags)
        }
    }
    return GraphicsEvent {
        kind: GraphicsEventKind.None
    }
}

// Dispatch every pending NSEvent. Running the bare NSRunLoop only services run-loop
// SOURCES; it does not dequeue NSApplication's event queue or call -sendEvent:, so
// without this the window never receives mouse/keyboard/resize events — it never
// becomes the active key window (its traffic lights stay greyed) and the resize
// control does nothing. Each event is ALSO translated into a GraphicsEvent and
// RETURNED to the caller (pointer, scroll, keys): the caller owns the app's event
// handler closure, which must be bound exactly once — moving it into this function
// per frame would free its captured environment after the first pump and later
// events would dispatch through a dangling capture (observed as an abort inside
// nativeRecover). The window still gets -sendEvent: for activation/title-bar
// behavior, except key-downs (kept from the window so the unhandled-key beep
// never fires).
@Native
function metalPumpEvents(app: RawPtr, view: RawPtr) -> [GraphicsEvent] {
    var out: [GraphicsEvent] = []
    let distantPast = metalMsgSend(metalObjcGetClass("NSDate"), metalSel("distantPast"))
    let mode = metalMsgSendStr(metalObjcGetClass("NSString"), metalSel("stringWithUTF8String:"), "kCFRunLoopDefaultMode")
    var draining = true
    while draining {
        let event = metalMsgSendNextEvent(app, metalSel("nextEventMatchingMask:untilDate:inMode:dequeue:"), metalEventMaskAny(), distantPast, mode, true)
        if metalPtrIsNull(event) {
            draining = false
        } else {
            let translated = metalTranslateEvent(event, view)
            if translated.kind != GraphicsEventKind.None {
                out.append(move translated)
            }
            let etype = Int(metalMsgSendU64(event, metalSel("type")))
            if etype != metalNsKeyDown() {
                metalMsgSendVoidP(app, metalSel("sendEvent:"), event)
            }
            // A key-down that produces a character also emits a TextInput event
            // (after the KeyDown), so focused fields receive typed text. Return,
            // Delete etc. carry non-printable characters and are skipped here —
            // they drive submit/backspace through the KeyDown path above.
            var cmdDown = false
            if etype == metalNsKeyDown() {
                let mflags = Int(metalMsgSendU64(event, metalSel("modifierFlags")))
                cmdDown = (mflags / 1048576) - ((mflags / 1048576) / 2) * 2 == 1
            }
            if etype == metalNsKeyDown() && cmdDown == false {
                let chars = metalMsgSend(event, metalSel("characters"))
                if !metalPtrIsNull(chars) {
                    if metalMsgSendU64(chars, metalSel("length")) > 0 {
                        let utf8 = metalMsgSend(chars, metalSel("UTF8String"))
                        if !metalPtrIsNull(utf8) {
                            let raw8 = metalMemReadU64(utf8, 0)
                            let b0 = raw8 - (raw8 / 256) * 256
                            if b0 >= 32 && b0 < 127 {
                                out.append(GraphicsEvent {
                                    kind: GraphicsEventKind.TextInput
                                    textCodepoint: Int(b0)
                                })
                            }
                        }
                    }
                }
            }
        }
    }
    return move out
}

// State the live-resize delegate needs: only the Metal context. The delegate
// must NOT render by calling the app's frame closure: closures do not survive
// repeated extraction from nativeState — the first -windowDidResize: consumed
// the captured environment and every later tick of the drag rendered through a
// dangling capture (the long-standing resize SIGSEGV). The delegate now only
// keeps the drawable size in sync while AppKit's modal resize-tracking loop
// blocks the frame loop; content scales during the drag and the main loop
// renders the properly re-laid-out frame the moment the drag ends.
struct MetalLiveState {
    var ctx: RawPtr
}

// The -windowDidResize: IMP. AppKit posts this repeatedly while the user drags
// the window edge — inside its modal resize-tracking loop, where the manual
// Kira frame loop is blocked.
@Native
function metalResizeImp(selfObj: RawPtr, cmd: RawPtr, notification: RawPtr): Void {
    let value = metalObjcGetAssociatedObject(selfObj, metalSel("kiraLiveState"))
    if metalPtrIsNull(value) {
        return
    }
    let statePtr = metalMsgSend(value, metalSel("pointerValue"))
    if metalPtrIsNull(statePtr) {
        return
    }
    var state = nativeRecover<MetalLiveState>(statePtr)
    metalContextSyncViewportFromView(state.ctx)
    return
}

// Build (once) an NSWindowDelegate class whose -windowDidResize: is the Kira IMP
// above, instantiate it, associate the live state with it, and set it as the window's
// delegate. OBJC_ASSOCIATION_RETAIN_NONATOMIC = 1 keeps the NSValue (and thus the
// state) alive for the app's lifetime.
@Native
function metalInstallResizeDelegate(window: RawPtr, statePtr: RawPtr) {
    var cls = metalObjcGetClass("KiraMetalResizeDelegate")
    if metalPtrIsNull(cls) {
        cls = metalObjcAllocateClassPair(metalObjcGetClass("NSObject"), "KiraMetalResizeDelegate", 0)
        let added = metalClassAddMethod(cls, metalSel("windowDidResize:"), metalResizeImp, "v@:@")
        let ignored = added
        metalObjcRegisterClassPair(cls)
    }
    let delegate = metalMsgSend(metalMsgSend(cls, metalSel("alloc")), metalSel("init"))
    let value = metalMsgSendP(metalObjcGetClass("NSValue"), metalSel("valueWithPointer:"), statePtr)
    metalObjcSetAssociatedObject(delegate, metalSel("kiraLiveState"), value, 1)
    metalMsgSendVoidP(window, metalSel("setDelegate:"), delegate)
    return
}

// Whether the content view's window is still on screen (false once closed).
@Native
function metalViewWindowVisible(view: RawPtr) -> Bool {
    let window = metalMsgSend(view, metalSel("window"))
    if metalPtrIsNull(window) {
        return false
    }
    return metalMsgSendBoolEmpty(window, metalSel("isVisible"))
}
