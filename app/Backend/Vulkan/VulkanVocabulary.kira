public function vulkanTextureFormat(format: borrow TextureFormat) -> I32 {
    match format {
        Rgba8Unorm -> return vulkanFormatRgba8()
        Rgba16Float -> return vulkanFormatRgba16Float()
        Depth24Stencil8 -> return vulkanFormatDepth24Stencil8()
        R32Uint -> return vulkanFormatR32Uint()
        Swapchain -> return vulkanFormatBgra8()
        None -> return I32(0)
    }
}

public function vulkanVertexFormat(format: borrow VertexFormat) -> I32 {
    match format {
        Float -> return I32(100)
        Float2 -> return I32(103)
        Float3 -> return I32(106)
        Float4 -> return I32(109)
    }
}

public function vulkanVertexFormatBytes(format: borrow VertexFormat) -> Int {
    match format {
        Float -> return 4
        Float2 -> return 8
        Float3 -> return 12
        Float4 -> return 16
    }
}

public function vulkanBufferUsage(usage: borrow BufferUsage) -> U32 {
    let common = vulkanBufferUsageTransferDestination() | vulkanBufferUsageTransferSource()
    match usage {
        Vertex -> return common | vulkanBufferUsageVertex()
        Index -> return common | vulkanBufferUsageIndex()
        Uniform -> return common | vulkanBufferUsageUniform()
        Storage -> return common | vulkanBufferUsageStorage()
    }
}

public function vulkanImageUsage(usage: borrow TextureUsage) -> U32 {
    match usage {
        Sampled -> return vulkanImageUsageTransferDestination() | vulkanImageUsageSampled()
        SampledStreaming -> return vulkanImageUsageTransferDestination() | vulkanImageUsageSampled()
        RenderTarget -> return vulkanImageUsageColorAttachment() | vulkanImageUsageTransferDestination() | vulkanImageUsageSampled()
        RenderTargetSampled -> return vulkanImageUsageColorAttachment() | vulkanImageUsageSampled() | vulkanImageUsageTransferDestination()
        DepthStencil -> return vulkanImageUsageDepthAttachment() | vulkanImageUsageSampled()
        SampledStorage -> return vulkanImageUsageSampled() | vulkanImageUsageStorage() | vulkanImageUsageTransferDestination()
    }
}

public function vulkanImageAspectFor(usage: borrow TextureUsage) -> U32 {
    if usage == .DepthStencil {
        return vulkanAspectDepth() | vulkanAspectStencil()
    }
    return vulkanAspectColor()
}

public function vulkanCompareFunction(compare: borrow CompareFunction) -> I32 {
    match compare {
        Never -> return vulkanCompareNever()
        Less -> return vulkanCompareLess()
        LessEqual -> return vulkanCompareLessEqual()
        Equal -> return vulkanCompareEqual()
        GreaterEqual -> return vulkanCompareGreaterEqual()
        Greater -> return vulkanCompareGreater()
        Always -> return vulkanCompareAlways()
    }
}

public function vulkanCullMode(mode: borrow CullMode) -> U32 {
    match mode {
        None -> return vulkanCullNone()
        Front -> return vulkanCullFront()
        Back -> return vulkanCullBack()
    }
}

public function vulkanFrontFace(face: borrow FrontFace) -> I32 {
    match face {
        CounterClockwise -> return vulkanFrontCounterClockwise()
        Clockwise -> return vulkanFrontClockwise()
    }
}

public function vulkanTopology(topology: borrow PrimitiveTopology) -> I32 {
    match topology {
        TriangleList -> return vulkanTopologyTriangleList()
        TriangleStrip -> return vulkanTopologyTriangleStrip()
        LineList -> return vulkanTopologyLineList()
    }
}

public function vulkanLoadOp(action: borrow LoadAction) -> I32 {
    match action {
        Clear -> return vulkanLoadClear()
        Load -> return vulkanLoadLoad()
        DontCare -> return vulkanLoadDontCare()
    }
}

public function vulkanStoreOp(action: borrow StoreAction) -> I32 {
    match action {
        Store -> return vulkanStoreStore()
        DontCare -> return vulkanStoreDontCare()
    }
}

public function vulkanSamplerFilter(filter: borrow TextureFilter) -> I32 {
    match filter {
        Nearest -> return vulkanFilterNearest()
        Linear -> return vulkanFilterLinear()
    }
}

public function vulkanAddressMode(mode: borrow AddressMode) -> I32 {
    match mode {
        ClampToEdge -> return vulkanSamplerAddressClamp()
        Repeat -> return vulkanSamplerAddressRepeat()
    }
}
