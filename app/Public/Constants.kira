// What is left of the constant tables.
//
// This file held 54 more functions like `textureFormatRgba8Unorm() -> Int`: a C
// `#define` table typed out longhand, which let `format: 7` compile and gave a
// reader nothing to match against. They are enums now — see `Formats.kira` and
// `PassVocabulary.kira` — and each carries the wire code the backends speak.
//
// What stays here is what is genuinely a number rather than a closed set.

@Native
function uniformSlotScene() -> Int {
    return 0
}

@Native
function uniformSlotObject() -> Int {
    return 1
}
