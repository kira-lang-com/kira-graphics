// Builds a `GraphicsShader` from what shader creation reports back.
//
// The reflection fields — `hasPositionAttribute`, `requiredUniformMask`,
// `uniformBlocks`, and so on — used to live in the Sokol backend's own
// `kg_shader_records` table, keyed by shader id. They live on the
// `GraphicsShader` value itself now, copied straight out of the `KgShaderInfo`
// creation returned; a later pipeline built from this shader copies them
// again onto the `RenderPipeline` (see `SokolPipeline.kira`), so nothing ever
// needs to look a shader id back up.
@Native
function sokolShaderFromInfo(info: borrow KgShaderInfo) -> GraphicsShader {
    return GraphicsShader {
        id: info.id
        hasPositionAttribute: info.has_position_attribute != 0
        hasNormalAttribute: info.has_normal_attribute != 0
        requiredUniformMask: Int(info.required_uniform_mask)
        availableUniformMask: Int(info.available_uniform_mask)
        uniformBlocks: sokolUniformBlocksFromSlots(info.blocks, Int(info.uniform_desc_count))
    }
}

@Native
function sokolCreateShaderId(label: borrow String, vertexSource: borrow String, fragmentSource: borrow String, vertexPath: borrow String, fragmentPath: borrow String) -> GraphicsShader {
    return sokolShaderFromInfo(kgMakeShader(label, vertexSource, fragmentSource, vertexPath, fragmentPath))
}

@Native
function sokolCreateShaderFromKslId(label: borrow String, asset: borrow String, directory: borrow String) -> GraphicsShader {
    return sokolShaderFromInfo(kgMakeKslShader(label, asset, directory))
}

// Create a shader straight from inline `ksl!` KslArtifact sources. The native
// helper selects WGSL (WebGPU/wasm) or GLSL (desktop GL) and applies the KSL
// stage entry-point names; no shader files are read from disk.
@Native
function sokolCreateShaderKslInlineId(label: borrow String, vertexWgsl: borrow String, fragmentWgsl: borrow String, vertexGlsl: borrow String, fragmentGlsl: borrow String, vertexEntry: borrow String, fragmentEntry: borrow String, resourceReflection: borrow String) -> GraphicsShader {
    return sokolShaderFromInfo(kgMakeShaderKslInline(label, vertexWgsl, fragmentWgsl, vertexGlsl, fragmentGlsl, vertexEntry, fragmentEntry, resourceReflection))
}

@Native
function sokolDestroyShaderId(shaderId: U32): Void {
    if (shaderId != 0) {
        kgDestroyShaderId(shaderId)
    }
    return
}
