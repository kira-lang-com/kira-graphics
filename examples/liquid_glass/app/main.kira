import KiraGraphics
import Foundation

struct LiquidGlassState {
    var backgroundShader: GraphicsShader
    var blurHorizontalShader: GraphicsShader
    var blurVerticalShader: GraphicsShader
    var compositeShader: GraphicsShader
    var backgroundPipeline: RenderPipeline
    var blurHorizontalPipeline: RenderPipeline
    var blurVerticalPipeline: RenderPipeline
    var compositePipeline: RenderPipeline
    var vertices: GraphicsBuffer
    var backgroundTexture: GraphicsTexture
    var sceneTarget: GraphicsTexture
    var blurIntermediate: GraphicsTexture
    var blurFinal: GraphicsTexture
    var sampler: GraphicsSampler
    var backgroundBindings: BindGroup
    var sceneBindings: BindGroup
    var blurIntermediateBindings: BindGroup
    var compositeBindings: BindGroup
}

function fullScreenVertices() -> [F32] {
    return [
        -1.0, -1.0,
        3.0, -1.0,
        -1.0, 3.0
    ]
}

function fullScreenLayout() -> VertexLayout {
    return VertexLayout {
        stride: 8
        attributes: [
            VertexAttribute {
                name: "position"
                location: 0
                format: VertexFormat.Float2
                offset: 0
            }
        ]
    }
}

function makePipeline(graphics: borrow Graphics, label: String, shader: GraphicsShader, colorFormat: TextureFormat, depthFormat: TextureFormat) -> RenderPipeline {
    return pipelineOrReport(graphics.createRenderPipeline(RenderPipelineDescriptor {
        label: label
        shader: shader
        vertexLayout: fullScreenLayout()
        colorTargets: [
            ColorTargetDescriptor {
                format: colorFormat
                blend: BlendState {
                    enabled: false
                    preset: BlendPreset.Replace
                }
            }
        ]
        depthStencil: DepthStencilDescriptor {
            depthEnabled: false
            depthWriteEnabled: false
            depthCompare: CompareFunction.Always
            format: depthFormat
        }
        rasterization: RasterizationDescriptor {
            cullMode: CullMode.None
            frontFace: FrontFace.CounterClockwise
        }
        primitive: PrimitiveDescriptor {
            topology: PrimitiveTopology.TriangleList
        }
    }), "create render pipeline")
}

function texturePass(label: String, texture: GraphicsTexture) -> RenderPassDescriptor {
    return RenderPassDescriptor {
        label: label
        colorAttachments: [
            ColorAttachment {
                target: RenderTarget {
                    kind: RenderTargetKind.Texture
                    texture: texture
                    mipLevel: 0
                    arrayLayer: 0
                }
                loadAction: LoadAction.Clear
                storeAction: StoreAction.Store
                clearColor: Color {
                    r: 0.0
                    g: 0.0
                    b: 0.0
                    a: 1.0
                }
                resolveTarget: emptyRenderTarget()
                hasResolveTarget: false
            }
        ]
        primaryColorAttachment: ColorAttachment {
            target: RenderTarget {
                kind: RenderTargetKind.Texture
                texture: texture
                mipLevel: 0
                arrayLayer: 0
            }
            loadAction: LoadAction.Clear
            storeAction: StoreAction.Store
            clearColor: Color {
                r: 0.0
                g: 0.0
                b: 0.0
                a: 1.0
            }
            resolveTarget: emptyRenderTarget()
            hasResolveTarget: false
        }
        hasPrimaryColorAttachment: true
        depthAttachment: emptyDepthAttachment()
        hasDepthAttachment: false
        stencilAttachment: emptyStencilAttachment()
        hasStencilAttachment: false
    }
}

function renderLiquidPass(frame: borrow mut RenderFrame, pass: RenderPassDescriptor, pipeline: RenderPipeline, vertices: GraphicsBuffer) {
    let encoder = frame.beginRenderPass(pass)
    encoder.setPipeline(pipeline)
    encoder.setVertexBuffer(vertices)
    encoder.draw(3)
    frame.endPass()
    return
}

function renderBoundPass(frame: borrow mut RenderFrame, pass: RenderPassDescriptor, pipeline: RenderPipeline, vertices: GraphicsBuffer, bindings: BindGroup) {
    let encoder = frame.beginRenderPass(pass)
    encoder.setPipeline(pipeline)
    encoder.setVertexBuffer(vertices)
    encoder.setBindGroup(0, bindings)
    encoder.draw(3)
    frame.endPass()
    return
}

@Main
@Native
function main() {
    var app = GraphicsApplication {
        title: "Kira Graphics Liquid Glass"
        width: 1600
        height: 900
        sampleCount: 1
    }
    let state = nativeState(LiquidGlassState {
        backgroundShader: emptyGraphicsShader()
        blurHorizontalShader: emptyGraphicsShader()
        blurVerticalShader: emptyGraphicsShader()
        compositeShader: emptyGraphicsShader()
        backgroundPipeline: emptyRenderPipeline()
        blurHorizontalPipeline: emptyRenderPipeline()
        blurVerticalPipeline: emptyRenderPipeline()
        compositePipeline: emptyRenderPipeline()
        vertices: emptyGraphicsBuffer()
        backgroundTexture: emptyGraphicsTexture()
        sceneTarget: emptyGraphicsTexture()
        blurIntermediate: emptyGraphicsTexture()
        blurFinal: emptyGraphicsTexture()
        sampler: emptyGraphicsSampler()
        backgroundBindings: emptyBindGroup()
        sceneBindings: emptyBindGroup()
        blurIntermediateBindings: emptyBindGroup()
        compositeBindings: emptyBindGroup()
    })

    app.onInit { graphics in
        var liquid = nativeRecover<LiquidGlassState>(graphics.userData)
        liquid.vertices = bufferOrReport(graphics.createBuffer(BufferDescriptor {
            label: "liquid-glass-fullscreen-triangle"
            usage: BufferUsage.Vertex
            data: fullScreenVertices()
        }), "vertices")
        liquid.backgroundTexture = textureOrReport(graphics.createTextureFromFile("liquid-glass-cubes", "assets/background-cubes.jpg"), "liquid-glass backdrop")
        liquid.sceneTarget = textureOrReport(graphics.createTexture(TextureDescriptor {
            label: "liquid-glass-scene"
            width: 1600
            height: 900
            format: TextureFormat.Rgba8Unorm
            usage: TextureUsage.RenderTargetSampled
            sampleCount: 1
            storage: AttachmentStorage.Persistent
        }), "liquid-glass scene target")
        liquid.blurIntermediate = textureOrReport(graphics.createTexture(TextureDescriptor {
            label: "liquid-glass-blur-intermediate"
            width: 800
            height: 450
            format: TextureFormat.Rgba8Unorm
            usage: TextureUsage.RenderTargetSampled
            sampleCount: 1
            storage: AttachmentStorage.Persistent
        }), "liquid-glass blur intermediate")
        liquid.blurFinal = textureOrReport(graphics.createTexture(TextureDescriptor {
            label: "liquid-glass-blur-final"
            width: 800
            height: 450
            format: TextureFormat.Rgba8Unorm
            usage: TextureUsage.RenderTargetSampled
            sampleCount: 1
            storage: AttachmentStorage.Persistent
        }), "liquid-glass blur target")
        liquid.sampler = samplerOrReport(graphics.createSampler(SamplerDescriptor {
            label: "liquid-glass-linear-sampler"
            minFilter: TextureFilter.Linear
            magFilter: TextureFilter.Linear
            addressModeU: AddressMode.ClampToEdge
            addressModeV: AddressMode.ClampToEdge
        }), "sampler")
        liquid.backgroundShader = shaderOrReport(graphics.createShaderFromKsl(KslShaderDescriptor {
            label: "liquid-glass-background-shader"
            asset: "LiquidGlassBackground"
        }), "background shader")
        liquid.blurHorizontalShader = shaderOrReport(graphics.createShaderFromKsl(KslShaderDescriptor {
            label: "liquid-glass-blur-horizontal-shader"
            asset: "LiquidGlassBlurHorizontal"
        }), "blur horizontal shader")
        liquid.blurVerticalShader = shaderOrReport(graphics.createShaderFromKsl(KslShaderDescriptor {
            label: "liquid-glass-blur-vertical-shader"
            asset: "LiquidGlassBlurVertical"
        }), "blur vertical shader")
        liquid.compositeShader = shaderOrReport(graphics.createShaderFromKsl(KslShaderDescriptor {
            label: "liquid-glass-composite-shader"
            asset: "LiquidGlassComposite"
        }), "composite shader")
        liquid.backgroundPipeline = makePipeline(graphics, "liquid-glass-background", liquid.backgroundShader, TextureFormat.Rgba8Unorm, TextureFormat.None)
        liquid.blurHorizontalPipeline = makePipeline(graphics, "liquid-glass-blur-horizontal", liquid.blurHorizontalShader, TextureFormat.Rgba8Unorm, TextureFormat.None)
        liquid.blurVerticalPipeline = makePipeline(graphics, "liquid-glass-blur-vertical", liquid.blurVerticalShader, TextureFormat.Rgba8Unorm, TextureFormat.None)
        liquid.compositePipeline = makePipeline(graphics, "liquid-glass-composite", liquid.compositeShader, TextureFormat.Swapchain, TextureFormat.None)
        // Every slot is the resource's position in its `.ksl` group, which is
        // what a shader's reflection reports and what a backend binds against.
        // `Shaders/LiquidGlassBackground.ksl` and the two blur shaders declare
        // `texture tex0` then `sampler smp0`, so the sampler is slot 1, not a
        // second slot 0 in a space of its own.
        liquid.backgroundBindings = bindGroupOrReport(graphics.createTextureSamplerBindGroup("liquid-glass-background-bindings", 0, liquid.backgroundTexture, 1, liquid.sampler), "background bindings")
        liquid.sceneBindings = bindGroupOrReport(graphics.createTextureSamplerBindGroup("liquid-glass-scene-bindings", 0, liquid.sceneTarget, 1, liquid.sampler), "scene bindings")
        liquid.blurIntermediateBindings = bindGroupOrReport(graphics.createTextureSamplerBindGroup("liquid-glass-blur-intermediate-bindings", 0, liquid.blurIntermediate, 1, liquid.sampler), "blur intermediate bindings")
        liquid.compositeBindings = bindGroupOrReport(graphics.createBindGroup(BindGroupDescriptor {
            label: "liquid-glass-composite-bindings"
            uniformEntries: []
            textureEntries: [
                TextureBindEntry {
                    textureSlot: 0
                    texture: liquid.sceneTarget
                },
                TextureBindEntry {
                    textureSlot: 1
                    texture: liquid.blurFinal
                }
            ]
            samplerEntries: [
                // `Shaders/LiquidGlassComposite.ksl` declares tex0, tex1, smp0,
                // smp1 in that order, so the samplers are slots 2 and 3.
                SamplerBindEntry {
                    samplerSlot: 2
                    sampler: liquid.sampler
                },
                SamplerBindEntry {
                    samplerSlot: 3
                    sampler: liquid.sampler
                }
            ]
        }), "composite bindings")
        return
    }

    app.onFrame { frame in
        var liquid = nativeRecover<LiquidGlassState>(frame.userData)
        renderBoundPass(frame, texturePass("liquid-glass-scene-pass", liquid.sceneTarget), liquid.backgroundPipeline, liquid.vertices, liquid.backgroundBindings)
        renderBoundPass(frame, texturePass("liquid-glass-blur-horizontal-pass", liquid.blurIntermediate), liquid.blurHorizontalPipeline, liquid.vertices, liquid.sceneBindings)
        renderBoundPass(frame, texturePass("liquid-glass-blur-vertical-pass", liquid.blurFinal), liquid.blurVerticalPipeline, liquid.vertices, liquid.blurIntermediateBindings)
        renderBoundPass(frame, clearSwapchainRenderPass(Color {
            r: 0.0
            g: 0.0
            b: 0.0
            a: 1.0
        }), liquid.compositePipeline, liquid.vertices, liquid.compositeBindings)
        return
    }

    app.onCleanup { graphics in
        var liquid = nativeRecover<LiquidGlassState>(graphics.userData)
        graphics.destroyBindGroup(liquid.compositeBindings)
        graphics.destroyBindGroup(liquid.blurIntermediateBindings)
        graphics.destroyBindGroup(liquid.sceneBindings)
        graphics.destroyBindGroup(liquid.backgroundBindings)
        graphics.destroySampler(liquid.sampler)
        graphics.destroyTexture(liquid.blurFinal)
        graphics.destroyTexture(liquid.blurIntermediate)
        graphics.destroyTexture(liquid.sceneTarget)
        graphics.destroyTexture(liquid.backgroundTexture)
        graphics.destroyBuffer(liquid.vertices)
        graphics.destroyRenderPipeline(liquid.compositePipeline)
        graphics.destroyRenderPipeline(liquid.blurVerticalPipeline)
        graphics.destroyRenderPipeline(liquid.blurHorizontalPipeline)
        graphics.destroyRenderPipeline(liquid.backgroundPipeline)
        graphics.destroyShader(liquid.compositeShader)
        graphics.destroyShader(liquid.blurVerticalShader)
        graphics.destroyShader(liquid.blurHorizontalShader)
        graphics.destroyShader(liquid.backgroundShader)
        return
    }

    app.run(nativeUserData(state))
    return
}
