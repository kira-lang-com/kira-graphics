// Foreign surface for the Metal backend.
//
// Kira Graphics' Metal backend drives Metal, QuartzCore and AppKit/UIKit DIRECTLY
// through the Objective-C runtime — there is no C/Objective-C shim. Every native
// capability is reached as an `@FFI.Extern` here: the Objective-C runtime
// (objc_getClass / sel_registerName / objc_msgSend), the one Metal C entry point
// (MTLCreateSystemDefaultDevice), and the kira_runtime raw-memory helpers used to
// build small by-reference structs (MTLRegion/MTLClearColor are handled inline as
// scalar arguments) and to read pixels back.
//
// objc_msgSend is not variadic on arm64: each call must use the exact signature of
// the target method. We therefore declare one typed alias per call SHAPE we use,
// all bound to the single C symbol `objc_msgSend`. The Kira compiler shares one
// LLVM global across these aliases (see the FFI dedup in kira_llvm_backend), and
// the VM/libffi path binds each call by its own signature, so this is sound on both
// the native and hybrid backends.

// ---------------------------------------------------------------------------
// Objective-C runtime primitives
// ---------------------------------------------------------------------------

// Decouple the hardware mouse from the on-screen cursor. While disassociated the
// cursor stays exactly where it was and stops leaving the window, but delta
// events keep arriving — which is what a look-drag needs. Re-associating puts
// the two back together, with the cursor still under the user's hand, so no warp
// is needed on either edge. CoreGraphics, reached through AppKit's link.
@FFI.Extern { library: kira_metal; symbol: CGAssociateMouseAndMouseCursorPosition; abi: c; }
function metalAssociateMouseAndCursor(connected: Bool): I32;

@FFI.Extern { library: kira_metal; symbol: objc_getClass; abi: c; }
function metalObjcGetClass(name: CString): RawPtr;

@FFI.Extern { library: kira_metal; symbol: sel_registerName; abi: c; }
function metalSel(name: CString): RawPtr;

// Writes a C string and a newline to stdout. The one way to surface text the
// Objective-C runtime hands back as `char*` — an `NSError`'s description, say —
// without a round trip through a Kira `String` this seam has no conversion for.
@FFI.Extern { library: kira_metal; symbol: puts; abi: c; }
function metalPutsRaw(text: RawPtr): Void;

// ---------------------------------------------------------------------------
// objc_msgSend, one typed alias per call shape
// ---------------------------------------------------------------------------

// () -> id / void
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSend(obj: RawPtr, op: RawPtr): RawPtr;
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendVoid(obj: RawPtr, op: RawPtr): Void;
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendU64(obj: RawPtr, op: RawPtr): U64;
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendBoolEmpty(obj: RawPtr, op: RawPtr): Bool;

// (id) -> id / void
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendP(obj: RawPtr, op: RawPtr, a: RawPtr): RawPtr;
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendVoidP(obj: RawPtr, op: RawPtr, a: RawPtr): Void;

// (NSUInteger) -> id / void
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendPU(obj: RawPtr, op: RawPtr, a: U64): RawPtr;
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendVoidU(obj: RawPtr, op: RawPtr, a: U64): Void;

// MTLTextureDescriptor texture2DDescriptorWithPixelFormat:width:height:mipmapped:
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendTexDesc(cls: RawPtr, op: RawPtr, pixelFormat: U64, width: U64, height: U64, mipmapped: Bool): RawPtr;

// (BOOL) -> void  (e.g. CAMetalLayer setFramebufferOnly:)
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendVoidB(obj: RawPtr, op: RawPtr, a: Bool): Void;

// setDrawableSize: — CGSize is a two-double HFA, passed as two F64 scalars.
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendVoid2F(obj: RawPtr, op: RawPtr, w: F64, h: F64): Void;

// (double) -> void  (e.g. MTLRenderPassDepthAttachmentDescriptor setClearDepth:)
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendVoidF(obj: RawPtr, op: RawPtr, value: F64): Void;

// setClearColor: — MTLClearColor is an HFA of four doubles, passed as four F64
// scalars (same v0-v3 registers on arm64), so no by-value struct is needed.
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendVoid4F(obj: RawPtr, op: RawPtr, r: F64, g: F64, b: F64, a: F64): Void;

// (NSRect, BOOL) -> void — e.g. -[NSWindow setFrame:display:]. The rect is an
// HFA of four doubles in v0-v3, the BOOL rides in w2.
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendVoidRectB(obj: RawPtr, op: RawPtr, x: F64, y: F64, w: F64, h: F64, display: Bool): Void;

// getBytes:bytesPerRow:fromRegion:mipmapLevel: — MTLRegion (>16 bytes, not an HFA)
// is passed by reference per AAPCS64, so `region` is a pointer to a 48-byte buffer.
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendGetBytes(obj: RawPtr, op: RawPtr, bytes: RawPtr, bytesPerRow: U64, region: RawPtr, mipLevel: U64): Void;

// (CString) -> id  — used for +[NSString stringWithUTF8String:]
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendStr(obj: RawPtr, op: RawPtr, s: CString): RawPtr;

// () -> CGRect  — e.g. -[NSView bounds]. CGRect is an HFA of four doubles (origin.x,
// origin.y, size.width, size.height), returned in v0-v3 per AAPCS64, so it maps to a
// four-F64 struct return (no objc_msgSend_stret on arm64 for HFAs).
@FFI.Struct { layout: c; }
struct MetalCGRect {
    var x: F64
    var y: F64
    var width: F64
    var height: F64
}
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendCGRect(obj: RawPtr, op: RawPtr): MetalCGRect;

// () -> NSPoint — e.g. -[NSEvent locationInWindow]. Two-double HFA returned in
// v0/v1. ALSO used for scalar CGFloat returns (-scrollingDeltaY,
// -backingScaleFactor): the callee returns the scalar in v0, so `.x` is the
// value and `.y` is register garbage — the FFI has no scalar-double return.
@FFI.Struct { layout: c; }
struct MetalNSPoint {
    var x: F64
    var y: F64
}
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendPoint(obj: RawPtr, op: RawPtr): MetalNSPoint;

// (CGRect) -> CGRect  — e.g. -[NSView convertRectToBacking:]. The argument CGRect is
// an HFA-of-4-doubles passed as four F64 scalars (v0-v3, like setClearColor:), and the
// result is the same four-F64 struct. Used to get physical (backing) pixel sizes
// without a scalar-double return (which the FFI does not marshal).
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendRectToBacking(obj: RawPtr, op: RawPtr, x: F64, y: F64, w: F64, h: F64): MetalCGRect;

// (id, id) -> id  — e.g. newRenderPipelineStateWithDescriptor:error:
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendPP(obj: RawPtr, op: RawPtr, a: RawPtr, b: RawPtr): RawPtr;

// (id, id, id) -> id  — e.g. newLibraryWithSource:options:error:
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendPPP(obj: RawPtr, op: RawPtr, a: RawPtr, b: RawPtr, c: RawPtr): RawPtr;

// (id, id) -> void — e.g. dispatchThreadgroups:threadsPerThreadgroup:, where each
// MTLSize (3x NSUInteger = 24 bytes > 16) is passed indirectly (by pointer) per the
// arm64 AAPCS, so a caller-built MTLSize in memory is passed as a plain pointer arg.
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendVoidPP(obj: RawPtr, op: RawPtr, a: RawPtr, b: RawPtr): Void;

// newBufferWithBytes:length:options: -> id
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendNewBuffer(obj: RawPtr, op: RawPtr, bytes: RawPtr, length: U64, options: U64): RawPtr;

// newBufferWithLength:options: -> id
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendNewBufferLength(obj: RawPtr, op: RawPtr, length: U64, options: U64): RawPtr;

// setFragmentBuffer:offset:atIndex:
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendSetFragmentBuffer(obj: RawPtr, op: RawPtr, buffer: RawPtr, offset: U64, index: U64): Void;

// (id, NSUInteger) -> void  (setFragmentTexture:atIndex: / setFragmentSamplerState:atIndex:)
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendVoidPU(obj: RawPtr, op: RawPtr, a: RawPtr, index: U64): Void;

// replaceRegion:mipmapLevel:withBytes:bytesPerRow: — MTLRegion passed by reference.
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendReplaceRegion(obj: RawPtr, op: RawPtr, region: RawPtr, mipLevel: U64, bytes: RawPtr, bytesPerRow: U64): Void;

// setVertexBuffer:offset:atIndex:
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendSetVertexBuffer(obj: RawPtr, op: RawPtr, buffer: RawPtr, offset: U64, index: U64): Void;

// drawPrimitives:vertexStart:vertexCount:
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendDrawPrimitives(obj: RawPtr, op: RawPtr, primitiveType: U64, vertexStart: U64, vertexCount: U64): Void;

// drawPrimitives:vertexStart:vertexCount:instanceCount:
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendDrawPrimitivesInstanced(obj: RawPtr, op: RawPtr, primitiveType: U64, vertexStart: U64, vertexCount: U64, instanceCount: U64): Void;

// drawPrimitives:indirectBuffer:indirectBufferOffset: — the argument buffer holds
// MTLDrawPrimitivesIndirectArguments {vertexCount, instanceCount, vertexStart,
// baseInstance} (4x u32), written by a compute pass (GPU-driven draws).
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendDrawPrimitivesIndirect(obj: RawPtr, op: RawPtr, primitiveType: U64, indirectBuffer: RawPtr, indirectOffset: U64): Void;

// drawIndexedPrimitives:indexCount:indexType:indexBuffer:indexBufferOffset:
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendDrawIndexed(obj: RawPtr, op: RawPtr, primitiveType: U64, indexCount: U64, indexType: U64, indexBuffer: RawPtr, indexBufferOffset: U64): Void;

// NSWindow initWithContentRect:styleMask:backing:defer: — the content rect is a
// CGRect (HFA of four doubles -> four F64 scalars), then NSUInteger style/backing
// and a BOOL defer flag.
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendInitWindow(obj: RawPtr, op: RawPtr, x: F64, y: F64, w: F64, h: F64, style: U64, backing: U64, deferCreation: Bool): RawPtr;

// (double) -> id  (e.g. +[NSDate dateWithTimeIntervalSinceNow:])
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendDateInterval(obj: RawPtr, op: RawPtr, seconds: F64): RawPtr;

// -[NSApplication nextEventMatchingMask:untilDate:inMode:dequeue:] -> NSEvent*
// (NSEventMask is unsigned long long; the mode is an NSRunLoopMode NSString).
@FFI.Extern { library: kira_metal; symbol: objc_msgSend; abi: c; }
function metalMsgSendNextEvent(obj: RawPtr, op: RawPtr, mask: U64, untilDate: RawPtr, mode: RawPtr, dequeue: Bool): RawPtr;

// Objective-C autorelease pool (C functions in libobjc). The Metal shader compiler
// and NSString helpers create many autoreleased temporaries; without a pool that is
// undefined behaviour, so resource creation runs inside push/pop.
@FFI.Extern { library: kira_metal; symbol: objc_autoreleasePoolPush; abi: c; }
function metalAutoreleasePoolPush(): RawPtr;
@FFI.Extern { library: kira_metal; symbol: objc_autoreleasePoolPop; abi: c; }
function metalAutoreleasePoolPop(token: RawPtr): Void;

// ---------------------------------------------------------------------------
// Objective-C runtime class construction — used to build an NSWindowDelegate whose
// -windowDidResize: (an IMP that is a Kira @Native function, the same way the Sokol
// callbacks are Kira functions) renders a frame DURING AppKit's modal live-resize
// loop, where the manual Kira frame loop is otherwise blocked.
// ---------------------------------------------------------------------------

@FFI.Extern { library: kira_metal; symbol: objc_allocateClassPair; abi: c; }
function metalObjcAllocateClassPair(superclass: RawPtr, name: CString, extraBytes: U64): RawPtr;
@FFI.Extern { library: kira_metal; symbol: objc_registerClassPair; abi: c; }
function metalObjcRegisterClassPair(cls: RawPtr): Void;
@FFI.Extern { library: kira_metal; symbol: objc_setAssociatedObject; abi: c; }
function metalObjcSetAssociatedObject(obj: RawPtr, key: RawPtr, value: RawPtr, policy: U64): Void;
@FFI.Extern { library: kira_metal; symbol: objc_getAssociatedObject; abi: c; }
function metalObjcGetAssociatedObject(obj: RawPtr, key: RawPtr): RawPtr;

// The IMP signature for -windowDidResize: is void(id self, SEL _cmd, NSNotification*).
@FFI.Callback { abi: c; params: [RawPtr, RawPtr, RawPtr]; result: Void; }
struct metalImpCallback {}

@FFI.Extern { library: kira_metal; symbol: class_addMethod; abi: c; }
function metalClassAddMethod(cls: RawPtr, name: RawPtr, imp: metalImpCallback, types: CString): Bool;

// ---------------------------------------------------------------------------
// Metal C entry point (the only non-Objective-C Metal symbol)
// ---------------------------------------------------------------------------

@FFI.Extern { library: kira_metal; symbol: MTLCreateSystemDefaultDevice; abi: c; }
function metalCreateSystemDefaultDevice(): RawPtr;

// libc getenv — used to select the headless offscreen path for verification.
@FFI.Extern { library: kira_metal; symbol: getenv; abi: c; }
function metalGetEnv(name: CString): RawPtr;

// libc file I/O — full-framebuffer dump for visual verification
// (KIRA_METAL_IMAGE_DUMP). `fopen`'s path arrives as the RawPtr getenv returned,
// so no CString round-trip is needed; fclose's int result is ignored (Void keeps
// the FFI boundary to pointer/U64 marshalling only).
@FFI.Extern { library: kira_metal; symbol: fopen; abi: c; }
function metalFOpen(path: RawPtr, mode: CString): RawPtr;
@FFI.Extern { library: kira_metal; symbol: fwrite; abi: c; }
function metalFWrite(ptr: RawPtr, size: U64, count: U64, stream: RawPtr): U64;
@FFI.Extern { library: kira_metal; symbol: fclose; abi: c; }
function metalFClose(stream: RawPtr): Void;

// clock_gettime_nsec_np — monotonic time in nanoseconds as a uint64_t, the
// frame-timing clock for the on-screen run loop (drives the live FPS readout). An
// INTEGER-return clock is used deliberately: a C function returning `double` hands the
// value back in a floating-point register, which the FFI boundary does not marshal, so
// CACurrentMediaTime-style seconds would read back as 0. CLOCK_UPTIME_RAW == 8.
@FFI.Extern { library: kira_metal; symbol: clock_gettime_nsec_np; abi: c; }
function metalClockNs(clockId: U32): U64;
function metalClockUptimeRaw() -> U32 { return 8 }

// ---------------------------------------------------------------------------
// kira_runtime raw memory helpers (build by-reference structs, read pixels)
// ---------------------------------------------------------------------------

@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_alloc; abi: c; }
function metalMemAlloc(size: U64): RawPtr;
@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_free; abi: c; }
function metalMemFree(ptr: RawPtr): Void;
@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_write_u64_at; abi: c; }
function metalMemWriteU64(ptr: RawPtr, offset: U64, value: U64): Void;
@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_write_ptr_at; abi: c; }
function metalMemWritePtr(ptr: RawPtr, offset: U64, value: RawPtr): Void;
@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_read_ptr_at; abi: c; }
function metalMemReadPtr(ptr: RawPtr, offset: U64): RawPtr;
@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_read_u8_at; abi: c; }
function metalMemReadU8(ptr: RawPtr, offset: U64): U8;
@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_read_u32_at; abi: c; }
function metalMemReadU32(ptr: RawPtr, offset: U64): U32;
@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_read_u64_at; abi: c; }
function metalMemReadU64(ptr: RawPtr, offset: U64): U64;
@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_write_f32_at; abi: c; }
function metalMemWriteF32(ptr: RawPtr, offset: U64, value: F32): Void;
@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_write_u32_at; abi: c; }
function metalMemWriteU32(ptr: RawPtr, offset: U64, value: U32): Void;
@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_write_u8_at; abi: c; }
function metalMemWriteU8(ptr: RawPtr, offset: U64, value: U8): Void;
@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_null_ptr; abi: c; }
function metalNullPtr(): RawPtr;
@FFI.Extern { library: kira_runtime; symbol: kira_dynamic_ptr_is_null; abi: c; }
function metalPtrIsNull(ptr: RawPtr): Bool;
