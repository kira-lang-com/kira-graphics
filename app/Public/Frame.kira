import Foundation
// One frame of rendering, from the caller's side.
//
// The frame holds two things and nothing else: what its current pass is
// attached to (`attachments`, see `PassAttachments.kira`) and where it is in
// its own life — whether a pass was begun, whether one is still open, the
// encoder that pass handed out, and whether the application asked to quit.
//
// Everything a backend does with a frame it does through `renderBackend()`.
class RenderFrame {
    var attachments: PassAttachments

    var hasRenderPass: Bool = false
    var renderPassActive: Bool = false
    var currentEncoder: RenderEncoder
    var passSubmitted: Bool = false
    var shouldQuit: Bool = false
    var userData: RawPtr
    var backend: RenderBackendKind = .Sokol
    var backendContext: RawPtr

    // The backend this frame belongs to, as a value that answers rather than as
    // a tag to switch on. See `RenderBackend.kira`.
    function renderBackend() -> Any RenderBackend {
        return renderBackendFor(self.backend, self.backendContext)
    }

    // Nanoseconds on a monotonic clock — what a host times its own frame with.
    //
    // Asked of the frame for the same reason `framesInFlight` is: reading a
    // clock is a platform call, and a host that named one platform's clock
    // directly would refuse to start on every other.
    function monotonicNanoseconds() -> U64 {
        return self.renderBackend().monotonicNanoseconds()
    }

    // How many frames this backend keeps in flight — the depth of its pacing
    // ring, and what a telemetry readout means by "frames in flight".
    //
    // Asked of the frame rather than imported from a backend's own module, so a
    // caller that only wants the number does not have to name the backend that
    // happens to answer it.
    function framesInFlight() -> Int {
        return self.renderBackend().framesInFlight()
    }

    // The live viewport in logical points — what a UI lays out and hit-tests
    // against. Both backends answer; neither is named at the call site.
    function viewportWidth() -> Float {
        return self.renderBackend().viewportWidth()
    }

    function viewportHeight() -> Float {
        return self.renderBackend().viewportHeight()
    }

    // The drawable in DEVICE pixels, and how many of them one point buys.
    //
    // A viewport in points already divides one by the other, so a caller that
    // wants to divide them differently — anything rendering at a scale other
    // than the display's — needs both numbers rather than their quotient.
    function drawableWidth() -> Int {
        return self.renderBackend().contextWidth()
    }

    function drawableHeight() -> Int {
        return self.renderBackend().contextHeight()
    }

    function backingScale() -> Float {
        return self.renderBackend().backingScale()
    }

    // How the window is presented, and moving it to another mode. This is where
    // a library reaches fullscreen from: the frame is what an event handler and
    // a render pass both already hold, and neither has to name a backend.
    //
    // Read rather than remembered — a user can leave fullscreen through the
    // window manager without the program hearing about it — so this is also the
    // way to find out whether a `setWindowMode` request was honoured.
    function windowMode() -> WindowMode {
        return self.renderBackend().windowMode()
    }

    function setWindowMode(mode: borrow WindowMode) -> Void {
        self.renderBackend().setWindowMode(mode)
        return
    }

    // What the frame BEFORE this one cost. An application lays its HUD out
    // while the frame the HUD will appear in is still being built, so the last
    // completed frame is what there is to report.
    function statistics() -> FrameStatistics {
        return self.renderBackend().statistics()
    }

    function beginRenderPass(descriptor: borrow RenderPassDescriptor) -> RenderEncoder {
        var colorAttachment = descriptor.primaryColorAttachment
        var hasColor = descriptor.hasPrimaryColorAttachment
        if (!hasColor) {
            if (descriptor.colorAttachments.count > 0) {
                colorAttachment = descriptor.colorAttachments[0]
                hasColor = true
            }
        }
        self.attachments = PassAttachments {
            hasColor: hasColor
            color: move colorAttachment
            hasDepth: descriptor.hasDepthAttachment
            depth: descriptor.depthAttachment
            hasStencil: descriptor.hasStencilAttachment
            stencil: descriptor.stencilAttachment
        }
        self.hasRenderPass = true
        self.passSubmitted = false
        self.renderPassActive = self.renderBackend().beginRenderPass(self)

        if (!self.renderPassActive) {
            graphicsDiagnostic("Kira Graphics skipped render pass because the backend could not begin it")
        }

        // The previous encoder (the initial placeholder from Graphics.frame(), or
        // the placeholder installed by the last endPass) is never used again once
        // a new pass begins; release its native state before overwriting it.
        nativeStateFree(self.currentEncoder.storage)
        let encoder = self.renderBackend().makeEncoder(self.renderPassActive)
        self.currentEncoder = encoder
        return encoder
    }

    function endPass() {
        self.passSubmitted = true
        if (self.renderPassActive) {
            self.renderBackend().endPassAndCommit(self)
        }
        self.renderPassActive = false
        // The pass is committed: encoder handles returned by beginRenderPass are
        // dead from here on. Release the pass encoder's native state before
        // installing the fresh placeholder that keeps currentEncoder recoverable.
        nativeStateFree(self.currentEncoder.storage)
        self.currentEncoder = makeRenderEncoder()
        return
    }

    // Run a two-axis separable blur over `mix(source, secondSource, blend)`, one
    // dispatch per axis.
    //
    // Both kernels produce two levels at once — near and far read the same
    // input and write their own target — so the pyramid costs one dispatch per
    // axis rather than one per level. The horizontal half writes the two temps;
    // the vertical half reads them and writes the two outputs.
    //
    // The horizontal half reads two images and blends them as it filters. A blur
    // is linear, so filtering the blend costs what filtering one image costs and
    // saves the caller compositing a crossfade into a third full-resolution
    // texture the filter would then read at a quarter of that resolution. One
    // image is the same call with the texture passed twice and `blend` 0.
    //
    // Textures rather than ids, because the two backends bind different things:
    // Metal binds the texture object, and sokol binds a *view* — a sampled one
    // for what the kernel reads and a storage-image one for what it writes, and
    // neither can be recovered from an image id.
    function dispatchTextureComputePair(
        horizontalPipeline: Int,
        verticalPipeline: Int,
        source: borrow GraphicsTexture,
        secondSource: borrow GraphicsTexture,
        blend: Float,
        tempNear: borrow GraphicsTexture,
        tempFar: borrow GraphicsTexture,
        outputNear: borrow GraphicsTexture,
        outputFar: borrow GraphicsTexture,
        // The kernels sample through this rather than declaring a sampler
        // inline, which is not something a compute stage can express.
        sampler: borrow GraphicsSampler,
        width: Int,
        height: Int,
    ) {
        self.renderBackend().dispatchTextureComputePair(
            horizontalPipeline,
            verticalPipeline,
            source,
            secondSource,
            blend,
            tempNear,
            tempFar,
            outputNear,
            outputFar,
            sampler,
            width,
            height,
        )
        return
    }

    // One dispatch over buffers, encoded on this frame's command buffer.
    //
    // On the frame rather than on `Graphics` when the step belongs to a frame's
    // ordering: a step that has to land between two passes needs the frame, and
    // the frame is what a caller holds at that point.
    function dispatchComputeBuffers(pipeline: Int, bufferIds: borrow [U32], threadCount: Int, threadsPerGroup: Int) {
        self.renderBackend().dispatchComputeBuffers(pipeline, bufferIds, threadCount, threadsPerGroup)
        return
    }

    // The same dispatch with this pass's DEPTH attachment bound ahead of the
    // buffers, for a kernel that reads the depth the frame just rasterized —
    // seeding a Hi-Z pyramid is what needs it.
    //
    // The texture comes from the frame's own attachments rather than from an
    // argument, because the depth such a kernel wants is the depth the pass
    // wrote, and a caller passing it separately can only get that wrong.
    function dispatchDepthComputeBuffers(pipeline: Int, bufferIds: borrow [U32], threadCount: Int, threadsPerGroup: Int) {
        self.renderBackend().dispatchDepthComputeBuffers(
            pipeline,
            self.attachments.depth.texture,
            bufferIds,
            threadCount,
            threadsPerGroup,
        )
        return
    }

    // One 32-bit word out of a buffer a kernel dispatched on this frame has
    // written — what a gate checks after stepping. A backend that cannot read a
    // buffer back answers 0 and says so.
    function readStorageU32(buffer: borrow GraphicsBuffer, index: Int) -> U32 {
        return self.renderBackend().readBufferU32(buffer, index)
    }

    // Put a texture a compute pass has just written back into the layout later
    // samples read fastest, ordered after everything already encoded this frame.
    // Called on the outputs of `dispatchTextureComputePair`, which are the
    // textures it exists to repair. What that costs is the backend's answer:
    // a blit on Metal, nothing under GL, and each says so in its own body.
    function optimizeTexture(textureId: Int) {
        self.renderBackend().optimizeTexture(textureId)
        return
    }

    function renderPass(descriptor: borrow RenderPassDescriptor, body: (RenderEncoder) -> Void) {
        let encoder = beginRenderPass(descriptor)
        let callbackEncoder = encoder
        body(move callbackEncoder)
        endPass()
        return
    }

    function beginPass(clearColor: borrow Color) -> RenderEncoder {
        return beginRenderPass(clearSwapchainRenderPass(clearColor))
    }

    function pass(clearColor: borrow Color, body: (RenderEncoder) -> Void) {
        renderPass(clearSwapchainRenderPass(clearColor), move body)
        return
    }

    function requestQuit() {
        self.shouldQuit = true
        return
    }
}

function drawPass(frame: borrow mut RenderFrame, descriptor: borrow RenderPassDescriptor, pipeline: borrow RenderPipeline, vertexBuffer: borrow GraphicsBuffer, vertexCount: Int) {
    var encoder = frame.beginRenderPass(descriptor)
    encoder.setPipeline(pipeline)
    encoder.setVertexBuffer(vertexBuffer)
    encoder.draw(vertexCount)
    frame.endPass()
    return
}

function drawPassWithBindGroups(frame: borrow mut RenderFrame, descriptor: borrow RenderPassDescriptor, pipeline: borrow RenderPipeline, vertexBuffer: borrow GraphicsBuffer, bindGroup0: borrow BindGroup, bindGroup1: borrow BindGroup, vertexCount: Int) {
    var encoder = frame.beginRenderPass(descriptor)
    encoder.setPipeline(pipeline)
    encoder.setVertexBuffer(vertexBuffer)
    encoder.setBindGroup(0, bindGroup0)
    encoder.setBindGroup(1, bindGroup1)
    encoder.draw(vertexCount)
    frame.endPass()
    return
}
