function sokolBeginRenderPass(frame: borrow RenderFrame) -> Bool {
    if (!frame.attachments.hasColor) {
        graphicsDiagnostic("Kira Graphics skipped render pass because the pass descriptor has no color attachments")
        return false
    }

    return sokolBeginPass(frame)
}

function sokolBeginRenderPassFromFrame(frame: borrow RenderFrame) -> Bool {
    // Counted here rather than in `sokolBeginRenderPass`, which the submit
    // fallback also calls for a pass a caller began by hand.
    sokolNotePass(frame.backendContext)
    // Before the pass, not after: a target is stored in the order a sampler
    // reads, and a pass that loads one needs it in the order the rasterizer
    // writes (see `SokolRowOrder.kira`).
    sokolRestoreRowsForLoad(frame)
    return sokolBeginRenderPass(frame)
}

// End the pass, then put its colour target back into the row order every
// sampler reads. The correction follows the commit because it is a compute pass
// of its own, and a pass cannot begin inside another.
@Native
function sokolEndPassAndCommitFromFrame(frame: borrow RenderFrame) {
    sokolEndPassAndCommit(frame.backendContext)
    sokolNormalizeRowsAfterPass(frame)
    return
}

// A fallback for a frame whose caller never called `endPass()` itself: begins
// and immediately ends an empty pass so the frame's declared attachments are
// not simply dropped. Every current caller — `frame.pass`/`renderPass` and the
// `drawPass*` helpers — already calls `endPass()` before this runs, which
// leaves `frame.passSubmitted` true and this whole body unreached but for the
// quit check; kept for a caller that begins a pass by hand and forgets to end
// it.
function sokolSubmitFrame(frame: borrow RenderFrame): Void {
    if (frame.passSubmitted) {
        if (frame.shouldQuit) {
            sokolRequestQuitNative()
        }
        return
    }

    if (!frame.hasRenderPass) {
        return
    }

    sokolRestoreRowsForLoad(frame)
    if (!sokolBeginRenderPass(frame)) {
        if (frame.shouldQuit) {
            sokolRequestQuitNative()
        }
        return
    }

    sokolEndPassAndCommitFromFrame(frame)

    if (frame.shouldQuit) {
        sokolRequestQuitNative()
    }
    return
}

@Native
function sokolRequestQuitNative() {
    sapp_request_quit()
    return
}
