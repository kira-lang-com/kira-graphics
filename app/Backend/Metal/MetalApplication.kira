// Kira Graphics Metal backend — application lifecycle.
//
// This backend talks to Metal, QuartzCore and AppKit/UIKit DIRECTLY through
// Kira FFI (the Objective-C runtime: objc_getClass / sel_registerName /
// objc_msgSend, plus MTLCreateSystemDefaultDevice). There is no C/Objective-C
// shim: every native call is an `@FFI.Extern` to a system symbol, invoked from
// Kira. The `NativeLibs/Metal.toml` library carries only framework linkage.
//
// By default this opens a real on-screen window with a CAMetalLayer and runs the
// app's frame loop. Setting KIRA_METAL_OFFSCREEN renders one frame to an offscreen
// target and reads the center pixel back instead, for deterministic headless
// verification (the kik Test harness asserts pixels through the same paths via the
// MetalSelfTest entry points).

@Native
function metalRunApplication(app: borrow GraphicsApplication, runtimeUserData: RawPtr): Void {
    // One autorelease pool around the whole run; per-frame pools drain inside the
    // loop. The Metal shader compiler and Foundation helpers create many autoreleased
    // temporaries, and draining them at well-defined points keeps resource creation
    // deterministic and bounds memory over a long-running window.
    let pool = metalAutoreleasePoolPush()
    let ctxPtr = metalContextAlloc()

    // The recovered runtime state only carries the user pointer; lifecycle handlers
    // come directly from the borrowed application (closures captured in the app do
    // not survive the nativeState round-trip on the hybrid backend, but the borrowed
    // `app` retains them intact).
    var state = nativeRecover<GraphicsAppRuntimeState>(runtimeUserData)
    let userData = state.userData

    let offscreenEnv = metalGetEnv("KIRA_METAL_OFFSCREEN")
    if !metalPtrIsNull(offscreenEnv) {
        metalContextAttachOffscreenFormat(ctxPtr, app.width, app.height, metalPixelFormatForTexture(app.colorFormat))
        kiraGraphicsLiveBackendInitialized()

        let onInitOffscreen: (Graphics) -> Void = app.initHandler
        let initGraphicsOffscreen = Graphics {
            userData: userData
            backend: GraphicsBackend.Metal
            metalContext: ctxPtr
        }
        onInitOffscreen(move initGraphicsOffscreen)

        let onFrameOffscreen: (borrow mut GraphicsFrame) -> Void = app.frameHandler

        // Deterministic frame-time benchmark: KIRA_METAL_BENCH runs the frame handler
        // many times offscreen and reports average ms + implied FPS, so VM hot-path
        // optimisation can be measured without the on-screen present/vsync loop.
        let benchEnv = metalGetEnv("KIRA_METAL_BENCH")
        if !metalPtrIsNull(benchEnv) {
            let benchFrames = 180
            // KIRA_METAL_RESIZE_BENCH cycles the offscreen size each frame so the app
            // sees a changing viewport every frame — exercising the resize/rebuild path
            // (no damage-skip) instead of the static re-present path. Re-attaching the
            // offscreen target only allocates a native MTLTexture, so the Kira struct
            // allocation count still reflects the per-frame rebuild work.
            let resizeEnv = metalGetEnv("KIRA_METAL_RESIZE_BENCH")
            let resizeBench = !metalPtrIsNull(resizeEnv)
            // Warm up one frame (first-touch caches, retained tree mount) before timing.
            let warmGraphics = Graphics {
                userData: userData
                backend: GraphicsBackend.Metal
                metalContext: ctxPtr
            }
            var warmFrame = warmGraphics.frame()
            onFrameOffscreen(warmFrame)
            graphicsSubmitFrame(warmFrame)
            let startNs = metalClockNs(metalClockUptimeRaw())
            var bi = 0
            while bi < benchFrames {
                if resizeBench {
                    metalContextAttachOffscreen(ctxPtr, app.width + (bi % 120), app.height)
                }
                let benchGraphics = Graphics {
                    userData: userData
                    backend: GraphicsBackend.Metal
                    metalContext: ctxPtr
                }
                var benchFrame = benchGraphics.frame()
                onFrameOffscreen(benchFrame)
                graphicsSubmitFrame(benchFrame)
                bi = bi + 1
            }
            let endNs = metalClockNs(metalClockUptimeRaw())
            metalReportBench(Int(endNs - startNs), benchFrames)
            metalContextFree(ctxPtr)
            metalAutoreleasePoolPop(pool)
            return
        }

        let frameGraphicsOffscreen = Graphics {
            userData: userData
            backend: GraphicsBackend.Metal
            metalContext: ctxPtr
        }
        var frameOffscreen = frameGraphicsOffscreen.frame()
        onFrameOffscreen(frameOffscreen)
        graphicsSubmitFrame(frameOffscreen)
        metalReportCenterPixel(ctxPtr, app.width, app.height)
        let probeEnv = metalGetEnv("KIRA_METAL_READBACK_POINTS")
        if !metalPtrIsNull(probeEnv) {
            metalReportProbePixels(ctxPtr, app.width, app.height)
        }
        let digestEnv = metalGetEnv("KIRA_METAL_IMAGE_DIGEST")
        if !metalPtrIsNull(digestEnv) {
            metalReportImageDigest(ctxPtr, app.width, app.height)
        }
        metalContextFree(ctxPtr)
        metalAutoreleasePoolPop(pool)
        return
    }

    // On-screen: create a window + CAMetalLayer, run the frame loop until the app
    // requests quit or the window is closed.
    let view = metalCreateWindow(app.width, app.height, app.title)
    metalContextAttachLayerToView(ctxPtr, view, app.width, app.height)
    let nsApp = metalSharedApp()
    kiraGraphicsLiveBackendInitialized()

    let onInit: (Graphics) -> Void = app.initHandler
    let initGraphics = Graphics {
        userData: userData
        backend: GraphicsBackend.Metal
        metalContext: ctxPtr
    }
    onInit(move initGraphics)

    let onFrame: (borrow mut GraphicsFrame) -> Void = app.frameHandler

    // Install a window-resize delegate so the UI reflows LIVE during a drag. While the
    // user drags the window edge, AppKit runs a modal resize-tracking loop inside
    // -sendEvent: that blocks this loop; the delegate's -windowDidResize: fires inside
    // that modal loop and renders frames at the changing size. The live state carries
    // the frame handler captured here.
    let liveStorage = nativeState(MetalLiveState {
        ctx: ctxPtr
        userData: userData
        onFrame: app.frameHandler
    })
    let liveHandle = nativeUserData(liveStorage)
    let hostWindow = metalMsgSend(view, metalSel("window"))
    if !metalPtrIsNull(hostWindow) {
        metalInstallResizeDelegate(hostWindow, liveHandle)
    }

    var running = true
    while running {
        let framePool = metalAutoreleasePoolPush()
        // Dispatch queued window/input events first (activation, title-bar buttons,
        // live resize), then pick up any resulting new window size for this frame.
        metalPumpEvents(nsApp)
        metalContextTickFrameTime(ctxPtr)
        metalContextSyncViewportFromView(ctxPtr)
        let frameGraphics = Graphics {
            userData: userData
            backend: GraphicsBackend.Metal
            metalContext: ctxPtr
        }
        var frame = frameGraphics.frame()
        onFrame(frame)
        graphicsSubmitFrame(frame)
        metalSpinRunLoop(0.002)
        if frame.shouldQuit {
            running = false
        }
        if !metalViewWindowVisible(view) {
            running = false
        }
        metalAutoreleasePoolPop(framePool)
    }

    let onCleanup: (Graphics) -> Void = app.cleanupHandler
    let cleanupGraphics = Graphics {
        userData: userData
        backend: GraphicsBackend.Metal
        metalContext: ctxPtr
    }
    onCleanup(move cleanupGraphics)
    metalContextFree(ctxPtr)
    metalAutoreleasePoolPop(pool)
    return
}
