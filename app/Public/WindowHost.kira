// Backend-neutral host accessors for embedders that attach a native child
// control to the graphics window. Window size comes off the frame's drawable
// rather than a backend's own call, so there is one path for every backend.
public function kiraGraphicsHostWindowHandle(frame: borrow RenderFrame) -> RawPtr {
    match frame.backend {
        Dawn -> {
            if pointerIsNull(frame.backendContext) {
                return nullPointer()
            }
            return nativeRecover<GraphicsAppRuntimeState>(frame.backendContext).dawn.window
        }
        Vulkan -> {
            if pointerIsNull(frame.backendContext) {
                return nullPointer()
            }
            return nativeRecover<GraphicsAppRuntimeState>(frame.backendContext).vulkan.window
        }
        Metal -> return nullPointer()
    }
}

public function kiraGraphicsHostDrawableWidth(frame: borrow RenderFrame) -> I32 {
    return I32(frame.drawableWidth())
}

public function kiraGraphicsHostDrawableHeight(frame: borrow RenderFrame) -> I32 {
    return I32(frame.drawableHeight())
}

public function kiraGraphicsHostBackingScale(frame: borrow RenderFrame) -> Float {
    return frame.backingScale()
}
