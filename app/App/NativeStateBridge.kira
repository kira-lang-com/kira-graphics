struct GraphicsAppRuntimeState {
    var app: GraphicsApplication
    var userData: RawPtr
    var frameIndex: Int = 0
    // The Sokol backend's running lifetime-peak counters (see
    // `SokolLifetime.kira`). Lives here because this is the one state blob
    // both `kiraGraphicsSokolFrame` (which samples every frame) and
    // `kiraGraphicsSokolCleanup` (which reports at the end) already recover.
    var lifetimePeaks: LifetimePeaks = LifetimePeaks {}
    // The Sokol backend's row-order correction (see `SokolRowOrder.kira`): one
    // compute pipeline, built the first time a render pass writes a target that
    // will be sampled. Here for the same reason the peaks are — this is the
    // state blob every frame already recovers.
    var rowFlip: SokolRowFlip = SokolRowFlip {}
    // The Sokol backend's render-pass state (see `SokolPass.kira`): whether a
    // pass is open, its extent, and the managed offscreen depth buffer. These
    // were C statics until the legacy immediate-mode UI renderer that shared
    // them was deleted.
    var pass: SokolPassState = SokolPassState {}
    // The Dawn backend's window, device, resource table and pass state (see
    // `app/Backend/Dawn/DawnContext.kira`). Here for the same reason the Sokol
    // blocks above are: this is the one state blob the run loop, a frame and a
    // draw all already recover.
    var dawn: DawnState = dawnEmptyState()
    // Whether this run was asked for frame-rate telemetry
    // (`KIRA_GRAPHICS_LOG_FPS`). A harness knob rather than pass state, which is
    // why it sits beside the other three rather than inside one backend's.
    var logFps: Bool = false
    // What the frames of this run cost the RENDERER, in seconds: how many were
    // measured, their total, and the worst single one.
    //
    // Deliberately not the frame *rate*. A presented frame arrives at the
    // display's cadence whatever the renderer did, so a run pinned at 60 fps
    // says nothing about whether a frame took 1 ms or 15 — and a regression that
    // doubles the cost of a frame is invisible until it crosses the vsync
    // interval, at which point it looks like a cliff. Both backends measure the
    // same span: the application's own frame callback, with the wait for a
    // drawable outside it.
    var frameCostCount: Int = 0
    var frameCostTotalSeconds: Float = 0.0
    var frameCostWorstSeconds: Float = 0.0
    // Which frame the worst one was, counting from the first after start-up. A
    // maximum at frame 3 is start-up leaking past the first frame; one at 250 of
    // 300 is the shape of the run.
    var frameCostWorstIndex: Int = 0
    // Every frame's cost, for the percentiles `reportFrameCost` prints. A budget
    // is written against the worst frame, and a maximum alone cannot tell one
    // hitch from a distribution.
    var frameCostSamples: [Float] = []
    var frameCostFirstSeconds: Float = 0.0
    var frameCostPasses: Int = 0
    var frameCostDraws: Int = 0
    // The harness knobs, read once at init rather than per frame.
    //
    // They are launch settings — nothing changes them while a process runs — and
    // asking the environment for one costs a linear scan and a fresh string on
    // every frame, in a callback whose whole job is not to allocate. Read once,
    // the frame callback only compares two integers.
    var quitAfterFrames: Int = 0
    // Points the window's size sweeps by each frame; zero resizes nothing.
    var resizeSweep: Int = 0
    var captureAtFrame: Int = 0
    var capturePath: String = ""
    // The UI driving scripts, parsed once at init and injected through the
    // normal AppEvent handler before a frame draws: clicks as (frame, x, y)
    // triples, wheel turns as (frame, x, y, deltaYTenths) quadruples. A wheel
    // delta is in tenths because an environment script carries integers and a
    // notch is not one.
    var clickScript: [Int] = []
    var scrollScript: [Int] = []
    // What the Sokol backend answers `frame.statistics()` with. Here because a
    // frame's counters have to outlive the frame that produced them: a HUD is
    // laid out while the frame it describes is still being built, so what it
    // can honestly show is the frame before it.
    var frameStats: SokolFrameStats = SokolFrameStats {}
}
