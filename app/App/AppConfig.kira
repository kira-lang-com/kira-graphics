function graphicsApplicationDefaultInit(graphics: Graphics) {
    return
}

function graphicsApplicationDefaultFrame(frame: borrow mut GraphicsFrame) {
    return
}

function graphicsApplicationDefaultEvent(event: borrow GraphicsEvent) {
    return
}

function graphicsApplicationDefaultCleanup(graphics: Graphics) {
    return
}

struct GraphicsApplication {
    var title: String = "Kira Graphics"
    var width: Int = 640
    var height: Int = 480
    var sampleCount: Int = 1
    // Request a full-resolution framebuffer on HighDPI/Retina displays. When true
    // (the default), the Sokol backend sets sapp_desc.high_dpi so sapp_width/height
    // return PIXEL sizes and sapp_dpi_scale() gives the backing factor; UI layout
    // stays in logical points (pixels / dpi_scale) so nothing shrinks, while the
    // framebuffer is rendered at native resolution for crisp text and vector edges.
    var highDpi: Bool = true
    // Offscreen color-target format (Metal). Default swapchain (BGRA8); set to
    // textureFormatR32Uint() to render a visibility buffer.
    var colorFormat: Int = -1
    var backend: GraphicsBackend = GraphicsBackend.Sokol
    var platform: GraphicsPlatform = GraphicsPlatform.Unknown
    var initHandler: (Graphics) -> Void = graphicsApplicationDefaultInit
    var frameHandler: (borrow mut GraphicsFrame) -> Void = graphicsApplicationDefaultFrame
    var eventHandler: (borrow GraphicsEvent) -> Void = graphicsApplicationDefaultEvent
    var cleanupHandler: (Graphics) -> Void = graphicsApplicationDefaultCleanup

    function onInit(body: (Graphics) -> Void) {
        self.initHandler = body
        return
    }

    function onFrame(body: (borrow mut GraphicsFrame) -> Void) {
        self.frameHandler = body
        return
    }

    function onEvent(body: (borrow GraphicsEvent) -> Void) {
        self.eventHandler = body
        return
    }

    function onCleanup(body: (Graphics) -> Void) {
        self.cleanupHandler = body
        return
    }

    function run(userData: RawPtr) {
        graphicsRuntimeRun(self, userData)
        return
    }
}
