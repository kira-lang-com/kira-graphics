@Native
function sokolDefaultViewport() -> Viewport {
    return Viewport {
        x: 0
        y: 0
        width: sapp_width()
        height: sapp_height()
    }
}

// Current sokol-app drawable size (framebuffer pixels). @Native wrappers so
// non-@Native callers (e.g. Graphics.contextWidth/Height) can obtain the size
// without directly touching the FFI-bound sapp_* symbols.
@Native
function sokolDrawableWidth() -> Int {
    return sapp_width()
}

@Native
function sokolDrawableHeight() -> Int {
    return sapp_height()
}
