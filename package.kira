Package KiraGraphics {
    let version = "0.1.0"
    let kira = "0.1.0"
    let kind = PackageKind.Library
    let moduleRoot = "KiraGraphics"
    let defaults = Defaults { executionMode: Backend.Llvm, buildTarget: BuildTarget.Host }
    let allowThinFfiShim = true
    let nativeLibraries = [
        NativeLibrary {
            // Memory two processes can both render from and sample.
            //
            // Dawn imports shared memory and cannot allocate any, so the buffer
            // comes from the platform first -- a dmabuf from GBM on Linux, a
            // DXGI resource on Windows, an IOSurface on macOS -- and is handed
            // to Dawn on both sides afterwards.
            //
            // Nothing it needs is linked. GBM and Dawn are both opened by name
            // at first use, so a build runs on a machine that has neither and
            // answers "cannot share" instead of failing to start.
            name: "kira_shared_surface",
            linkMode: LinkMode.Static,
            headers: Headers { entrypoint: "NativeLibs/SharedSurface/kira_shared_surface.h", includeDirs: ["NativeLibs/SharedSurface", "NativeLibs/Dawn/x86_64-linux-gnu/include"] },
            sources: [
                "NativeLibs/SharedSurface/kira_shared_surface.c",
                "NativeLibs/SharedSurface/kira_shared_texture.c"
            ],
            autobind: Autobind { module: "sharedsurface", headers: ["NativeLibs/SharedSurface/kira_shared_surface.h"], mode: AutobindMode.AllPublic },
            nativeTargets: [
                NativeTarget { triple: "x86_64-linux-gnu", systemLibs: ["dl"] },
                NativeTarget { triple: "aarch64-linux-gnu", systemLibs: ["dl"] },
                NativeTarget { triple: "x86_64-windows-msvc", systemLibs: ["kernel32"] },
                NativeTarget { triple: "aarch64-macos-none" },
                NativeTarget { triple: "x86_64-macos-none" }
            ]
        },
        NativeLibrary {
            name: "sokol",
            linkMode: LinkMode.Static,
            headers: Headers { entrypoint: "NativeLibs/Sokol/sokol_bindings.h", includeDirs: ["NativeLibs/Sokol"], defines: ["SOKOL_NO_ENTRY"] },
            sources: ["NativeLibs/Sokol/sokol_impl.c"],
            autobind: Autobind { module: "sokol", headers: ["NativeLibs/Sokol/sokol_app.h", "NativeLibs/Sokol/sokol_gfx.h", "NativeLibs/Sokol/sokol_glue.h"], mode: AutobindMode.AllPublic },
            nativeTargets: [
                NativeTarget { triple: "aarch64-macos-none", staticLib: "NativeLibs/../generated/native/aarch64-macos/libsokol.a", defines: ["SOKOL_GLCORE"], frameworks: ["Foundation", "AppKit", "QuartzCore", "OpenGL"] },
                NativeTarget { triple: "aarch64-ios-none", staticLib: "NativeLibs/../generated/native/aarch64-ios/libsokol.a", defines: ["SOKOL_METAL"], frameworks: ["Foundation", "UIKit", "QuartzCore", "Metal", "MetalKit"] },
                NativeTarget { triple: "aarch64-ios-simulator", staticLib: "NativeLibs/../generated/native/aarch64-ios-simulator/libsokol.a", defines: ["SOKOL_METAL"], frameworks: ["Foundation", "UIKit", "QuartzCore", "Metal", "MetalKit"] },
                NativeTarget { triple: "aarch64-tvos-none", staticLib: "NativeLibs/../generated/native/aarch64-tvos/libsokol.a", defines: ["SOKOL_METAL"], frameworks: ["Foundation", "UIKit", "QuartzCore", "Metal", "MetalKit"] },
                NativeTarget { triple: "aarch64-tvos-simulator", staticLib: "NativeLibs/../generated/native/aarch64-tvos-simulator/libsokol.a", defines: ["SOKOL_METAL"], frameworks: ["Foundation", "UIKit", "QuartzCore", "Metal", "MetalKit"] },
                NativeTarget { triple: "aarch64-xros-none", staticLib: "NativeLibs/../generated/native/aarch64-xros/libsokol.a", defines: ["SOKOL_METAL"], frameworks: ["Foundation", "UIKit", "QuartzCore", "Metal", "MetalKit"] },
                NativeTarget { triple: "aarch64-xros-simulator", staticLib: "NativeLibs/../generated/native/aarch64-xros-simulator/libsokol.a", defines: ["SOKOL_METAL"], frameworks: ["Foundation", "UIKit", "QuartzCore", "Metal", "MetalKit"] },
                NativeTarget { triple: "x86_64-linux-gnu", staticLib: "NativeLibs/../generated/native/x86_64-linux-gnu/libsokol.a", defines: ["SOKOL_GLCORE"], systemLibs: ["X11", "Xi", "Xcursor", "GL", "dl", "pthread", "m"] },
                NativeTarget { triple: "aarch64-linux-gnu", defines: ["SOKOL_GLCORE"], systemLibs: ["X11", "Xi", "Xcursor", "GL", "dl", "pthread", "m"] },
                NativeTarget { triple: "x86_64-windows-msvc", staticLib: "NativeLibs/../generated/native/x86_64-windows-msvc/sokol.lib", defines: ["SOKOL_GLCORE"], systemLibs: ["opengl32"] },
                NativeTarget { triple: "wasm32-emscripten-unknown", staticLib: "NativeLibs/../generated/native/wasm32-emscripten/libsokol.a", compilerFlags: ["--use-port=emdawnwebgpu"], linkerFlags: ["--use-port=emdawnwebgpu"] }
            ],
        },
        NativeLibrary {
            // The xdg-shell and decoration protocols, as `wayland-scanner`
            // emits them from the canonical XML.
            //
            // Core Wayland hands out a `wl_surface`, which cannot be shown by
            // itself -- a window is xdg-shell. The small typed C seam calls the
            // protocol's generated inline functions; autobind owns the Kira
            // declarations, including listener callback layouts.
            //
            // Optional: no other target has a row here, and on one this links
            // nothing rather than failing the build.
            name: "waylandprotocols",
            linkMode: LinkMode.Static,
            availability: Availability.Optional,
            headers: Headers { entrypoint: "NativeLibs/Wayland/kira_wayland.h", includeDirs: ["NativeLibs/Wayland"] },
            sources: [
                "NativeLibs/Wayland/kira_wayland.c",
                "NativeLibs/Wayland/xdg-shell-protocol.c",
                "NativeLibs/Wayland/xdg-decoration-protocol.c",
                "NativeLibs/Wayland/cursor-shape-v1-protocol.c",
                "NativeLibs/Wayland/tablet-unstable-v2-protocol.c",
                "NativeLibs/Wayland/viewporter-protocol.c"
            ],
            autobind: Autobind { module: "wayland", headers: ["NativeLibs/Wayland/kira_wayland.h"], mode: AutobindMode.AllPublic },
            nativeTargets: [
                NativeTarget { triple: "x86_64-linux-gnu", systemLibs: ["wayland-client"] },
                NativeTarget { triple: "aarch64-linux-gnu", systemLibs: ["wayland-client"] }
            ],
        },
        NativeLibrary {
            // Dawn, consumed as the binaries kira-lang-com/dawn publishes
            // rather than built here: it is a C++ tree with its own dependency
            // fetch, and building it per Kira build would put half an hour on
            // every one. NativeLibs/Dawn/<triple> holds a release payload
            // unpacked exactly as it ships.
            //
            // Dynamic rather than static: the desktop slices are a monolithic
            // webgpu_dawn shared library, and the static ones exist only where
            // a shared library cannot go. Dawn also loads dxcompiler.dll by
            // name at run time, so a consumer deploys bin/ beside the
            // executable instead of linking it.
            name: "dawn",
            linkMode: LinkMode.Dynamic,
            //
            // `WGPU_SKIP_PROCS` leaves out the function-pointer typedefs a
            // dynamic loader would use, which nothing here does — and with them
            // `emscripten_webgpu_get_device`, the one declaration in the header
            // that no desktop build of Dawn exports. Binding it would put an
            // unresolved symbol on every Windows link line.
            headers: Headers { entrypoint: "NativeLibs/Dawn/x86_64-linux-gnu/include/webgpu/webgpu.h", includeDirs: ["NativeLibs/Dawn/x86_64-linux-gnu/include"], defines: ["WGPU_SKIP_PROCS"] },
            autobind: Autobind { module: "webgpu", headers: ["NativeLibs/Dawn/x86_64-linux-gnu/include/dawn/webgpu.h"], mode: AutobindMode.AllPublic },
            nativeTargets: [
                // `runtimeFiles` is the payload's `bin/`: `webgpu_dawn.dll`
                // beside the executable so the loader finds it, and
                // `dxcompiler.dll`/`dxil.dll` beside that because Dawn opens the
                // first by name when it compiles a shader for D3D12.
                NativeTarget { triple: "x86_64-windows-msvc", dynamicLib: "NativeLibs/Dawn/x86_64-windows-msvc/lib/webgpu_dawn.lib", runtimeFiles: ["NativeLibs/Dawn/x86_64-windows-msvc/bin"] },
                // The Linux slice is one shared object and no loader-name
                // sidecars: Dawn reaches the GPU through the Vulkan loader,
                // which the system provides.
                NativeTarget { triple: "x86_64-linux-gnu", dynamicLib: "NativeLibs/Dawn/x86_64-linux-gnu/lib/libwebgpu_dawn.so", runtimeFiles: ["NativeLibs/Dawn/x86_64-linux-gnu/lib"] },
                // The same slice for 64-bit Arm Linux, from the same Dawn release.
                NativeTarget { triple: "aarch64-linux-gnu", dynamicLib: "NativeLibs/Dawn/aarch64-linux-gnu/lib/libwebgpu_dawn.so", runtimeFiles: ["NativeLibs/Dawn/aarch64-linux-gnu/lib"] },
                // Apple publishes Dawn only as a static archive — no dylib in
                // either the desktop tarball or the xcframework — so the macOS
                // slice hands the linker `libwebgpu_dawn.a` directly (ld links
                // an explicit archive statically, and there is nothing to open
                // at run time). Dawn's Metal backend pulls in the graphics and
                // surface frameworks below; the C++ runtime it is built against
                // comes in through `c++`.
                NativeTarget { triple: "aarch64-macos-none", dynamicLib: "NativeLibs/Dawn/aarch64-macos-none/lib/libwebgpu_dawn.a", frameworks: ["Metal", "QuartzCore", "Foundation", "IOKit", "IOSurface", "CoreFoundation", "CoreGraphics"], systemLibs: ["c++", "objc"] }
            ],
        },
        NativeLibrary {
            // The window the Dawn backend draws into. Dawn renders and does not
            // own a window, and WebGPU takes a surface — on Windows an `HWND` —
            // so the backend opens one itself against the libraries every
            // Windows process already links. No archive of its own: these are
            // the system's, named so the link line carries them.
            //
            // One declaration per module, because a declaration is what an
            // engine resolves a symbol *in*: a link line takes every import
            // library at once and does not care which one answers, while a VM
            // looks the symbol up in the module its declaration names.
            //
            // Optional, and that is what keeps a macOS or Linux build of this
            // package working: there is no row for those targets, the binding is
            // excluded, and `validateRenderBackend` refuses the Dawn backend
            // there before anything calls into it.
            name: "user32",
            linkMode: LinkMode.Dynamic,
            availability: Availability.Optional,
            nativeTargets: [
                NativeTarget { triple: "x86_64-windows-msvc", systemLibs: ["user32"] }
            ],
        },
        NativeLibrary {
            name: "kernel32",
            linkMode: LinkMode.Dynamic,
            availability: Availability.Optional,
            nativeTargets: [
                NativeTarget { triple: "x86_64-windows-msvc", systemLibs: ["kernel32"] }
            ],
        },
        NativeLibrary {
            // The desktop compositor. A window asks it for the backdrop it keeps
            // behind the window — the blurred, tinted view of everything under
            // it that a platform sidebar is made of, and the one thing an
            // application cannot draw for itself.
            name: "dwmapi",
            linkMode: LinkMode.Dynamic,
            availability: Availability.Optional,
            nativeTargets: [
                NativeTarget { triple: "x86_64-windows-msvc", systemLibs: ["dwmapi"] }
            ],
        },
        NativeLibrary {
            // Kira's own runtime archive, already on every native link line.
            // The raw-memory primitives a backend lays its C-shaped context out
            // with live there — and so, now, do shared-library loading and the
            // run-time call builder the Direct3D 12 backend dispatches COM
            // through. A method reached by vtable slot has no symbol to bind, so
            // it cannot be an `@FFI.Extern`; it is assembled and invoked instead.
            //
            // Required rather than optional, and that distinction carries
            // weight: on Windows an *optional* runtime-linked library with no
            // artifact is treated as absent, because PE cannot leave a symbol
            // undefined for load time to bind. This one is never absent.
            name: "kira_runtime",
            linkMode: LinkMode.Runtime,
            nativeTargets: [
                NativeTarget { triple: "aarch64-macos-none", dynamicLib: "" },
                NativeTarget { triple: "aarch64-ios-none", dynamicLib: "" },
                NativeTarget { triple: "x86_64-linux-gnu", dynamicLib: "" },
                NativeTarget { triple: "aarch64-linux-gnu", dynamicLib: "" },
                NativeTarget { triple: "x86_64-windows-msvc", dynamicLib: "" },
                NativeTarget { triple: "wasm32-emscripten-unknown", dynamicLib: "" }
            ],
        },
        NativeLibrary {
            // Apple's own frameworks, so a target row exists only where they do.
            // Optional for exactly that reason: on Windows or Linux there is no
            // row, the binding is excluded, and its calls trap by name instead
            // of leaving `objc_msgSend` and `MTLCreateSystemDefaultDevice`
            // undefined at link — which is what a build there hit, because the
            // Metal backend is compiled in everywhere even though only an Apple
            // target ever selects it. Nothing changes on a platform that has a
            // row: exclusion needs both the marker and a missing row.
            name: "kira_metal",
            linkMode: LinkMode.Dynamic,
            availability: Availability.Optional,
            nativeTargets: [
                NativeTarget { triple: "aarch64-macos-none", frameworks: ["Foundation", "QuartzCore", "Metal", "AppKit"], systemLibs: ["objc"] },
                NativeTarget { triple: "aarch64-ios-none", frameworks: ["Foundation", "QuartzCore", "Metal", "UIKit"], systemLibs: ["objc"] },
                NativeTarget { triple: "wasm32-emscripten-unknown", dynamicLib: "", linkerFlags: ["-sERROR_ON_UNDEFINED_SYMBOLS=0"] }
            ],
        }
    ]
}
