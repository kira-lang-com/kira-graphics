import Foundation

// Importing a shared surface as a Dawn texture.
//
// The two steps are Dawn's own shape: memory is imported, and a texture is made
// over it. What this adds is the registration -- the imported texture is given
// the same id and the same views every texture the backend made gets, so
// everything downstream draws into it and samples it without knowing where its
// memory came from.
//
// That is the whole point of doing it here rather than beside the compositor: a
// render pass, a bind group and a `TextureViewport` all take a `GraphicsTexture`,
// and a shared one has to be exactly that or every one of them needs a second
// path.
// Dawn exposes separate Linux import features for dma-buf and Vulkan opaque fd.
//
// A device gets the optional features it ASKED FOR and no others, so importing a
// dmabuf without requesting this is a validation error rather than a fallback --
// which is exactly what it looks like the first time: the import "succeeds",
// every object it produces is an error object, and the first thing that reads
// one says so instead.
public function dawnFeatureSharedTextureMemoryDmaBuf() -> I32 { return I32(0x0005001F) }
public function dawnFeatureSharedTextureMemoryOpaqueFD() -> I32 { return I32(0x00050020) }

// The fence features, which sharing a texture needs as much as the memory
// feature does.
//
// Ending access EXPORTS a fence: it is how the process that just finished
// writing tells the one about to read when the writing is actually done. Without
// one of these the memory crosses and the timing does not, and Dawn refuses
// rather than letting a compositor sample a half-drawn frame -- which is right,
// and which is why this is requested beside the memory feature rather than
// discovered later by a torn surface.
public function dawnFeatureSharedFenceVkSemaphoreOpaqueFD() -> I32 { return I32(0x00050026) }
public function dawnFeatureSharedFenceSyncFD() -> I32 { return I32(0x00050027) }

// Whether this adapter can import shared memory as a texture.
//
// Asked before the device is created, because that is when the answer can still
// change anything: a feature not requested there cannot be turned on later.
public function dawnAdapterSharesTextures(adapter: RawPtr) -> Bool {
    if pointerIsNull(adapter) {
        return false
    }
    return wgpuAdapterHasFeature(adapter, dawnFeatureSharedTextureMemoryOpaqueFD()) != U32(0) ||
        wgpuAdapterHasFeature(adapter, dawnFeatureSharedTextureMemoryDmaBuf()) != U32(0)
}

// Whichever fence feature this adapter has, or 0 for neither.
//
// Two spellings of one capability -- a Vulkan semaphore exported as an fd, and a
// sync fd -- and a driver may offer either. Asking for the one it has rather
// than for both keeps a device from being refused over a feature it was never
// going to use.
public function dawnAdapterFenceFeature(adapter: RawPtr) -> I32 {
    if pointerIsNull(adapter) {
        return I32(0)
    }
    // SyncFD first: this is the Linux primitive venus emulates and the exact
    // feature paired with OpaqueFD by Tessera's proven Dawn scanout path.
    if wgpuAdapterHasFeature(adapter, dawnFeatureSharedFenceSyncFD()) != U32(0) {
        return dawnFeatureSharedFenceSyncFD()
    }
    if wgpuAdapterHasFeature(adapter, dawnFeatureSharedFenceVkSemaphoreOpaqueFD()) != U32(0) {
        return dawnFeatureSharedFenceVkSemaphoreOpaqueFD()
    }
    return I32(0)
}

// Whether the DEVICE ended up with it. The adapter having a feature and the
// device having asked for it are different facts, and this is the one an import
// depends on.
public function dawnDeviceSharesTextures(device: RawPtr) -> Bool {
    if pointerIsNull(device) {
        return false
    }
    return wgpuDeviceHasFeature(device, dawnFeatureSharedTextureMemoryOpaqueFD()) != U32(0) ||
        wgpuDeviceHasFeature(device, dawnFeatureSharedTextureMemoryDmaBuf()) != U32(0)
}

public @Native
function dawnImportSharedTexture(context: RawPtr, surface: borrow SharedSurface) -> SharedTexture {
    if !dawnHasDevice(context) || surface.isValid() == false {
        return SharedTexture {}
    }
    var state = nativeRecover<GraphicsAppRuntimeState>(context)
    // Refused HERE rather than by Dawn, because Dawn refuses it by handing back
    // error objects that are not null and do not answer as invalid until
    // something tries to use one. A caller asking for a shared texture on a
    // device that cannot make one wants to hear so now, while falling back to
    // copying pixels is still cheap.
    if dawnDeviceSharesTextures(state.dawn.device) == false {
        graphicsFail(.Resource, "this device did not enable shared texture memory")
        return SharedTexture {}
    }
    let memory = kira_shared_texture_import_memory(state.dawn.device, I32(surface.id.raw))
    if pointerIsNull(memory) {
        graphicsFail(.Resource, "" + kira_shared_texture_diagnostic())
        return SharedTexture {}
    }
    let object = kira_shared_texture_create(memory, I32(surface.id.raw))
    if pointerIsNull(object) {
        graphicsFail(.Resource, "a shared surface imported but produced no texture")
        return SharedTexture {}
    }
    // A dmabuf in ARGB8888 arrives as BGRA8, which is what the swapchain is in
    // anyway -- so a shared surface composites through the same pipelines a
    // window's own content does, with no conversion pass between them.
    let format = dawnResolvedFormat(state, .Swapchain)
    let id = dawnRegisterObject(state, object, format)
    return SharedTexture {
        texture: dawnTextureWithViews(
            state,
            id,
            object,
            format,
            surface.width,
            surface.height,
            1,
            // The Tessera producer renders directly into the exported image.
            // Venus's proven external-memory path is render-attachment-only;
            // MosaicDisplay scans the dma-buf out through DRM rather than sampling
            // it through Dawn in this process.
            .RenderTarget
        ),
        memory: memory,
        object: object,
        surface: surface,
        backend: .Dawn,
        backendContext: context
    }
}
