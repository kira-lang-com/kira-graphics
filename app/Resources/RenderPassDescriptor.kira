import Foundation
struct RenderTarget {
    var kind: RenderTargetKind = .Swapchain
    var texture: GraphicsTexture
    var mipLevel: Int = 0
    var arrayLayer: Int = 0
}

struct ColorAttachment {
    var target: RenderTarget
    var loadAction: LoadAction = .Clear
    var storeAction: StoreAction = .Store
    var clearColor: Color
    var resolveTarget: RenderTarget
    var hasResolveTarget: Bool = false
}

struct DepthAttachment {
    var texture: GraphicsTexture
    var loadAction: LoadAction = .Clear
    var storeAction: StoreAction = .Store
    var clearDepth: Float = 1.0
    var readOnly: Bool = false
}

struct StencilAttachment {
    var texture: GraphicsTexture
    var loadAction: LoadAction = .Clear
    var storeAction: StoreAction = .Store
    var clearStencil: Int = 0
    var readOnly: Bool = false
}

struct RenderPassDescriptor {
    var label: String = ""
    var colorAttachments: [ColorAttachment]
    var primaryColorAttachment: ColorAttachment
    var hasPrimaryColorAttachment: Bool = false
    var depthAttachment: DepthAttachment
    var hasDepthAttachment: Bool = false
    var stencilAttachment: StencilAttachment
    var hasStencilAttachment: Bool = false
}

@Native
function emptyRenderTarget() -> RenderTarget {
    return RenderTarget {
        kind: .Swapchain
        texture: emptyGraphicsTexture()
        mipLevel: 0
        arrayLayer: 0
    }
}

@Native
function emptyDepthAttachment() -> DepthAttachment {
    return DepthAttachment {
        texture: emptyGraphicsTexture()
        loadAction: .Clear
        storeAction: .Store
        clearDepth: 1.0
        readOnly: false
    }
}

@Native
function swapchainDepthAttachment() -> DepthAttachment {
    return DepthAttachment {
        texture: emptyGraphicsTexture()
        loadAction: .Clear
        storeAction: .DontCare
        clearDepth: 1.0
        readOnly: false
    }
}

@Native
function emptyStencilAttachment() -> StencilAttachment {
    return StencilAttachment {
        texture: emptyGraphicsTexture()
        loadAction: .Clear
        storeAction: .Store
        clearStencil: 0
        readOnly: false
    }
}

@Native
function swapchainRenderTarget() -> RenderTarget {
    return RenderTarget {
        kind: .Swapchain
        texture: emptyGraphicsTexture()
        mipLevel: 0
        arrayLayer: 0
    }
}

@Native
// The same pass, drawn into a TEXTURE instead of into the window.
//
// This is what a program with no window of its own presents through: a component
// whose pixels are composited by another process renders into shared memory, and
// the only difference from drawing into a swapchain is which image the colour
// attachment names. Everything above it -- the batch, the pipelines, the
// glyph atlas -- is unchanged, which is the property worth having: a view does
// not know, and cannot know, whether it is being drawn for a window.
function clearTextureRenderPass(target: borrow GraphicsTexture, clearColor: borrow Color) -> RenderPassDescriptor {
    let attachment = ColorAttachment {
        target: RenderTarget {
            kind: .Texture
            texture: target
            mipLevel: 0
            arrayLayer: 0
        }
        loadAction: .Clear
        storeAction: .Store
        clearColor: clearColor
        resolveTarget: emptyRenderTarget()
        hasResolveTarget: false
    }
    return RenderPassDescriptor {
        label: "surface-pass"
        colorAttachments: [attachment]
        primaryColorAttachment: attachment
        hasPrimaryColorAttachment: true
        depthAttachment: emptyDepthAttachment()
        hasDepthAttachment: false
        stencilAttachment: emptyStencilAttachment()
        hasStencilAttachment: false
    }
}

function clearSwapchainRenderPass(clearColor: borrow Color) -> RenderPassDescriptor {
    return RenderPassDescriptor {
        label: "swapchain-pass"
        colorAttachments: [
            ColorAttachment {
                target: swapchainRenderTarget()
                loadAction: .Clear
                storeAction: .Store
                clearColor: clearColor
                resolveTarget: emptyRenderTarget()
                hasResolveTarget: false
            }
        ]
        primaryColorAttachment: ColorAttachment {
            target: swapchainRenderTarget()
            loadAction: .Clear
            storeAction: .Store
            clearColor: clearColor
            resolveTarget: emptyRenderTarget()
            hasResolveTarget: false
        }
        hasPrimaryColorAttachment: true
        depthAttachment: emptyDepthAttachment()
        hasDepthAttachment: false
        stencilAttachment: emptyStencilAttachment()
        hasStencilAttachment: false
    }
}