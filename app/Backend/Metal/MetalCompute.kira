// Kira Graphics Metal backend — compute pipelines + dispatch.
//
// A KSL compute shader lowers to an MSL `kernel`; this compiles one into an
// MTLComputePipelineState and encodes the one dispatch shape the engine has —
// the separable texture blur behind Liquid Glass.

// Build an MTLComputePipelineState from a compiled shader library + kernel entry name.
@Native
function metalCreateComputePipeline(ctx: RawPtr, shaderId: Int, entryName: borrow String) -> Int {
    let device = metalMemReadPtr(ctx, metalOffsetDevice())
    let library = metalLookup(ctx, shaderId)
    let fnName: RawPtr = metalMsgSend(metalObjcGetClass("NSString"), metalSel("stringWithUTF8String:"), entryName)
    let fn: RawPtr = metalMsgSend(library, metalSel("newFunctionWithName:"), fnName)
    let errSlot = metalMemAlloc(8)
    metalMemWriteU64(errSlot, 0, 0)
    let pipeline: RawPtr = metalMsgSend(device, metalSel("newComputePipelineStateWithFunction:error:"), fn, errSlot)
    // fn (newFunctionWithName:) is a +1-owned transient; the compute pipeline state
    // retains what it needs, so release it here rather than leaking one per pipeline.
    metalMsgSend(fn, metalSel("release"))
    metalMemFree(errSlot)
    return metalRegister(ctx, pipeline)
}

// Two-stage texture compute inside the active logical frame command buffer.
// Stage H reads the two crossfade sources, blends them as it filters, and writes
// two horizontal blur radii; stage V reads those intermediates and writes the
// corresponding final textures. Keeping both stages on the frame command buffer
// preserves render -> compute -> render order without a commit or CPU wait.
// Non-Metal callers never enter this helper.
@Native
function metalDispatchTextureComputePair(
    ctx: RawPtr,
    horizontalPipelineId: Int,
    verticalPipelineId: Int,
    sourceTextureId: Int,
    secondSourceTextureId: Int,
    blend: Float,
    tempNearTextureId: Int,
    tempFarTextureId: Int,
    outputNearTextureId: Int,
    outputFarTextureId: Int,
    samplerId: Int,
    width: Int,
    height: Int,
) {
    if horizontalPipelineId == 0 || verticalPipelineId == 0 || width <= 0 || height <= 0 {
        return
    }
    let commandBuffer = metalContextActiveCommandBuffer(ctx)
    let source = metalLookup(ctx, sourceTextureId)
    let secondSource = metalLookup(ctx, secondSourceTextureId)
    let tempNear = metalLookup(ctx, tempNearTextureId)
    let tempFar = metalLookup(ctx, tempFarTextureId)
    let outputNear = metalLookup(ctx, outputNearTextureId)
    let outputFar = metalLookup(ctx, outputFarTextureId)
    let sampler = metalLookup(ctx, samplerId)

    // Both kernels take their target extent and the crossfade weight in a
    // uniform and their filtering from a bound sampler: a compute stage written
    // in KSL can neither query a texture's size nor declare a sampler inline,
    // and the caller knows the size it allocated. They declare uniform, sampler,
    // reads, writes in that order, so one slot layout serves the pair. The block
    // is 16 bytes because `std140` rounds a struct up to that, and the padding
    // word is written rather than left holding whatever the allocation had.
    let extent = metalMemAlloc(16)
    metalMemWriteF32(extent, 0, F32(Float(width)))
    metalMemWriteF32(extent, 4, F32(Float(height)))
    metalMemWriteF32(extent, 8, F32(blend))
    metalMemWriteF32(extent, 12, F32(0.0))

    let gridSize = metalMemAlloc(24)
    metalMemWriteU64(gridSize, 0, width)
    metalMemWriteU64(gridSize, 8, height)
    metalMemWriteU64(gridSize, 16, 1)
    let tgSize = metalMemAlloc(24)
    metalMemWriteU64(tgSize, 0, 16)
    metalMemWriteU64(tgSize, 8, 16)
    metalMemWriteU64(tgSize, 16, 1)

    let horizontal: RawPtr = metalMsgSend(commandBuffer, metalSel("computeCommandEncoder"))
    metalMsgSend(horizontal, metalSel("setComputePipelineState:"), metalLookup(ctx, horizontalPipelineId))
    metalMsgSend(horizontal, metalSel("setBytes:length:atIndex:"), extent, 16, 0)
    metalMsgSend(horizontal, metalSel("setSamplerState:atIndex:"), sampler, 1)
    metalMsgSend(horizontal, metalSel("setTexture:atIndex:"), source, 2)
    metalMsgSend(horizontal, metalSel("setTexture:atIndex:"), secondSource, 3)
    metalMsgSend(horizontal, metalSel("setTexture:atIndex:"), tempNear, 4)
    metalMsgSend(horizontal, metalSel("setTexture:atIndex:"), tempFar, 5)
    metalMsgSend(horizontal, metalSel("dispatchThreads:threadsPerThreadgroup:"), gridSize, tgSize)
    metalMsgSend(horizontal, metalSel("endEncoding"))

    let vertical: RawPtr = metalMsgSend(commandBuffer, metalSel("computeCommandEncoder"))
    metalMsgSend(vertical, metalSel("setComputePipelineState:"), metalLookup(ctx, verticalPipelineId))
    metalMsgSend(vertical, metalSel("setBytes:length:atIndex:"), extent, 16, 0)
    metalMsgSend(vertical, metalSel("setSamplerState:atIndex:"), sampler, 1)
    metalMsgSend(vertical, metalSel("setTexture:atIndex:"), tempNear, 2)
    metalMsgSend(vertical, metalSel("setTexture:atIndex:"), tempFar, 3)
    metalMsgSend(vertical, metalSel("setTexture:atIndex:"), outputNear, 4)
    metalMsgSend(vertical, metalSel("setTexture:atIndex:"), outputFar, 5)
    metalMsgSend(vertical, metalSel("dispatchThreads:threadsPerThreadgroup:"), gridSize, tgSize)
    metalMsgSend(vertical, metalSel("endEncoding"))

    // `setBytes:` copies into the encoder's own storage, so the extent may go
    // back as soon as both encoders have taken it.
    metalMemFree(extent)
    metalMemFree(gridSize)
    metalMemFree(tgSize)
    return
}

// One 32-bit word out of a buffer a kernel has written.
//
// Metal's storage is shared, so what a dispatch wrote is readable as soon as the
// command buffer it rode on has completed — which is what a headless gate waits
// on before it asks. There is no staging copy to make and no fence to take.
@Native
function metalReadBufferU32(ctx: RawPtr, bufferId: Int, index: Int) -> U32 {
    if bufferId == 0 || index < 0 {
        return U32(0)
    }
    let buffer = metalLookup(ctx, bufferId)
    if pointerIsNull(buffer) {
        return U32(0)
    }
    let contents: RawPtr = metalMsgSend(buffer, metalSel("contents"))
    if pointerIsNull(contents) {
        return U32(0)
    }
    return metalMemReadU32(contents, U64(index) * U64(4))
}

// The buffer dispatch with a texture bound first, at `texture(0)`.
//
// A kernel that reads the depth a pass just wrote declares the texture ahead of
// its buffers, so the texture takes the texture table's slot 0 and the buffers
// keep buffer slots 0, 1, … — two tables, each numbered from zero, which is how
// MSL binds them.
@Native
function metalDispatchTextureBufferCompute(
    ctx: RawPtr,
    pipelineId: Int,
    textureId: Int,
    bufferIds: borrow [U32],
    threadCount: Int,
    threadsPerGroup: Int,
) {
    if pipelineId == 0 || threadCount <= 0 || threadsPerGroup <= 0 {
        return
    }
    let commandBuffer = metalContextActiveCommandBuffer(ctx)
    let encoder: RawPtr = metalMsgSend(commandBuffer, metalSel("computeCommandEncoder"))
    metalMsgSend(encoder, metalSel("setComputePipelineState:"), metalLookup(ctx, pipelineId))
    metalMsgSend(encoder, metalSel("setTexture:atIndex:"), metalLookup(ctx, textureId), 0)
    for slot in 0..bufferIds.count {
        let buffer = metalLookup(ctx, Int(bufferIds[slot]))
        metalMsgSend(encoder, metalSel("setBuffer:offset:atIndex:"), buffer, 0, U64(slot))
    }
    let gridSize = metalMemAlloc(24)
    metalMemWriteU64(gridSize, 0, threadCount)
    metalMemWriteU64(gridSize, 8, 1)
    metalMemWriteU64(gridSize, 16, 1)
    let tgSize = metalMemAlloc(24)
    metalMemWriteU64(tgSize, 0, threadsPerGroup)
    metalMemWriteU64(tgSize, 8, 1)
    metalMemWriteU64(tgSize, 16, 1)
    metalMsgSend(encoder, metalSel("dispatchThreads:threadsPerThreadgroup:"), gridSize, tgSize)
    metalMsgSend(encoder, metalSel("endEncoding"))
    metalMemFree(gridSize)
    metalMemFree(tgSize)
    return
}

// One dispatch over BUFFERS: the shape a simulation kernel has, next to the
// texture pair above that an image filter has.
//
// `bufferIds` are bound in order at `buffer(0)`, `buffer(1)`, … which is how a
// KSL kernel numbers its own storage arguments, so a particle step reading its
// state at 0 and its parameters at 1 passes them in that order and writes no
// slot numbers down anywhere else.
//
// Encoded on the frame's command buffer like the pair above, so a step that
// runs before a draw is ordered before it without a commit or a CPU wait.
@Native
function metalDispatchComputeBuffers(
    ctx: RawPtr,
    pipelineId: Int,
    bufferIds: borrow [U32],
    threadCount: Int,
    threadsPerGroup: Int,
) {
    if pipelineId == 0 || threadCount <= 0 || threadsPerGroup <= 0 {
        return
    }
    let commandBuffer = metalContextActiveCommandBuffer(ctx)
    let encoder: RawPtr = metalMsgSend(commandBuffer, metalSel("computeCommandEncoder"))
    metalMsgSend(encoder, metalSel("setComputePipelineState:"), metalLookup(ctx, pipelineId))
    for slot in 0..bufferIds.count {
        let buffer = metalLookup(ctx, Int(bufferIds[slot]))
        metalMsgSend(encoder, metalSel("setBuffer:offset:atIndex:"), buffer, 0, U64(slot))
    }
    let gridSize = metalMemAlloc(24)
    metalMemWriteU64(gridSize, 0, threadCount)
    metalMemWriteU64(gridSize, 8, 1)
    metalMemWriteU64(gridSize, 16, 1)
    let tgSize = metalMemAlloc(24)
    metalMemWriteU64(tgSize, 0, threadsPerGroup)
    metalMemWriteU64(tgSize, 8, 1)
    metalMemWriteU64(tgSize, 16, 1)
    metalMsgSend(encoder, metalSel("dispatchThreads:threadsPerThreadgroup:"), gridSize, tgSize)
    metalMsgSend(encoder, metalSel("endEncoding"))
    metalMemFree(gridSize)
    metalMemFree(tgSize)
    return
}
