// Metal bind groups: a small heap block of (kind, slot, resourceId) entries that
// map public bind-group descriptors onto encoder bindings. At draw time each bound
// group is applied — uniforms bind to both the vertex and fragment buffer slot (so
// either stage can read them), textures and samplers bind to the fragment stage.
//
// Block layout: [entryCount: U64][entry...]; each entry is (kind, slot, resourceId)
// as three U64s (24 bytes). kind: 1=uniform, 2=texture, 3=sampler.
function metalBindGroupCapacity() -> U64 { return 16 }
function metalBindEntryKindUniform() -> U64 { return 1 }
function metalBindEntryKindTexture() -> U64 { return 2 }
function metalBindEntryKindSampler() -> U64 { return 3 }

@Native
function metalCreateBindGroup(ctx: RawPtr) -> Int {
    let block = metalMemAlloc(8 + metalBindGroupCapacity() * 24)
    metalMemWriteU64(block, 0, 0)
    return metalRegister(ctx, block)
}

@Native
function metalBindGroupAddEntry(ctx: RawPtr, bindGroupId: Int, kind: U64, slot: Int, resourceId: Int) {
    let block = metalLookup(ctx, bindGroupId)
    let count = metalMemReadU64(block, 0)
    let base = 8 + count * 24
    metalMemWriteU64(block, base, kind)
    metalMemWriteU64(block, base + 8, slot)
    metalMemWriteU64(block, base + 16, resourceId)
    metalMemWriteU64(block, 0, count + 1)
    return
}

// Apply a bind group's entries onto the active render-command encoder.
@Native
function metalEncoderApplyBindGroup(ctx: RawPtr, bindGroupId: Int) {
    let block = metalLookup(ctx, bindGroupId)
    let encoder = metalMemReadPtr(ctx, metalOffsetEncoder())
    let count = metalMemReadU64(block, 0)
    var i: U64 = 0
    while i < count {
        let base = 8 + i * 24
        let kind = metalMemReadU64(block, base)
        let slot = metalMemReadU64(block, base + 8)
        let resourceId = metalMemReadU64(block, base + 16)
        let resource = metalLookupU64(ctx, resourceId)
        if kind == metalBindEntryKindUniform() {
            // Vertex-stage uniforms bind ABOVE the vertex data (which occupies vertex
            // buffer 0), i.e. at slot+1, so a uniform at slot 0 does not collide with the
            // vertex buffer; fragment-stage uniforms bind directly at slot. A shader thus
            // reads a vertex uniform from [[buffer(slot+1)]] and a fragment uniform from
            // [[buffer(slot)]].
            metalMsgSendSetVertexBuffer(encoder, metalSel("setVertexBuffer:offset:atIndex:"), resource, 0, slot + 1)
            metalMsgSendSetFragmentBuffer(encoder, metalSel("setFragmentBuffer:offset:atIndex:"), resource, 0, slot)
        }
        if kind == metalBindEntryKindTexture() {
            metalMsgSendVoidPU(encoder, metalSel("setFragmentTexture:atIndex:"), resource, slot)
        }
        if kind == metalBindEntryKindSampler() {
            metalMsgSendVoidPU(encoder, metalSel("setFragmentSamplerState:atIndex:"), resource, slot)
        }
        i = i + 1
    }
    return
}
