public function vulkanSampleCount1() -> I32 { return I32(1) }
public function vulkanSampleCount(samples: Int) -> I32 {
    if samples == 1 || samples == 2 || samples == 4 || samples == 8 || samples == 16 || samples == 32 || samples == 64 {
        return I32(samples)
    }
    return I32(0)
}
