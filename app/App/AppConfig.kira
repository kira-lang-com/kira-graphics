function graphicsApplicationDefaultInit(graphics: Graphics) {
    return
}

function graphicsApplicationDefaultFrame(frame: borrow mut RenderFrame) {
    return
}

function graphicsApplicationDefaultEvent(event: borrow AppEvent) {
    return
}

function graphicsApplicationDefaultCleanup(graphics: Graphics) {
    return
}

struct GraphicsApplication {
    var title: String = "Kira Graphics"
    var width: Int = 640
    var height: Int = 480
    var sampleCount: Int = 1
    // Request a full-resolution framebuffer on HighDPI/Retina displays. When true
    // (the default), the Sokol backend sets sapp_desc.high_dpi so sapp_width/height
    // return PIXEL sizes and sapp_dpi_scale() gives the backing factor; UI layout
    // stays in logical points (pixels / dpi_scale) so nothing shrinks, while the
    // framebuffer is rendered at native resolution for crisp text and vector edges.
    var highDpi: Bool = true
    // The mode the window OPENS in. `width`/`height` are what a windowed mode is
    // given; a fullscreen window takes the display's size instead, so a program
    // that starts there reads its viewport back off the frame.
    var windowMode: WindowMode = .Windowed
    // Optional fixed frame cadence in nanoseconds. Zero keeps the backend
    // uncapped; a positive value uses absolute deadlines and never emits catch-up
    // bursts after an overrun.
    var targetFrameDurationNs: Int = 0
    // Offscreen color-target format (Metal). Default swapchain (BGRA8); set to
    // the `R32Uint` texture format to render a visibility buffer.
    var colorFormat: TextureFormat = .Swapchain
    // The renderer, which `KIRA_GRAPHICS_BACKEND` overrides.
    //
    // The platform's own default without one. The override is what lets one
    // program be run on two backends without being edited between the runs —
    // and a comparison between two backends is only worth anything when the
    // program either one drew is the same program.
    var backend: RenderBackendKind = graphicsDefaultBackend()
    var platform: Platform = .Unknown
    var initHandler: (Graphics) -> Void = graphicsApplicationDefaultInit
    var frameHandler: (borrow mut RenderFrame) -> Void = graphicsApplicationDefaultFrame
    var eventHandler: (borrow AppEvent) -> Void = graphicsApplicationDefaultEvent
    var cleanupHandler: (Graphics) -> Void = graphicsApplicationDefaultCleanup

    function onInit(body: (Graphics) -> Void) {
        self.initHandler = body
        return
    }

    function onFrame(body: (borrow mut RenderFrame) -> Void) {
        self.frameHandler = body
        return
    }

    function onEvent(body: (borrow AppEvent) -> Void) {
        self.eventHandler = body
        return
    }

    function onCleanup(body: (Graphics) -> Void) {
        self.cleanupHandler = body
        return
    }

    function run(userData: RawPtr) {
        graphicsRuntimeRun(self, userData)
        return
    }
}
