struct UniformDescriptor {
    var label: String = ""
    var expectedFloatCount: Int = 0
    var data: [F32]
}

struct UniformBindEntry {
    var uniformSlot: Int = 0
    var uniform: Uniform
}

struct TextureBindEntry {
    var textureSlot: Int = 0
    var texture: GraphicsTexture
}

struct SamplerBindEntry {
    var samplerSlot: Int = 0
    var sampler: GraphicsSampler
}

// A storage buffer bound at a shader slot, held by the public buffer id. Vulkan
// and Dawn resolve that id to their own device-side view at draw time.
struct StorageBindEntry {
    var storageSlot: Int = 0
    var viewId: U32 = 0
    // How many bytes of the buffer the shader reads.
    //
    // WebGPU binds a buffer as a range, and a range needs a length. Carried here
    // because the side that
    // creates the entry is the side that still holds the buffer it came from.
    var byteSize: Int = 0
}

struct BindGroupDescriptor {
    var label: String = ""
    var uniformEntries: [UniformBindEntry]
    var textureEntries: [TextureBindEntry]
    var samplerEntries: [SamplerBindEntry]
}
