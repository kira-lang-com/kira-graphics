// The launch settings a harness gives a run: which frame to read back, where to
// write it, when to quit, and any scripted input.
//
// These were environment variables read once at init — KIRA_GRAPHICS_CAPTURE_FRAME,
// KIRA_GRAPHICS_CAPTURE_AT, KIRA_GRAPHICS_QUIT_AFTER_FRAMES, KIRA_GRAPHICS_RESIZE_SWEEP,
// KIRA_GRAPHICS_LOG_FPS, and the KIRA_UI_*_SCRIPT family. A caller that builds one
// hands the run its settings directly; a run given none reads the environment as
// before, so a driven run and an environment-driven run resolve to the same knobs.
struct HarnessConfig {
    // Whether a caller filled this in. A default-constructed value is the
    // "nothing given" case that leaves the environment as the source, which is
    // what keeps every existing environment-driven run working unchanged.
    var configured: Bool = false
    var quitAfterFrames: Int = 0
    var resizeSweep: Int = 0
    var logFps: Bool = false
    var capturePath: String = ""
    var captureAtFrame: Int = 0
    var clickScript: [Int] = []
    var scrollScript: [Int] = []
    var dragScript: [Int] = []
    var keyScript: [Int] = []
    var textScript: [Int] = []
}

// A harness that reads one frame back to `path` and quits after `quitAfterFrames`.
//
// `atFrame` is which frame to capture; zero takes the last one drawn — the frame
// the run quits after — so a settle-then-shoot needs only a frame count and a path.
function harnessCapture(path: String, atFrame: Int, quitAfterFrames: Int) -> HarnessConfig {
    return HarnessConfig {
        configured: true
        capturePath: path
        captureAtFrame: atFrame
        quitAfterFrames: quitAfterFrames
    }
}
