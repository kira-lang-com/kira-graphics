struct VertexAttribute {
    var name: String = ""
    var location: Int = 0
    var format: VertexFormat = .Float4
    var offset: Int = 0
}

struct VertexLayout {
    var stride: Int = 0
    var attributes: [VertexAttribute]
}

struct BlendState {
    var enabled: Bool = false
    var preset: BlendPreset = .PremultipliedAlpha
}

struct ColorTargetDescriptor {
    var format: TextureFormat = .Swapchain
    var blend: BlendState
}

struct DepthStencilDescriptor {
    var depthEnabled: Bool = false
    var depthWriteEnabled: Bool = false
    var depthCompare: CompareFunction = .Less
    // No depth buffer unless a pipeline asks for one.
    //
    // A backend may bake this into the pipeline object and check it against the
    // pass being drawn into — sokol does — so a pipeline naming a depth format
    // is a pipeline that can only be used in a pass carrying that attachment.
    // Defaulting to a real format made every pipeline claim one, and a pipeline
    // drawn into an offscreen colour target with no depth was then refused at
    // the draw with nothing in its descriptor to say why.
    var format: TextureFormat = .None
}

struct RasterizationDescriptor {
    var cullMode: CullMode = .None
    var frontFace: FrontFace = .CounterClockwise
}

struct PrimitiveDescriptor {
    var topology: PrimitiveTopology = .TriangleList
}

struct RenderPipelineDescriptor {
    var label: String = ""
    var shader: GraphicsShader
    var vertexLayout: VertexLayout
    var colorTargets: [ColorTargetDescriptor]
    var depthStencil: DepthStencilDescriptor
    var rasterization: RasterizationDescriptor
    var primitive: PrimitiveDescriptor
    // Metal shader-library entry-point names (default v_main/f_main; KSL-compiled
    // libraries use `{shader}__vertex__main` / `__fragment__main`). Transient — this
    // descriptor is not stored in native state, so String fields are safe here.
    var vertexEntry: String = "v_main"
    var fragmentEntry: String = "f_main"
}
